---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { team } = getContent(lang);

const title = lang === "en" ? "ENGINEERING SQUAD" : "EQUIPO DE INGENIERÍA";
const photoSlotLabel = lang === "en" ? "// PHOTO" : "// FOTO";
const githubLabel = lang === "en" ? "GITHUB" : "GITHUB";
const linkedinLabel = lang === "en" ? "LINKEDIN" : "LINKEDIN";
---

<section class="relative bg-black text-white py-16 md:py-20 px-4 md:px-12">
  <div class="max-w-7xl mx-auto">
    <div class="border-b border-white/20 pb-8 mb-12">
      <h2 data-fit-title class="reveal font-display text-4xl sm:text-5xl text-white uppercase tracking-[-0.04em] leading-[0.9]">
        {title}
      </h2>
    </div>

    <!-- Misure-style member cards: a real photo slot on top, identity and
         links below. The slot is a designed placeholder until real
         per-member photos exist. -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8" data-stagger="90">
      {
        team.map((member) => (
          <article class="reveal flex flex-col border-2 border-white/20 bg-black overflow-hidden hover:border-[#FF4D00] transition-colors">
            <!-- Photo slot (placeholder) -->
            <div class="relative h-72 md:h-96 bg-neutral-950 border-b-2 border-white/20">
              <div class="absolute inset-3 border border-dashed border-white/15 flex items-center justify-center">
                <span class="font-mono-meta text-[11px] uppercase tracking-widest text-white/30">
                  {photoSlotLabel}
                </span>
              </div>
            </div>

            <div class="flex flex-1 flex-col gap-1 p-6 md:p-8">
              <h3 class="font-display text-2xl sm:text-3xl text-white uppercase tracking-[-0.03em] leading-tight m-0">
                {member.name}
              </h3>
              <span class="font-mono-meta text-xs text-[#FF4D00] uppercase font-bold tracking-wider m-0">
                {member.role}
              </span>
              <p class="font-sans text-sm sm:text-base text-white/75 leading-relaxed mt-3 mb-0">
                {member.bio}
              </p>

              <div class="mt-auto flex flex-wrap gap-3 pt-6">
                {member.github && (
                  <a
                    href={member.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex-1 min-w-[10rem] inline-flex items-center justify-center gap-2 rounded-full border-2 border-white/30 px-5 py-2.5 font-mono-meta text-xs uppercase font-bold text-white hover:border-[#FF4D00] hover:text-[#FF4D00] hover:scale-105 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF4D00]"
                  >
                    <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                    </svg>
                    <span>{githubLabel}</span>
                    <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                      <path stroke-linecap="square" stroke-linejoin="miter" d="M7 17L17 7M17 7H7M17 7V17"></path>
                    </svg>
                  </a>
                )}
                {member.linkedin && (
                  <a
                    href={member.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex-1 min-w-[10rem] inline-flex items-center justify-center gap-2 rounded-full border-2 border-white/30 px-5 py-2.5 font-mono-meta text-xs uppercase font-bold text-white hover:border-[#FF4D00] hover:text-[#FF4D00] hover:scale-105 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF4D00]"
                  >
                    <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                    <span>{linkedinLabel}</span>
                    <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                      <path stroke-linecap="square" stroke-linejoin="miter" d="M7 17L17 7M17 7H7M17 7V17"></path>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
