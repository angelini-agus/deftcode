---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { team } = getContent(lang);

const eyebrow = lang === "en" ? "// TALENT & LEADERSHIP" : "// TALENTO & LIDERAZGO";
const title = lang === "en" ? "ENGINEERING SQUAD" : "EQUIPO DE INGENIERÍA";
const intro =
  lang === "en"
    ? "BUILDERS WHO UNDERSTAND BUSINESS CONVERSION AND EXTREME PERFORMANCE."
    : "DESARROLLADORES QUE ENTIENDEN DE NEGOCIO Y PERFORMANCE.";
---

<section class="relative bg-black text-white py-20 px-4 md:px-12 rule-page-bottom">
  <div class="max-w-7xl mx-auto">
    <div class="border-b border-white/20 pb-8 mb-12 flex flex-col sm:flex-row justify-between sm:items-end gap-4">
      <div>
        <span class="font-mono-meta text-xs uppercase text-[#FF4D00] font-bold tracking-widest block mb-2">
          {eyebrow}
        </span>
        <h2 class="reveal font-display text-4xl sm:text-5xl text-white uppercase tracking-[-0.04em] leading-[0.9]">
          {title}
        </h2>
      </div>
      <p class="font-mono-meta text-xs text-white/60 max-w-xs sm:text-right">
        {intro}
      </p>
    </div>

    <!-- Team Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        team.map((member) => (
          <article class="border-2 border-white/20 p-8 flex flex-col justify-between bg-white/[0.03] hover:border-[#FF4D00] transition-colors">
            <div>
              <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
                <div>
                  <h3 class="font-display text-2xl sm:text-3xl text-white uppercase tracking-[-0.03em] leading-tight m-0">
                    {member.name}
                  </h3>
                  <span class="font-mono-meta text-xs text-[#FF4D00] uppercase font-bold tracking-wider mt-1 block">
                    {member.role}
                  </span>
                </div>
                <div class="w-3 h-3 bg-[#FF4D00]"></div>
              </div>

              <p class="font-sans text-sm sm:text-base text-white/70 leading-relaxed mb-6">
                {member.bio}
              </p>
            </div>

            <div>
              <!-- Links -->
              <div class="flex items-center gap-4 border-t border-white/10 pt-4">
                {member.github && (
                  <a
                    href={member.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono-meta text-xs uppercase font-bold text-white hover:text-[#FF4D00] transition-colors flex items-center gap-1.5"
                  >
                    <span>GITHUB</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                      <path stroke-linecap="square" stroke-linejoin="miter" d="M7 17L17 7M17 7H7M17 7V17"></path>
                    </svg>
                  </a>
                )}
                {member.linkedin && (
                  <a
                    href={member.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono-meta text-xs uppercase font-bold text-white hover:text-[#FF4D00] transition-colors flex items-center gap-1.5"
                  >
                    <span>LINKEDIN</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                      <path stroke-linecap="square" stroke-linejoin="miter" d="M7 17L17 7M17 7H7M17 7V17"></path>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
