---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  dark?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
}

const { eyebrow, title, intro, dark = false, ctaLabel, ctaHref } = Astro.props;
---

<header
  class={`page-banner relative flex flex-col justify-center px-4 md:px-12 ${
    dark ? "bg-black text-white" : "bg-[#FF4D00] text-black"
  }`}
>
  <div class="page-banner__inner mx-auto">
    <!-- Eyebrow: plain text, no chip box. Matches the bare section
         eyebrows used across the site (no border, no dot). -->
    <div
      class={`page-banner__eyebrow reveal font-mono-meta text-xs uppercase font-bold tracking-widest ${
        dark ? "text-[#FF4D00]" : "text-black"
      }`}
    >
      // {eyebrow}
    </div>

    <!-- Title in Archivo Black. Sized from the container width (not raw vw)
         so a 4K screen keeps the same line partition as a laptop, and capped
         by viewport height so short screens never push the hero past one page. -->
    <h1
      class={`page-banner__title reveal font-display uppercase tracking-[-0.04em] m-0 ${
        dark ? "text-white" : "text-black"
      }`}
    >
      {title}
    </h1>

    {
      intro && (
        <p
          class={`page-banner__intro reveal reveal-late font-sans text-base sm:text-xl md:text-2xl font-bold leading-relaxed ${
            dark ? "text-white/80" : "text-black/90"
          }`}
        >
          {intro}
        </p>
      )
    }

    {
      ctaLabel && ctaHref && (
        <div class="page-banner__cta">
          <a
            href={ctaHref}
            class={`group reveal inline-flex items-center gap-3 font-mono-meta text-xs sm:text-sm font-bold uppercase px-6 py-4 rounded-full border-2 border-black transition-all duration-300 hover:scale-105 focus-visible:outline-none focus-visible:ring-2 ${
              dark
                ? "bg-[#FF4D00] text-black focus-visible:ring-[#FF4D00]"
                : "bg-black text-white shadow-[0_10px_28px_rgba(0,0,0,0.35)] focus-visible:ring-black"
            }`}
          >
            <span>{ctaLabel}</span>
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      )
    }
  </div>
</header>

<style>
  .page-banner {
    min-height: 90vh;
    min-height: 90svh;
    padding-block: clamp(4rem, 9svh, 6.5rem) clamp(2rem, 4svh, 3rem);
  }

  .page-banner__inner {
    container-type: inline-size;
    width: 100%;
    /* Wider than the rest of the site: the banner headline needs room to
       hold its line count when the viewport itself is 4K. */
    max-width: min(92vw, 1800px);
    text-align: center;
  }

  .page-banner__eyebrow {
    margin-bottom: clamp(0.5rem, 2svh, 1.25rem);
  }

  .page-banner__title {
    font-size: clamp(2rem, min(9cqw, 11svh), 8.5rem);
    line-height: 0.85;
  }

  @media (min-width: 360px) {
    .page-banner__title {
      font-size: clamp(2.25rem, min(9cqw, 11svh), 8.5rem);
    }
  }

  .page-banner__intro {
    max-width: 48rem;
    margin-inline: auto;
    margin-top: clamp(0.75rem, 2svh, 1.5rem);
  }

  @media (max-width: 639px) {
    .page-banner__intro {
      line-height: 1.45;
    }
  }

  .page-banner__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(0.75rem, 2svh, 1.5rem);
  }

  @media (max-width: 359px) {
    .page-banner {
      padding-top: 5.5rem;
    }
  }
</style>
