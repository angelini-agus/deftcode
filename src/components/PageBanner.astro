---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  dark?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
}

const { eyebrow, title, intro, dark = false, ctaLabel, ctaHref } = Astro.props;
---

<header
  class={`relative pt-32 pb-16 md:pt-40 md:pb-20 px-4 md:px-12 ${
    dark ? "bg-black text-white" : "bg-[#FF4D00] text-black"
  }`}
>
  <div class="max-w-7xl mx-auto">
    <!-- Eyebrow: plain text, no chip box. Matches the bare section
         eyebrows used across the site (no border, no dot). -->
    <div
      class={`reveal font-mono-meta text-xs uppercase font-bold tracking-widest mb-6 ${
        dark ? "text-[#FF4D00]" : "text-black"
      }`}
    >
      // {eyebrow}
    </div>

    <!-- Title in Archivo Black -->
    <h1
      class={`reveal font-display text-4xl sm:text-6xl md:text-[7vw] lg:text-[6.2vw] uppercase tracking-[-0.04em] leading-[0.88] m-0 ${
        dark ? "text-white" : "text-black"
      }`}
    >
      {title}
    </h1>

    {
      intro && (
        <p
          class={`reveal reveal-late font-sans text-base sm:text-xl md:text-2xl font-bold mt-8 leading-relaxed ${
            dark ? "text-white/80" : "text-black/90"
          }`}
        >
          {intro}
        </p>
      )
    }

    {
      ctaLabel && ctaHref && (
        <div class="mt-8">
          <a
            href={ctaHref}
            class={`group reveal inline-flex items-center gap-3 font-mono-meta text-xs sm:text-sm font-bold uppercase px-6 py-4 rounded-full border-2 border-black transition-all duration-300 hover:scale-105 focus-visible:outline-none focus-visible:ring-2 ${
              dark
                ? "bg-[#FF4D00] text-black focus-visible:ring-[#FF4D00]"
                : "bg-black text-white shadow-[0_10px_28px_rgba(0,0,0,0.35)] focus-visible:ring-black"
            }`}
          >
            <span>{ctaLabel}</span>
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      )
    }
  </div>
</header>
