---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  dark?: boolean;
}

const { eyebrow, title, intro, dark = false } = Astro.props;
---

<header
  class={`relative pt-32 pb-16 md:pt-40 md:pb-20 px-4 md:px-12 border-b-2 border-black ${
    dark ? "bg-black text-white" : "bg-[#FF4D00] text-black"
  }`}
>
  <div class="max-w-7xl mx-auto">
    <!-- Eyebrow Tag -->
    <div
      class={`inline-flex items-center gap-2 border-2 px-3 py-1 font-mono-meta text-xs uppercase font-bold tracking-widest mb-6 ${
        dark ? "bg-white text-black border-white" : "bg-black text-[#FF4D00] border-black"
      }`}
    >
      <span class="w-2 h-2 bg-[#FF4D00]"></span>
      // {eyebrow}
    </div>

    <!-- Title in Archivo Black -->
    <h1
      class={`font-display text-4xl sm:text-6xl md:text-7xl lg:text-8xl uppercase tracking-[-0.04em] leading-[0.88] max-w-5xl m-0 select-none ${
        dark ? "text-white" : "text-black"
      }`}
    >
      {title}
    </h1>

    {
      intro && (
        <p
          class={`font-sans text-base sm:text-xl md:text-2xl font-bold max-w-3xl mt-8 leading-relaxed ${
            dark ? "text-white/80" : "text-black/90"
          }`}
        >
          {intro}
        </p>
      )
    }
  </div>
</header>
