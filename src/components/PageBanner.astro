---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  dark?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
  lang?: Lang;
  heroLike?: boolean;
}

const { eyebrow, title, intro, dark = false, ctaLabel, ctaHref, lang = "es", heroLike = false } = Astro.props;
const { heroContent } = getContent(lang);
---

<header
  class={`page-banner relative flex flex-col justify-center px-4 md:px-12 ${
    dark ? "bg-black text-white" : "bg-[#FF4D00] text-black"
  } ${heroLike ? "page-banner--hero" : ""}`}
>
  <div class="page-banner__inner mx-auto">
    <!-- Hero-like kicker: the microcopy home shows under its CTA, lifted to
         the top slot where the eyebrow used to live (user request). -->
    {
      heroLike && (
        <p
      class={`page-banner__kicker reveal font-mono-meta text-[10px] sm:text-[11px] uppercase font-bold tracking-wider m-0 text-center ${
        dark ? "text-white/75" : "text-black/75"
      }`}
        >
          {heroContent.microcopy}
        </p>
      )
    }
    <!-- Eyebrow: plain text, no chip box. Matches the bare section
         eyebrows used across the site (no border, no dot). Rendered
         only when the page passes one. -->
    {
      eyebrow && (
        <div
          class={`page-banner__eyebrow reveal font-mono-meta text-xs uppercase font-bold tracking-widest ${
            dark ? "text-[#FF4D00]" : "text-black"
          }`}
        >
          // {eyebrow}
        </div>
      )
    }

    <!-- Title in Archivo Black. Sized from the container width (not raw vw)
         so a 4K screen keeps the same line partition as a laptop, and capped
         by viewport height so short screens never push the hero past one page. -->
    <h1
      class={`page-banner__title reveal font-display uppercase tracking-[-0.04em] m-0 ${
        dark ? "text-white" : "text-black"
      }`}
    >
      {title}
    </h1>

    {
      intro && (
        <p
          class={`page-banner__intro reveal reveal-late font-sans text-base sm:text-xl md:text-2xl font-bold leading-relaxed ${
            dark ? "text-white/80" : "text-black/90"
          }`}
        >
          {intro}
        </p>
      )
    }

    {
      ctaLabel && ctaHref && (
        <div class="page-banner__cta">
          <a
            href={ctaHref}
            class={`group reveal inline-flex items-center gap-3 font-mono-meta text-xs sm:text-sm font-bold uppercase px-6 py-4 rounded-full border-2 border-black transition-all duration-300 hover:scale-105 focus-visible:outline-none focus-visible:ring-2 ${
              dark
                ? "bg-[#FF4D00] text-black focus-visible:ring-[#FF4D00]"
                : "bg-black text-white shadow-[0_10px_28px_rgba(0,0,0,0.35)] focus-visible:ring-black"
            }`}
          >
            <span>{ctaLabel}</span>
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      )
    }
  </div>

  {
    heroLike && (
      <div class="page-banner__bottom w-full max-w-7xl mx-auto reveal">
        <!-- Horizontal Border Divider (2px solid #000000), like the home hero -->
        <div class="w-full h-[2px] bg-black mb-6 page-banner__divider" />

        <div class="flex justify-center items-center py-2 page-banner__badge-row">
          <div
            class="relative w-[112px] h-[112px] flex items-center justify-center page-banner__badge"
            aria-hidden="true"
          >
            <!-- Rotating SVG Text Container (360deg over 16s), shrunken
                 from the hero's 144px per user request -->
            <svg
              class="absolute inset-0 w-full h-full animate-spin-slow select-none pointer-events-none"
              viewBox="0 0 112 112"
            >
              <defs>
                <path
                  id="bannerCirclePath"
                  d="M 56, 56 m -42, 0 a 42,42 0 1,1 84,0 a 42,42 0 1,1 -84,0"
                />
              </defs>
              <text
                class="font-mono-meta text-[8px] font-bold fill-black uppercase"
                letter-spacing="0.16em"
              >
                <textPath href="#bannerCirclePath" startOffset="0%">
                  {heroContent.scrollText} {heroContent.scrollText}
                </textPath>
              </text>
            </svg>

            <!-- Static Center Circle & Arrow -->
            <div class="w-10 h-10 rounded-full bg-black text-[#FF4D00] flex items-center justify-center border-2 border-black shadow-md">
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2.5"
              >
                <path stroke-linecap="square" stroke-linejoin="miter" d="M12 4v16m0 0l-6-6m6 6l6-6" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    )
  }
</header>

<style>
  .page-banner {
    min-height: 90vh;
    min-height: 90svh;
    padding-block: clamp(4rem, 9svh, 6.5rem) clamp(2rem, 4svh, 3rem);
  }

  /* Hero-like banners: shorter section — it ends at its own divider +
     badge row, roughly at the height the home hero's divider sits at,
     across resolutions (svh-based). */
  .page-banner--hero {
    min-height: min(76svh, 52rem);
  }

  .page-banner--hero .page-banner__inner {
    margin-block: auto;
  }

  .page-banner__kicker {
    margin-bottom: clamp(0.5rem, 1.5svh, 1rem);
  }

  .page-banner__inner {
    container-type: inline-size;
    width: 100%;
    /* Wider than the rest of the site: the banner headline needs room to
       hold its line count when the viewport itself is 4K. */
    max-width: min(92vw, 1800px);
    text-align: center;
  }

  .page-banner__eyebrow {
    margin-bottom: clamp(0.5rem, 2svh, 1.25rem);
  }

  .page-banner__title {
    font-size: clamp(2rem, min(9cqw, 11svh), 8.5rem);
    line-height: 0.85;
  }

  @media (min-width: 360px) {
    .page-banner__title {
      font-size: clamp(2.25rem, min(9cqw, 11svh), 8.5rem);
    }
  }

  .page-banner__intro {
    max-width: 48rem;
    margin-inline: auto;
    margin-top: clamp(0.75rem, 2svh, 1.5rem);
  }

  @media (max-width: 639px) {
    .page-banner__intro {
      line-height: 1.45;
    }
  }

  .page-banner__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(0.75rem, 2svh, 1.5rem);
  }

  @media (max-height: 700px) {
    /* Compact level for short windows: trim air only, never controls. */
    .page-banner--hero {
      padding-block: clamp(3rem, 7svh, 4.5rem) clamp(1rem, 2.5svh, 2rem);
      min-height: min(72svh, 44rem);
    }
    .page-banner--hero .page-banner__divider {
      margin-bottom: 0.75rem;
    }
    .page-banner--hero .page-banner__badge-row {
      padding-block: 0;
    }
    .page-banner--hero .page-banner__badge {
      width: 88px;
      height: 88px;
    }
  }

  @media (max-width: 359px) {
    .page-banner {
      padding-top: 5.5rem;
    }
  }
</style>
