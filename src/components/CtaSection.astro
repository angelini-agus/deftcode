---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { ctaContent } = getContent(lang);

// Display lines are measured so each one spans the full page width with
// zero glyph clipping. Ratios are inline-box em-widths of Archivo Black at
// 100px with letter-spacing -0.04em: canvas width plus the trailing
// letter-spacing advance (0.04em). Measured in-browser; refresh if copy
// or tracking changes.
const HEADING_RATIOS: Record<Lang, [number, number]> = {
  es: [9.003125, 6.06703125],
  en: [6.463125, 9.673125],
};
const [r1, r2] = HEADING_RATIOS[lang];
const [headingLine1, headingLine2] = ctaContent.headingLines ?? ctaContent.heading.split(/\s+(?=.)/);
const writeUsLabel = lang === "en" ? "OR EMAIL US:" : "O ESCRÍBENOS:";
const sectionId = lang === "en" ? "contact-cta" : "contacto";
---

<section id={sectionId} class="relative bg-[#FF4D00] text-black py-28 px-4 md:px-12 rule-page-bottom overflow-hidden text-center flex flex-col items-center justify-center">
  <!-- Giant Typographic Heading: both lines span the full page width -->
  <h2
    class="cta-heading font-display leading-[0.85] tracking-[-0.04em] text-black uppercase"
    style={`--r1:${r1}; --r2:${r2};`}
  >
    <span class="cta-heading__line cta-heading__line--l1">{headingLine1}</span>
    <span class="cta-heading__line cta-heading__line--l2">{headingLine2}</span>
  </h2>

  <div class="max-w-7xl mx-auto flex flex-col items-center">

    <p class="font-sans text-base sm:text-xl md:text-2xl font-bold max-w-2xl text-black/90 mt-8 mb-12">
      {ctaContent.subheading}
    </p>

    <!-- Large Rounded-Full Black Button (Scales on hover, stays solid black) -->
    <a
      href={ctaContent.buttonHref}
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-4 bg-black text-white font-mono-meta text-sm sm:text-base md:text-lg font-bold uppercase px-8 sm:px-12 py-5 sm:py-6 rounded-full border-2 border-black shadow-[0_12px_32px_rgba(0,0,0,0.4)] transition-all duration-300 transform hover:scale-105 hover:bg-black hover:text-[#FF4D00] hover:shadow-[0_16px_40px_rgba(0,0,0,0.6)] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-black"
    >
      <span>{ctaContent.buttonLabel}</span>
      <svg
        class="w-6 h-6 transition-transform duration-300 group-hover:translate-x-2"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="2.5"
      >
        <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </a>

    <!-- Email Direct Link -->
    <div class="mt-8">
      <a
        href={`mailto:${ctaContent.emailLabel}`}
        class="font-mono-meta text-xs sm:text-sm font-bold uppercase tracking-wider text-black underline underline-offset-4 decoration-2 hover:bg-black hover:text-[#FF4D00] px-2 py-1 transition-colors"
      >
        {writeUsLabel} {ctaContent.emailLabel}
      </a>
    </div>
  </div>
</section>
