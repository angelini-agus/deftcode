---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const content = getContent(lang);
const { navLinks } = content;

// Target URLs for language switcher based on current page
const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
// Map pages across locales
let cleanPath = pathname.replace(/^\/en(\/|$)/, "/");
if (cleanPath.startsWith("/about/")) cleanPath = cleanPath.replace("/about/", "/nosotros/");
if (cleanPath.startsWith("/projects/")) cleanPath = cleanPath.replace("/projects/", "/proyectos/");
if (cleanPath.startsWith("/contact/")) cleanPath = cleanPath.replace("/contact/", "/contacto/");
if (cleanPath.startsWith("/privacy/")) cleanPath = cleanPath.replace("/privacy/", "/privacidad/");

const esTargetHref = cleanPath;

let enTargetPath = cleanPath;
if (enTargetPath.startsWith("/nosotros/")) enTargetPath = enTargetPath.replace("/nosotros/", "/about/");
if (enTargetPath.startsWith("/proyectos/")) enTargetPath = enTargetPath.replace("/proyectos/", "/projects/");
if (enTargetPath.startsWith("/contacto/")) enTargetPath = enTargetPath.replace("/contacto/", "/contact/");
if (enTargetPath.startsWith("/privacidad/")) enTargetPath = enTargetPath.replace("/privacidad/", "/privacy/");

const enTargetHref = enTargetPath === "/" ? "/en/" : `/en${enTargetPath}`;

const homeHref = lang === "en" ? "/en/" : "/";

// Social icon links live in the right controls, replacing the old CTA
// button (the CONTACTO nav link already covers that route). URLs come
// from the content module so navbar and footer share the same source.
// Instagram first: the user asked for IG before LinkedIn. Ordering is
// local to the navbar; the footer keeps the content array's own order.
const socialLinks = (["instagram", "linkedin"] as const).flatMap((platform) => {
  const found = content.socialLinks.find((s) => s.platform === platform);
  return found ? [found] : [];
});
const socialAria: Record<string, string> =
  lang === "en"
    ? { instagram: "Deftcode on Instagram", linkedin: "Deftcode on LinkedIn" }
    : { instagram: "Instagram de Deftcode", linkedin: "LinkedIn de Deftcode" };
---

<header class="fixed top-0 left-0 w-full z-50 pointer-events-none px-4 md:px-12 py-4">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand Logo (Pure text, no black box, weight 800 Archivo Variable) -->
    <a
      href={homeHref}
      class="navbar-brand-logo pointer-events-auto inline-flex items-center gap-0.5 text-black hover:opacity-75 transition-colors duration-200 py-1"
      aria-label="Deftcode Home"
    >
      <span class="font-logo text-xl sm:text-2xl uppercase leading-none tracking-[-0.035em]">
        DEFTCODE
      </span>
      <span class="font-logo text-[11px] sm:text-[12px] uppercase leading-none relative -top-1 font-bold">
        ®
      </span>
    </a>

    <!-- Center Floating Pill Navigation -->
    <nav
      class="pointer-events-auto hidden lg:flex items-center gap-1 bg-black rounded-full px-3 py-1.5 border-2 border-black shadow-[0_8px_24px_rgba(0,0,0,0.35)]"
      aria-label="Main Navigation"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="font-mono-meta text-[12px] uppercase font-bold text-white px-3.5 py-1 rounded-full transition-all duration-200 hover:bg-white/10 hover:text-[#FF4D00] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF4D00]"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Right Controls: Language Switcher & Social Icons -->
    <div class="pointer-events-auto flex items-center gap-2 sm:gap-3">
      <!-- Language Switcher Pill -->
      <div class="flex items-center bg-black rounded-full border-2 border-black p-0.5 font-mono-meta text-[11px] font-bold shadow-md">
        <a
          href={esTargetHref}
          class={`px-2.5 py-1 rounded-full transition-all ${
            lang === "es"
              ? "bg-[#FF4D00] text-black"
              : "text-white/70 hover:text-white"
          }`}
          aria-label="Versión en Español"
        >
          ES
        </a>
        <a
          href={enTargetHref}
          class={`px-2.5 py-1 rounded-full transition-all ${
            lang === "en"
              ? "bg-[#FF4D00] text-black"
              : "text-white/70 hover:text-white"
          }`}
          aria-label="English version"
        >
          EN
        </a>
      </div>

      <div class="flex items-center gap-2">
        {socialLinks.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-black text-white p-1.5 rounded-full border-2 border-black shadow-md transition-all duration-200 hover:text-[#FF4D00] hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black"
            aria-label={socialAria[s.platform]}
          >
            {s.platform === "instagram" ? (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                <circle cx="12" cy="12" r="4.5"></circle>
                <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"></circle>
              </svg>
            ) : (
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"></path>
              </svg>
            )}
          </a>
        ))}
      </div>

      <!-- Mobile Menu Trigger -->
      <button
        id="mobile-menu-toggle"
        class="lg:hidden bg-black text-white p-2 rounded-full border-2 border-black hover:bg-[#FF4D00] hover:text-black transition-colors"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Dropdown -->
  <div
    id="mobile-drawer"
    class="pointer-events-auto hidden lg:hidden mt-3 bg-black border-2 border-black p-4 flex-col gap-3 shadow-2xl"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="font-mono-meta text-sm font-bold text-white uppercase py-2 px-3 hover:bg-[#FF4D00] hover:text-black transition-colors"
        >
          {link.label}
        </a>
      ))
    }
    <div class="border-t border-white/20 pt-3 flex justify-between items-center">
      <div class="flex items-center gap-2">
        {socialLinks.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-[#FF4D00] text-black p-1.5 rounded-full border-2 border-black transition-all duration-200 hover:bg-white hover:text-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
            aria-label={socialAria[s.platform]}
          >
            {s.platform === "instagram" ? (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                <circle cx="12" cy="12" r="4.5"></circle>
                <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"></circle>
              </svg>
            ) : (
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"></path>
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const drawer = document.getElementById("mobile-drawer");

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener("click", () => {
      const isHidden = drawer.classList.contains("hidden");
      drawer.classList.toggle("hidden", !isHidden);
      drawer.classList.toggle("flex", isHidden);
      toggleBtn.setAttribute("aria-expanded", String(isHidden));
    });

    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        drawer.classList.add("hidden");
        drawer.classList.remove("flex");
        toggleBtn.setAttribute("aria-expanded", "false");
      });
    });
  }

  const logo = document.querySelector<HTMLElement>(".navbar-brand-logo");
  if (logo) {
    const updateLogoContrast = () => {
      const rect = logo.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;

      logo.style.pointerEvents = "none";
      const el = document.elementFromPoint(x, y);
      logo.style.pointerEvents = "auto";

      if (el) {
        const darkSection = el.closest(".bg-black, [data-theme='dark']");
        const orangeSection = el.closest(".bg-\\[\\#FF4D00\\], .bg-brand-orange, #top");
        if (darkSection && !orangeSection) {
          logo.classList.remove("text-black");
          logo.classList.add("text-white");
        } else {
          logo.classList.remove("text-white");
          logo.classList.add("text-black");
        }
      }
    };

    window.addEventListener("scroll", updateLogoContrast, { passive: true });
    window.addEventListener("resize", updateLogoContrast, { passive: true });
    updateLogoContrast();
  }
</script>
