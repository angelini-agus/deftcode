---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { manifesto } = getContent(lang);

const title = lang === "en" ? "THE DEFT MANIFESTO" : "EL MANIFIESTO DEFT";
---

<section class="relative bg-black text-white py-20 px-4 md:px-12">
  <div class="max-w-7xl mx-auto">
    <div class="border-b border-white/20 pb-8 mb-12">
      <h2 data-fit-title class="reveal font-display text-4xl sm:text-5xl text-white uppercase tracking-[-0.04em] leading-[0.9]">
        {title}
      </h2>
    </div>

    <!-- Grid of Manifesto Principles -->
    <div class="manifesto-grid grid grid-cols-1 md:grid-cols-2 gap-8" data-stagger="90">
      {
        manifesto.map((item) => (
          <article class="reveal flex">
            <div class="manifesto-card relative overflow-hidden w-full border-2 border-white/20 p-8 flex flex-col justify-between bg-white/[0.02]">
              <div>
                <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
                  <span class="font-mono-meta text-2xl font-bold text-[#FF4D00]">
                    [{item.number}]
                  </span>
                  <span class="manifesto-card__dot w-2.5 h-2.5 bg-[#FF4D00]"></span>
                </div>
                <h3 class="manifesto-card__title font-display text-2xl sm:text-3xl text-white uppercase tracking-[-0.03em] leading-tight mb-4">
                  {item.title}
                </h3>
              </div>
              <p class="manifesto-card__desc font-sans text-sm sm:text-base text-white/70 leading-relaxed m-0">
                {item.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .manifesto-card {
    transition:
      opacity 280ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 220ms ease,
      background-color 220ms ease;
  }

  .manifesto-card__dot {
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .manifesto-card__title {
    transform-origin: left;
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .manifesto-card__desc {
    transition: color 220ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .manifesto-grid:has(.manifesto-card:hover) .manifesto-card:not(:hover) {
      opacity: 0.38;
    }

    .manifesto-card:hover {
      opacity: 1;
      transform: translateY(-4px);
      border-color: #FF4D00;
      background-color: rgba(255, 255, 255, 0.05);
    }

    .manifesto-card:hover .manifesto-card__dot {
      transform: scale(1.3);
    }

    .manifesto-card:hover .manifesto-card__title {
      transform: scale(1.02);
    }

    .manifesto-card:hover .manifesto-card__desc {
      color: rgba(255, 255, 255, 0.95);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .manifesto-card,
    .manifesto-card__dot,
    .manifesto-card__title,
    .manifesto-card__desc {
      transition: none;
    }

    .manifesto-card:hover,
    .manifesto-card:hover .manifesto-card__dot,
    .manifesto-card:hover .manifesto-card__title {
      transform: none;
    }
  }
</style>
