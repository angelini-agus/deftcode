---
import { Image } from "astro:assets";
import { projectAssets } from "../lib/project-images";
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { projects } = getContent(lang);
const projectCount = projects.length;

const sectionId = lang === "en" ? "projects" : "proyectos";
const title = lang === "en" ? "SOFTWARE IN PRODUCTION" : "SOFTWARE EN PRODUCCIÓN";
const cardLabel = lang === "en" ? "PROJECT" : "PROYECTO";
const viewCaseLabel = lang === "en" ? "EXPLORE FULL CASE STUDY" : "VER CASO COMPLETO";
---

<section
  id={sectionId}
  class="projects-stack relative bg-[#FF4D00] text-black"
  style={`--flip-count: ${projectCount}`}
>
  <!-- Section Title -->
  <div class="px-4 md:px-12">
    <div class="max-w-7xl mx-auto pt-14 pb-2 md:pt-16 md:pb-4">
      <div class="border-b-2 border-black pb-4 md:pb-6">
        <h2 data-fit-title class="reveal font-display text-4xl sm:text-6xl md:text-7xl text-black uppercase tracking-[-0.04em] leading-[0.88]">
          {title}
        </h2>
      </div>
    </div>
  </div>

  <!-- Runway containing the sticky stage -->
  <div class="projects-stack__runway relative" data-flip-runway>
    <div class="projects-stack__sticky sticky top-16 md:top-20 min-h-[78vh] flex items-center justify-center px-4 md:px-12 py-3 md:py-6">
      <div class="projects-stack__stage relative w-full max-w-7xl" data-flip-stage>
        <div class="projects-stack__deck relative w-full">
          {
            projects.map((item, index) => (
              <article
                class="folder w-full bg-black text-white border-2 border-black shadow-[0_16px_40px_rgba(0,0,0,0.5)] transition-shadow"
                data-flip-card={index}
                style={`z-index: ${index + 1}`}
              >
                <!-- Folder Tab Header -->
                <div class="folder__tab flex items-center justify-between border-b-2 border-white/20 bg-black px-6 py-3">
                  <div class="flex items-center gap-3">
                    <span class="w-2.5 h-2.5 bg-[#FF4D00]"></span>
                    <span class="font-mono-meta text-xs uppercase font-bold text-[#FF4D00] tracking-wider">
                      {cardLabel} [{String(index + 1).padStart(2, "0")}]
                    </span>
                  </div>
                  <span class="font-mono-meta text-xs uppercase text-white/60">
                    {item.year} // {item.category}
                  </span>
                </div>

                <!-- Folder Body -->
                <div class="folder__body p-6 sm:p-8 lg:p-10 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
                  <div class="lg:col-span-7 flex flex-col gap-4">
                    {item.client && (
                      <span class="font-mono-meta text-xs uppercase text-[#FF4D00] font-semibold tracking-wide">
                        // {item.client}
                      </span>
                    )}
                    <h3 class="font-display text-2xl sm:text-4xl lg:text-5xl text-white uppercase tracking-[-0.03em] leading-tight m-0">
                      {item.title}
                    </h3>

                    <p class="text-white/80 font-sans text-sm sm:text-base leading-relaxed">
                      {item.description}
                    </p>

                    <!-- Metrics Badges -->
                    <div class="flex flex-wrap gap-2 pt-1">
                      {item.metrics.map((metric) => (
                        <div data-count-up class="bg-[#FF4D00] text-black font-mono-meta text-xs font-bold px-3 py-1 uppercase tracking-tight">
                          {metric}
                        </div>
                      ))}
                    </div>

                    <!-- Tech Tags -->
                    <div class="flex flex-wrap gap-2 pt-1">
                      {item.tags.map((tag) => (
                        <span class="font-mono-meta text-[11px] uppercase text-white/60 border border-white/20 px-2.5 py-0.5">
                          {tag}
                        </span>
                      ))}
                    </div>

                    <!-- Direct link to full case breakdown -->
                    <div class="pt-2">
                      <a
                        href={lang === "en" ? `/en/projects/${item.slug}/` : `/proyectos/${item.slug}/`}
                        class="group inline-flex items-center gap-2 font-mono-meta text-xs font-bold text-white hover:text-[#FF4D00] uppercase tracking-wider transition-colors border-b border-white/30 hover:border-[#FF4D00] pb-0.5"
                      >
                        <span>{viewCaseLabel}</span>
                        <span class="transition-transform duration-200 group-hover:translate-x-1.5">&rarr;</span>
                      </a>
                    </div>
                  </div>

                  <!-- Visual Graphic Frame with Real Screenshot -->
                  <div class="lg:col-span-5 bg-black border-2 border-white/20 overflow-hidden flex flex-col shadow-2xl">
                    <div class="flex justify-between items-center text-xs font-mono-meta text-white/70 px-4 py-2 bg-black border-b border-white/20">
                      <span class="font-bold tracking-wider text-[#FF4D00]">{lang === "en" ? "SCREENSHOT // PROD" : "CAPTURA // PRODUCCIÓN"}</span>
                      <span class="text-[10px] font-bold text-white/60">
                        {lang === "en" ? "LIVE" : "EN VIVO"}
                      </span>
                    </div>

                    {item.imageKey && projectAssets[item.imageKey] && (
                      <button
                        type="button"
                        data-lightbox-open={item.imageKey}
                        data-lightbox-index="0"
                        aria-label={
                          lang === "en" ? "Open fullscreen screen gallery" : "Abrir galería de pantallas a pantalla completa"
                        }
                        class="relative block w-full text-left bg-black overflow-hidden group cursor-zoom-in"
                      >
                        <Image
                          src={projectAssets[item.imageKey].main}
                          alt={lang === "en" ? projectAssets[item.imageKey].altEn : projectAssets[item.imageKey].altEs}
                          width={1280}
                          height={800}
                          quality={90}
                          class="img-reveal w-full h-44 sm:h-52 md:h-60 object-cover object-top group-hover:brightness-105 group-hover:scale-[1.02] transition-transform duration-300"
                          loading="lazy"
                        />
                        <span
                          class="absolute top-3 right-3 z-10 w-8 h-8 rounded-full bg-black/70 border border-white/30 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"
                          aria-hidden="true"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path stroke-linecap="square" d="M21 21l-4.35-4.35M8 11h6M11 8v6"></path>
                          </svg>
                        </span>
                      </button>
                    )}

                    <div class="flex items-center justify-between border-t border-white/10 px-4 py-2.5 text-[11px] font-mono-meta text-white/60 bg-black">
                      <span class="truncate max-w-[200px]">{item.client || (lang === "en" ? "ENTERPRISE CLIENT" : "CLIENTE CORPORATIVO")}</span>
                    </div>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .projects-stack__runway {
    /* Height creates the scroll runway: 70vh lead-in + 90vh per card
     (each card rises during the first half of its own segment and
     holds fully uncovered for the rest, before the next one rises).
     Shorter lead-in so the first card starts rising soon after the title
     instead of after a full viewport of empty orange. */
    min-height: calc(70vh + (var(--flip-count, 6) * 90vh));
  }

  .folder {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: center top;
    transform: translateY(var(--folder-y, 0px)) scale(var(--folder-scale, 1));
    will-change: transform;
    backface-visibility: hidden;
  }

  /* First card relative in flow so deck gets proper height baseline */
  .folder:first-child {
    position: relative;
  }
</style>

<script>
  import {
    flipGeometry,
    flipCardState,
    flipProgress,
    springStep,
    defaultSpringConfig,
  } from "../lib/flip-stack";

  let flipStackInit = false;
  const initFlipStack = () => {
    if (flipStackInit) return;
    const section = document.querySelector<HTMLElement>(".projects-stack");
    const runway = document.querySelector<HTMLElement>("[data-flip-runway]");
    const stage = document.querySelector<HTMLElement>("[data-flip-stage]");
    const deck = document.querySelector<HTMLElement>(".projects-stack__deck");
    const folders = Array.from(document.querySelectorAll<HTMLElement>("[data-flip-card]"));

    if (!section || !runway || !stage || !deck || folders.length === 0) return;
    flipStackInit = true;

    const total = folders.length;
    let step = 32;
    let entryOffset = window.innerHeight * 0.7;
    let geometry = flipGeometry(total, step, entryOffset, 0.5);

    const springConfig = defaultSpringConfig();
    let springValue = 0;
    let springVelocity = 0;
    let targetProgress = 0;
    let rafId: number | null = null;
    let lastFrameAt: number | null = null;
    let reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const measure = () => {
      const firstCard = folders[0];
      const cardHeight = firstCard ? firstCard.getBoundingClientRect().height : 400;
      step = Math.max(28, Math.min(48, window.innerHeight * 0.05));
      // Cards only need to travel enough to clear the stage, not a whole
      // extra viewport: a shorter rise keeps the deck visually attached to
      // the heading while the scroll-driven flip starts much earlier.
      entryOffset = Math.max(240, cardHeight * 0.55);
      geometry = flipGeometry(total, step, entryOffset, 0.5);
    };

    const syncDom = (progress: number) => {
      folders.forEach((folder, index) => {
        const state = flipCardState(progress, index, geometry, reduceMotion);
        folder.style.setProperty("--folder-y", `${state.y.toFixed(2)}px`);
        folder.style.setProperty("--folder-scale", `${state.scale.toFixed(4)}`);
        folder.style.opacity = `${state.opacity.toFixed(3)}`;
        // Waiting cards are transparent but still painted above the front
        // card (increasing z-index) — without this they silently swallow
        // clicks on its "VER CASO COMPLETO" link.
        folder.style.pointerEvents = state.opacity > 0.01 ? "auto" : "none";
      });
    };

    const tick = (now: number) => {
      rafId = null;
      const dt = lastFrameAt === null ? 1 / 60 : Math.max(0, (now - lastFrameAt) / 1000);
      lastFrameAt = now;

      const result = springStep(
        springValue,
        springVelocity,
        targetProgress,
        dt,
        springConfig
      );
      springValue = result.value;
      springVelocity = result.velocity;

      syncDom(springValue);

      if (!result.settled) {
        rafId = requestAnimationFrame(tick);
      }
    };

    const requestTick = () => {
      if (rafId !== null) return;
      lastFrameAt = null;
      rafId = requestAnimationFrame(tick);
    };

    const onScroll = () => {
      const rect = runway.getBoundingClientRect();
      const scrollY = window.scrollY;
      // Start the flip while the heading is still well inside the viewport.
      // The 45vh lead plus a shorter rise distance put the first card right
      // under the title instead of after a long empty orange stretch.
      const stickyOffset = window.innerWidth >= 768 ? 80 : 64;
      const lead = window.innerHeight * 0.45;
      const runwayTop = rect.top + scrollY - stickyOffset - lead;
      const runwayHeight = rect.height;
      const stickyHeight = window.innerHeight;

      targetProgress = flipProgress(scrollY, runwayTop, runwayHeight, stickyHeight);
      requestTick();
    };

    measure();
    onScroll();

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => {
      measure();
      onScroll();
    }, { passive: true });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFlipStack, { once: true });
  } else {
    initFlipStack();
  }
</script>
