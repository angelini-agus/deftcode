---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { problem } = getContent(lang);
---

<section id="problema" class="relative bg-[#FF4D00] text-black border-b-2 border-black">
  <div class="max-w-7xl mx-auto px-4 md:px-12 py-16 md:py-20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b-2 border-black pb-8">
      <div>
        <span class="font-mono-meta text-xs uppercase text-black font-bold tracking-widest block mb-2">
          {problem.eyebrow}
        </span>
        <h2 class="reveal font-display text-4xl sm:text-6xl md:text-7xl text-black uppercase tracking-[-0.04em] leading-[0.88]">
          {problem.title}
        </h2>
      </div>
      <p class="font-mono-meta text-xs sm:text-sm text-black/80 max-w-sm sm:text-right font-medium">
        {problem.intro}
      </p>
    </div>

    <!-- Numbered problem cards (numbered-bullet structure) -->
    <div class="grid gap-4 md:grid-cols-3 mt-10 md:mt-12">
      {
        problem.bullets.map((bullet, index) => (
          <div class="border-2 border-black p-6 bg-transparent">
            <span class="font-mono-meta text-sm text-black/70 font-bold">
              [{String(index + 1).padStart(2, "0")}]
            </span>
            <p class="text-black/80 font-sans text-sm leading-relaxed mt-3">{bullet}</p>
          </div>
        ))
      }
    </div>

    <!-- Closing band: straight to how we solve it (internal anchor) -->
    <a
      href={problem.closingHref}
      class="mt-8 flex items-center justify-between gap-4 bg-black text-white px-6 py-5 group transition-colors focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-black"
    >
      <span class="font-mono-meta text-sm md:text-base font-bold uppercase tracking-wider group-hover:text-[#FF4D00]">
        {problem.closingLabel}
      </span>
      <svg
        class="w-5 h-5 shrink-0 transition-transform duration-300 group-hover:translate-x-2"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        aria-hidden="true"
      >
        <path stroke-linecap="square" stroke-linejoin="miter" d="M4 12h16m-6-6l6 6-6 6"></path>
      </svg>
    </a>
  </div>
</section>
