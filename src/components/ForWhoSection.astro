---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { forWho } = getContent(lang);
---

<section id="para-quien" class="relative bg-[#FF4D00] text-black border-b-2 border-black">
  <div class="max-w-7xl mx-auto px-4 md:px-12 py-16 md:py-20">
    <div class="border-b-2 border-black pb-8">
      <span class="font-mono-meta text-xs uppercase text-black font-bold tracking-widest block mb-2">
        {forWho.eyebrow}
      </span>
      <h2 class="reveal font-display text-4xl sm:text-6xl md:text-7xl text-black uppercase tracking-[-0.04em] leading-[0.88]">
        {forWho.title}
      </h2>
    </div>

    <!-- Check / cross two columns -->
    <div class="grid gap-4 md:grid-cols-2 mt-10 md:mt-12">
      <!-- YES card -->
      <div class="bg-black text-white border-2 border-black p-8">
        <span class="font-mono-meta text-xs uppercase font-bold text-[#FF4D00] tracking-widest">
          {forWho.yesLabel}
        </span>
        <ul class="m-0 p-0 list-none">
          {
            forWho.yesItems.map((item) => (
              <li class="flex items-start gap-3 mt-5">
                <svg
                  class="w-5 h-5 shrink-0 text-[#FF4D00] mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path stroke-linecap="square" stroke-linejoin="miter" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-white/85 font-sans text-sm leading-relaxed">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- NO card -->
      <div class="border-2 border-black p-8 bg-transparent text-black">
        <span class="font-mono-meta text-xs uppercase font-bold text-black tracking-widest">
          {forWho.noLabel}
        </span>
        <ul class="m-0 p-0 list-none">
          {
            forWho.noItems.map((item) => (
              <li class="flex items-start gap-3 mt-5">
                <svg
                  class="w-5 h-5 shrink-0 text-black mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path stroke-linecap="square" stroke-linejoin="miter" d="M6 6l12 12M18 6L6 18"></path>
                </svg>
                <span class="text-black/80 font-sans text-sm leading-relaxed">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
