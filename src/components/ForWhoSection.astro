---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
  /** "problems": §3.4 problem cards. "fit": §3.8 NO/SI cards. */
  variant?: "problems" | "fit";
}

const { lang = "es", variant = "fit" } = Astro.props;
const content = getContent(lang);
const forWho = content.forWho;
const problems = content.problems;
---

{
  variant === "problems" ? (
    <section id="que-pasa" class="relative bg-black text-white">
      <div class="max-w-7xl mx-auto px-4 md:px-12 py-16 md:py-20">
        <div class="border-b border-white/20 pb-8">
          <span class="font-mono-meta text-xs uppercase text-[#FF4D00] font-bold tracking-widest block mb-2">
            {problems.eyebrow}
          </span>
          <h2 data-fit-title class="reveal font-display text-4xl sm:text-6xl md:text-7xl text-white uppercase tracking-[-0.04em] leading-[0.88]">
            {problems.title}
          </h2>
        </div>

        <!-- §3.4: the four problems as an animated checklist (user
             request): each row is a real checkbox (click anywhere to
             mark), the check draws itself, marked rows highlight, and a
             live counter chip shows the tally. No per-row CTAs — the only
             action button is the section closer. Rows stagger on reveal
             via the shared IntersectionObserver (transition-delay). -->
        <ol class="mt-10 md:mt-12 m-0 p-0 list-none">
          {problems.cards.map((card, i) => (
            <li
              class="problem-row group reveal border-b border-white/15 transition-colors duration-200"
              style={`transition-delay:${i * 90}ms`}
            >
              <label
                for={`problem-mark-${card.key}`}
                class="grid grid-cols-[auto_1fr] gap-3 md:gap-6 py-7 md:py-8 px-2 md:px-4 items-start cursor-pointer select-none hover:bg-white/[0.05] transition-colors duration-200"
              >
                <input data-problem-check type="checkbox" class="peer sr-only" />
                <span class="problem-marker flex items-center gap-2 md:gap-3 shrink-0 md:pt-1">
                  <span
                    class="problem-check-box w-7 h-7 md:w-8 md:h-8 shrink-0 rounded-full border-2 border-white/30 peer-checked:bg-[#FF4D00] peer-checked:border-[#FF4D00] flex items-center justify-center transition-colors duration-200"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      class="w-4 h-4 md:w-5 md:h-5 text-black"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3.5"
                      aria-hidden="true"
                    >
                      <path class="problem-check-path" d="M5 13l4 4L19 7" stroke-linecap="square" stroke-linejoin="miter"></path>
                    </svg>
                  </span>
                  <span class="problem-index font-mono-meta text-xs font-bold tracking-widest text-[#FF4D00]">
                    ({String(i + 1).padStart(2, "0")})
                  </span>
                </span>
                <div>
                  <h3
                    class="font-display text-2xl sm:text-3xl md:text-4xl text-white uppercase tracking-[-0.03em] leading-[0.95] m-0 transition-colors duration-200"
                  >
                    {card.title}
                  </h3>
                  <p class="text-white/70 font-sans text-sm sm:text-base leading-relaxed mt-3 mb-0 max-w-3xl">
                    {card.description}
                  </p>
                </div>
              </label>
            </li>
          ))}
        </ol>

        <!-- Cierre (§3.4): user request — the "Si marcaste una..." line
             sits between the last bullet and the CTA, with the live
             checked-count chip next to it. -->
        <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-4">
          <p class="font-sans text-base text-white/85 font-bold m-0 max-w-2xl">
            {problems.intro}
          </p>
          <span
            id="problem-counter"
            data-template={problems.counterLabel}
            role="status"
            aria-live="polite"
            class="hidden font-mono-meta text-[11px] uppercase font-bold tracking-wider text-[#FF4D00] border border-[#FF4D00] px-3 py-1.5 whitespace-nowrap sm:ml-auto"
          ></span>
          <a
            href={problems.ctaHref}
            class="sm:ml-auto group inline-flex items-center gap-3 bg-[#FF4D00] text-black font-mono-meta text-xs font-bold uppercase px-5 py-3 rounded-full border-2 border-black hover:scale-105 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
          >
            <span>{problems.ctaLabel}</span>
            <svg
              viewBox="0 0 24 24"
              class="w-4 h-4 problem-cta-check"
              fill="none"
              stroke="currentColor"
              stroke-width="3.5"
              aria-hidden="true"
            >
              <path stroke-linecap="square" stroke-linejoin="miter" d="M5 13l4 4L19 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  ) : (
    <section id="para-quien" class="relative bg-black text-white">
      <div class="max-w-7xl mx-auto px-4 md:px-12 py-16 md:py-20">
        <div class="border-b border-white/20 pb-8">
          <span class="font-mono-meta text-xs uppercase text-[#FF4D00] font-bold tracking-widest block mb-2">
            {forWho.eyebrow}
          </span>
          <h2 data-fit-title class="reveal font-display text-4xl sm:text-6xl md:text-7xl text-white uppercase tracking-[-0.04em] leading-[0.88]">
            {forWho.title}
          </h2>
        </div>

        <!-- Cross / check two columns. The NO card leads: the section's
             message is no-working-with-anyone, so the orange card
             carries the exclusions first and the ghost card answers with
             who the work IS for. -->
        <div class="grid gap-4 md:grid-cols-2 mt-10 md:mt-12">
          <!-- NO card (first): black face, white copy, orange crosses -->
          <div class="bg-black text-white border-2 border-white/20 p-8">
            <span class="font-mono-meta text-xs uppercase font-bold text-[#FF4D00] tracking-widest">
              {forWho.noLabel}
            </span>
            <ul class="m-0 p-0 list-none">
              {forWho.noItems.map((item) => (
                <li class="flex items-start gap-3 mt-5">
                  <svg
                    class="w-5 h-5 shrink-0 text-[#FF4D00] mt-0.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="square" stroke-linejoin="miter" d="M6 6l12 12M18 6L6 18"></path>
                  </svg>
                  <span class="text-white/85 font-sans text-sm leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- YES card: ghost white-on-black -->
          <div class="border-2 border-white/20 p-8 bg-white/[0.02] text-white">
            <span class="font-mono-meta text-xs uppercase font-bold text-[#FF4D00] tracking-widest">
              {forWho.yesLabel}
            </span>
            <ul class="m-0 p-0 list-none">
              {forWho.yesItems.map((item) => (
                <li class="flex items-start gap-3 mt-5">
                  <svg
                    class="w-5 h-5 shrink-0 text-[#FF4D00] mt-0.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="square" stroke-linejoin="miter" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="text-white/85 font-sans text-sm leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Cierre (§3.8): text only — single CTA policy. -->
        <div class="mt-10 border-t border-white/20 pt-8">
          <p class="font-sans text-base text-white/85 font-bold m-0 max-w-2xl">
            {forWho.closingText}
          </p>
        </div>
      </div>
    </section>
  )
}

<style>
  /* Animated check: the stroke draws itself when the row is marked. */
  .problem-check-path {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    transition: stroke-dashoffset 0.35s cubic-bezier(0.23, 1, 0.32, 1) 0.05s;
  }
  .problem-row input:checked ~ .problem-check-box .problem-check-path {
    stroke-dashoffset: 0;
  }
  /* Marked row: stays highlighted after hover, title goes orange, the
     index switches to white. :has() is supported in every modern
     browser; without it only the checkbox itself changes. */
  .problem-row:has(input:checked) {
    background-color: rgba(255, 255, 255, 0.06);
  }
  .problem-row:has(input:checked) h3 {
    color: #ff4d00;
  }
  .problem-row:has(input:checked) .problem-index {
    color: #fff;
  }
  @keyframes counter-pop {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.18);
    }
    100% {
      transform: scale(1);
    }
  }
  #problem-counter.counter-pop {
    animation: counter-pop 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  }
  /* The closer CTA wears a check instead of an arrow: it redraws itself
     on hover (site-wide rule: CTAs keep their face color, feedback is
     motion, not color). */
  .problem-cta-check path {
    stroke-dasharray: 24;
    stroke-dashoffset: 0;
  }
  a:hover .problem-cta-check path {
    animation: problem-check-draw 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }
  @keyframes problem-check-draw {
    from {
      stroke-dashoffset: 24;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  // Live tally: updates the counter chip every time a row is marked or
  // unmarked, with a single pop per change.
  const boxes = document.querySelectorAll("[data-problem-check]");
  const counter = document.getElementById("problem-counter");
  if (boxes.length && counter) {
    const update = () => {
      const n = Array.from(boxes).filter((b) => b.checked).length;
      const template = counter.dataset.template || "{n}";
      if (n > 0) {
        counter.textContent = template.replace("{n}", String(n));
        counter.classList.remove("hidden", "counter-pop");
        void counter.offsetWidth;
        counter.classList.add("counter-pop");
      } else {
        counter.classList.add("hidden");
      }
    };
    boxes.forEach((b) => b.addEventListener("change", update));
  }
</script>
