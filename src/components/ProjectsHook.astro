---
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;

const sectionId = lang === "en" ? "projects" : "proyectos";
const eyebrow = lang === "en" ? "// CASES & DELIVERABLES" : "// CASOS & ENTREGABLES";
const title = lang === "en" ? "SOFTWARE IN PRODUCTION" : "SOFTWARE EN PRODUCCIÓN";
const intro =
  lang === "en"
    ? "REAL DEPLOYMENTS. ROBUST ARCHITECTURES AND SUB-MILLISECOND RESPONSE TIMES."
    : "DESPLIEGUES REALES. ARQUITECTURAS ROBUSTAS Y TIEMPOS DE RESPUESTA MEDIDOS AL MILISEGUNDO.";
const linkLabel = lang === "en" ? "EXPLORE ALL PROJECTS" : "VER TODOS LOS PROYECTOS";
const linkHref = lang === "en" ? "/en/projects/" : "/proyectos/";
---

<!-- Editorial hook banner: compact replacement for the full ProjectsStack
     deck on the homepage. Reuses the ProjectsStack header style system;
     leads to the full projects page instead of rendering cards. -->
<section
  id={sectionId}
  class="projects-hook relative bg-[#FF4D00] text-black border-b-2 border-black"
>
  <div class="px-4 md:px-12">
    <div class="max-w-7xl mx-auto py-16 md:py-20">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b-2 border-black pb-8">
        <div>
          <span class="font-mono-meta text-xs uppercase text-black font-bold tracking-widest block mb-2">
            {eyebrow}
          </span>
          <h2 class="reveal font-display text-4xl sm:text-6xl md:text-7xl text-black uppercase tracking-[-0.04em] leading-[0.88]">
            {title}
          </h2>
        </div>
        <p class="font-mono-meta text-xs sm:text-sm text-black/80 max-w-sm sm:text-right font-medium">
          {intro}
        </p>
      </div>

      <!-- Big editorial link to the full projects page (internal route) -->
      <div class="mt-10 md:mt-12 flex justify-start sm:justify-end">
        <a
          href={linkHref}
          class="group inline-flex items-center gap-3 font-mono-meta text-base sm:text-lg md:text-xl font-bold uppercase tracking-wider text-black border-b-2 border-black pb-1 transition-colors hover:border-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-black"
        >
          <span>{linkLabel}</span>
          <span class="transition-transform duration-300 group-hover:translate-x-2">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>
