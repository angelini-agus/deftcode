---
/**
 * Intro preloader (first visit per session) — one GSAP master timeline:
 *
 *   0.0–0.8  solid black base; the orange DEFTCODE word emerges from
 *            darkness (opacity 0→1, blur(6px)→0, scale 1.04→1, power2.out).
 *   0.8–1.7  solid orange curtain rises from the bottom (yPercent 100→0,
 *            power3.inOut) carrying its own screen-anchored BLACK word
 *            copy: the inner wrapper is counter-translated in lockstep
 *            inside the clipped curtain, so the curtain's top edge inverts
 *            the word orange→black in real time with no manual clip math.
 *   1.7–2.1  both word copies fade (power2.in); the curtain already covers
 *            the viewport, so the overlay is dropped at ~2.06s with no
 *            visual jump — the page behind is the orange hero.
 *   2.1      handoff: "deft:intro:hero" event + scroll lock release; the
 *            hero entrance (Hero.astro) answers the event (2.1s–3.3s).
 *   2.1–2.8  navbar groups slide down staggered (logo → menu pill → right
 *            cluster) inside this same master timeline, so every
 *            non-minimal page gets the header entrance even without a Hero.
 *
 * Total intro: 3.3s. Timeline is driven from document.fonts.ready.
 *
 * Guards preserved: replay policy via the head inline script (plays on
 * refresh and external arrivals, skips internal navigation and
 * back/forward by adding .preload-skip), prefers-reduced-motion, no-JS
 * noscript hide, 6s JS
 * failsafe + pure-CSS 6s failsafe, scroll lock released on finish,
 * bfcache pageshow(persisted) teardown.
 */
interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;
const srLabel = lang === "en" ? "DEFTCODE® is loading" : "DEFTCODE® está cargando";
---

<div
  data-preloader
  class="fixed inset-0 z-[100] overflow-hidden bg-black"
  role="img"
  aria-label={srLabel}
  aria-hidden="true"
>
  <!-- Base layer: solid black canvas behind everything (phase 1 backdrop). -->
  <div data-preloader-base class="absolute inset-0 bg-black"></div>

  <!-- Orange word copy: screen-anchored, centered, emerges from darkness. -->
  <div class="absolute inset-0 flex items-center justify-center">
    <span data-preloader-word-orange class="preloader-word text-[#FF4D00]">DEFTCODE®</span>
  </div>

  <!-- Orange curtain: rises from the bottom carrying its own clipped BLACK
       word copy. The inner wrapper is counter-translated in lockstep with
       the curtain, so the black word stays screen-anchored while the
       curtain's top edge crosses the centered word — orange above the
       edge, black below it, exact sync. -->
  <div data-preloader-curtain class="preloader-curtain absolute inset-0 overflow-hidden bg-[#FF4D00]">
    <div
      data-preloader-curtain-inner
      class="preloader-curtain-inner absolute inset-0 flex items-center justify-center"
    >
      <span data-preloader-word-black class="preloader-word text-black">DEFTCODE®</span>
    </div>
  </div>
</div>

<noscript>
  <style>
    [data-preloader] { display: none !important; }
  </style>
</noscript>

<style>
  [data-preloader] {
    /* Overlay paints its own canvas; page is identical beneath. */
    contain: strict;
    /* Pure-CSS failsafe: even if the module script never runs, the overlay
       cannot trap the page. */
    animation: preloader-failsafe 1ms linear 6s forwards;
  }
  @keyframes preloader-failsafe {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }
  .preloader-word {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
    /* Spec clamp; the min() fit cap keeps the word off the screen edges on
       narrow viewports (DEFTCODE® measures ~6em in Archivo Black). */
    font-size: min(clamp(4.5rem, 11vw, 10rem), calc((100vw - 2rem) / 6.9));
    will-change: opacity, transform, filter;
  }
  /* Phase 1 initial state: the orange word waits in darkness. */
  [data-preloader-word-orange] {
    opacity: 0;
    transform: scale(1.04);
    filter: blur(6px);
  }
  /* Phase 2 initial states: curtain parked below the viewport; its inner
     copy counter-translated so the black word is screen-anchored. These
     CSS transforms are only the pre-paint fallback — the module re-declares
     them with gsap.set(yPercent) before the timeline builds (a CSS %
     translate parsed by GSAP becomes a pixel y and the tween would no-op). */
  .preloader-curtain {
    transform: translateY(100%);
    will-change: transform;
  }
  .preloader-curtain-inner {
    transform: translateY(-100%);
    will-change: transform;
  }
</style>

<style is:global>
  /* Global on purpose: Astro scoping would hash the `html` compound and
     the skip decided at head time would never match. Unique attribute,
     no leak risk. */
  html.preload-skip [data-preloader] {
    display: none;
  }

  /* Navbar entrance initial state, applied only while the intro actually
     runs (html.intro-nav, decided pre-paint by the BaseLayout head script).
     The master timeline slides the three groups down at 2.1s: logo, menu
     pill, right cluster. Zero hidden states on skip/reduced/no-JS. A
     dedicated gate (not .intro-run) lets the master drop the inline styles
     at ~2.8s while the hero entrance still needs its own hidden states. */
  html.intro-nav .site-nav .navbar-brand-logo,
  html.intro-nav .site-nav nav[aria-label="Main Navigation"],
  html.intro-nav .site-nav .nav-shell > div:last-child {
    opacity: 0;
    transform: translateY(-25px);
  }
</style>

<script>
  import gsap from "gsap";

  const overlay = document.querySelector<HTMLElement>("[data-preloader]");
  const html = document.documentElement;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  // The head inline script flags skips before paint; belt and braces here.
  const skipped = !overlay || html.classList.contains("preload-skip");

  // Navbar entrance targets (every non-minimal page renders the navbar).
  const navGroups = [
    document.querySelector<HTMLElement>(".site-nav .navbar-brand-logo"),
    document.querySelector<HTMLElement>('.site-nav nav[aria-label="Main Navigation"]'),
    document.querySelector<HTMLElement>(".site-nav .nav-shell > div:last-child"),
  ].filter((el): el is HTMLElement => Boolean(el));

  let tl: ReturnType<typeof gsap.timeline> | null = null;
  let finished = false;

  const releaseScrollLock = () => {
    html.style.overflow = "";
  };

  const removeOverlay = () => overlay?.remove();

  // Nav entrance done: drop its gate and the inline styles so CSS-driven
  // details (e.g. the logo's hover dim) keep working afterwards.
  const revealNav = () => {
    html.classList.remove("intro-nav");
    gsap.set(navGroups, { clearProps: "opacity,transform" });
  };

  // Intro handoff at t=2.1s: the hero entrance is signalled and the scroll
  // lock releases. The navbar groups keep animating inside this timeline.
  const handoff = () => {
    releaseScrollLock();
    html.dataset.introHandoff = "1";
    window.dispatchEvent(new CustomEvent("deft:intro:hero"));
  };

  const onPageShow = (e: PageTransitionEvent) => {
    if (e.persisted) teardown();
  };

  // Abrupt end (failsafe, bfcache restore): kill the timeline, drop the
  // overlay, release the lock and reveal the page. Once the hero entrance
  // started it owns .intro-run (removed by its own onComplete); until then
  // it is dropped here so nothing stays hidden.
  const teardown = () => {
    if (finished) return;
    finished = true;
    window.removeEventListener("pageshow", onPageShow);
    tl?.kill();
    tl = null;
    removeOverlay();
    releaseScrollLock();
    revealNav();
    if (html.dataset.introStarted !== "1") html.classList.remove("intro-run");
  };

  if (!skipped && reduced) {
    teardown();
  } else if (skipped) {
    overlay?.remove();
  } else if (overlay) {
    html.style.overflow = "hidden";
    window.addEventListener("pageshow", onPageShow);
    window.setTimeout(teardown, 6000); // hard failsafe: never trap the user

    const orangeWord = overlay.querySelector<HTMLElement>("[data-preloader-word-orange]");
    const blackWord = overlay.querySelector<HTMLElement>("[data-preloader-word-black]");
    const curtain = overlay.querySelector<HTMLElement>("[data-preloader-curtain]");
    const curtainInner = overlay.querySelector<HTMLElement>("[data-preloader-curtain-inner]");

    const build = () => {
      if (finished || !overlay?.isConnected) return;

      tl = gsap.timeline();

      // Phase 1 (0–0.8s): the orange word emerges from the black base.
      if (orangeWord) {
        tl.to(orangeWord, { opacity: 1, scale: 1, filter: "blur(0px)", duration: 0.8, ease: "power2.out" }, 0);
      }

      // Phase 2 (0.8–1.7s): the orange curtain rises; the clipped black
      // word copy inverts the word color in real time. Both tweens share
      // duration + ease + start so the counter-translation stays in exact
      // lockstep (screen-anchored black word).
      // Initial offsets are set HERE with gsap.set, not in CSS: GSAP
      // parses a CSS translateY(100%) into a pixel `y` component (900px)
      // and keeps it — tweening yPercent alone would ride ON TOP of that
      // frozen 900px offset (1800→900: still off-screen the whole time).
      // y:0 clears the inherited pixel component, yPercent re-parks it.
      if (curtain && curtainInner) {
        gsap.set(curtain, { y: 0, yPercent: 100 });
        gsap.set(curtainInner, { y: 0, yPercent: -100 });
        tl.to(curtain, { yPercent: 0, duration: 0.9, ease: "power3.inOut" }, 0.8);
        tl.to(curtainInner, { yPercent: 0, duration: 0.9, ease: "power3.inOut" }, 0.8);
      }

      // Phase 3 (1.7–2.1s): both copies fade out; the curtain already
      // covers the viewport, so the overlay is dropped at ~2.06s with no
      // visual jump — the page behind is the orange hero.
      const words = [orangeWord, blackWord].filter((el): el is HTMLElement => Boolean(el));
      if (words.length > 0) {
        tl.to(words, { opacity: 0, duration: 0.3, ease: "power2.in" }, 1.7);
      }
      tl.call(removeOverlay, undefined, 2.06);

      // Phase 4a (2.1s–~2.8s): navbar slides down, staggered logo → pill →
      // right cluster. The hero elements answer the handoff event below.
      if (navGroups.length > 0) {
        tl.to(navGroups, { y: 0, opacity: 1, duration: 0.55, ease: "power3.out", stagger: 0.08 }, 2.1);
      }
      tl.call(revealNav, undefined, 2.82);
      tl.call(handoff, undefined, 2.1);
    };

    // Fonts first: measurements are real and there is no FOUT.
    if (document.fonts?.ready) {
      document.fonts.ready.then(build);
    } else {
      build();
    }
  }
</script>
