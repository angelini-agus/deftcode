---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
  /** Embedded mode (home CTA final): tighter outer spacing. */
  embedded?: boolean;
}

const { lang = "es", embedded = false } = Astro.props;
const { contactForm, problems } = getContent(lang);

// Web3Forms access key (public by design: it ships in the rendered form).
// Set it in .env so it never lands in the repository. Without it every
// submit is rejected, so warn loudly at build time.
const ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY as string | undefined;
if (import.meta.env.PROD && !ACCESS_KEY) {
  console.warn(
    "[deftcode] PUBLIC_WEB3FORMS_ACCESS_KEY is not set: the contact form cannot submit. Copy .env.example to .env and fill it in, then rebuild.",
  );
}

// TODO: Meta Pixel + Conversions API — fire a Lead conversion event on
// every successful submit before launching paid campaigns
// (ESTRATEGIA-COPY.md §7 "Reglas de la landing de Meta Ads").

// ?problema=<key> → label map for the preselection note (client-side).
const problemMap = Object.fromEntries(problems.cards.map((card) => [card.key, card.buttonLabel]));
---

<section id="formulario" class={embedded ? "" : "relative bg-black px-4 md:px-12 py-16 md:py-20"}>
  <div class={embedded ? "max-w-3xl mx-auto" : "max-w-7xl mx-auto"}>
    <div
      id="form-card"
      class={`reveal bg-black text-white p-8 sm:p-10 md:p-12 border-2 ${embedded ? "border-black shadow-[12px_12px_0_#000000]" : "border-white/20 max-w-3xl mx-auto"}`}
    >
      <form
        id="diagnostico-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        class="flex flex-col gap-6"
      >
        <input type="hidden" name="access_key" value={ACCESS_KEY ?? ""} />
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
        <!-- Problem carried from the home cards (?problema=<key>) -->
        <input type="hidden" name="problema" id="problema-input" value="" />

        <!-- Preselected problem confirmation (hidden until ?problema= is present) -->
        <p
          id="problema-note"
          class="hidden font-mono-meta text-xs uppercase font-bold text-[#FF4D00] tracking-wider m-0"
        >
        </p>

        <!-- Nombre -->
        <div class="flex flex-col gap-2">
          <label for="nombre" class="font-mono-meta text-xs font-bold uppercase tracking-wider text-white">
            {contactForm.nameLabel} *
          </label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            required
            placeholder={contactForm.namePlaceholder}
            class="w-full bg-white/[0.07] text-white font-mono-meta text-sm p-4 border-2 border-white/25 focus:outline-none focus:bg-white/[0.1] focus:ring-1 focus:ring-[#FF4D00] placeholder:text-white/50 shadow-[inset_0_1px_0_rgba(255,255,255,0.15)]"
          />
        </div>

        <!-- Empresa -->
        <div class="flex flex-col gap-2">
          <label for="empresa" class="font-mono-meta text-xs font-bold uppercase tracking-wider text-white">
            {contactForm.companyLabel} *
          </label>
          <input
            type="text"
            id="empresa"
            name="empresa"
            required
            placeholder={contactForm.companyPlaceholder}
            class="w-full bg-white/[0.07] text-white font-mono-meta text-sm p-4 border-2 border-white/25 focus:outline-none focus:bg-white/[0.1] focus:ring-1 focus:ring-[#FF4D00] placeholder:text-white/50 shadow-[inset_0_1px_0_rgba(255,255,255,0.15)]"
          />
        </div>

        <!-- Email -->
        <div class="flex flex-col gap-2">
          <label for="email" class="font-mono-meta text-xs font-bold uppercase tracking-wider text-white">
            {contactForm.emailLabel} *
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder={contactForm.emailPlaceholder}
            class="w-full bg-white/[0.07] text-white font-mono-meta text-sm p-4 border-2 border-white/25 focus:outline-none focus:bg-white/[0.1] focus:ring-1 focus:ring-[#FF4D00] placeholder:text-white/50 shadow-[inset_0_1px_0_rgba(255,255,255,0.15)]"
          />
        </div>

        <!-- Teléfono -->
        <div class="flex flex-col gap-2">
          <label for="telefono" class="font-mono-meta text-xs font-bold uppercase tracking-wider text-white">
            {contactForm.phoneLabel} *
          </label>
          <input
            type="tel"
            id="telefono"
            name="telefono"
            required
            placeholder={contactForm.phonePlaceholder}
            class="w-full bg-white/[0.07] text-white font-mono-meta text-sm p-4 border-2 border-white/25 focus:outline-none focus:bg-white/[0.1] focus:ring-1 focus:ring-[#FF4D00] placeholder:text-white/50 shadow-[inset_0_1px_0_rgba(255,255,255,0.15)]"
          />
        </div>

        <!-- Submit -->
        <button
          type="submit"
          class="group w-full bg-white text-black font-mono-meta text-sm sm:text-base font-bold uppercase p-5 rounded-full border-2 border-black hover:bg-white transition-all hover:scale-[1.02] shadow-lg flex items-center justify-center gap-3 cursor-pointer mt-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
        >
          <span>{contactForm.submitLabel}</span>
          <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>

        <!-- Microcopy (§7) -->
        <p class="font-mono-meta text-[11px] text-white/60 uppercase tracking-wider m-0">
          {contactForm.microcopy}
        </p>
      </form>

      <!-- Success screen (§7) -->
      <div id="form-success" class="hidden">
        <p class="font-display text-3xl sm:text-4xl text-[#FF4D00] uppercase tracking-tight m-0">
          {contactForm.successTitlePrefix} <span id="success-name"></span>.
        </p>
        <p class="text-white/85 font-sans text-base sm:text-lg mt-4 mb-0">
          {contactForm.successBody}
        </p>
        <!-- TODO: point to the lead magnet savings calculator once it ships;
             the href is a placeholder by design (ESTRATEGIA-COPY.md §8). -->
        <a
          href={contactForm.successCalcHref}
          class="group mt-6 inline-flex items-center gap-2 font-mono-meta text-xs font-bold uppercase text-[#FF4D00] hover:text-white transition-colors border-b border-white/30 hover:border-[#FF4D00] pb-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF4D00]"
        >
          <span>{contactForm.successCalcLabel}</span>
          <span class="transition-transform duration-200 group-hover:translate-x-1.5" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ problemMap, problemPrefix: contactForm.problemSelectedPrefix, embedded }}>
  // --- Entry scroll: land on the form card, not the page banner. ---
  // Runs only on the standalone contact pages; the embedded home form keeps
  // its place in the page. Links to /contacto/ carry #formulario, and the
  // card is centered here after fonts settle so the fixed navbar never
  // covers the first field. Direct entry without the hash stays at the
  // top: the visitor decides when to reach the form.
  var formCard = document.getElementById("form-card");

  if (formCard && !embedded) {
    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    var centerFormCard = () => {
      if (!formCard) return;
      // Absolute card top in the document. .reveal slides the card by 16px
      // while it enters; subtract that transform so the target is the final
      // resting position, not the mid-animation one.
      var transform = window.getComputedStyle(formCard).transform;
      var translateY = 0;
      var matrix = transform.match(/matrix\(([^)]+)\)/);
      if (matrix) {
        translateY = parseFloat(matrix[1].split(",")[5]) || 0;
      } else {
        var matrix3d = transform.match(/matrix3d\(([^)]+)\)/);
        if (matrix3d) translateY = parseFloat(matrix3d[1].split(",")[13]) || 0;
      }
      var cardTop = window.scrollY + formCard.getBoundingClientRect().top - translateY;

      var viewportH = window.innerHeight;
      var slack = viewportH - formCard.offsetHeight;
      var h1 = document.querySelector("h1");
      var nav = Array.from(document.querySelectorAll("header")).find(function (el) {
        return !el.contains(h1);
      });
      var pinTop = Math.max(64, Math.round(nav ? nav.getBoundingClientRect().bottom : 0) + 24);
      // Enough room: true vertical centering. Tight screens: pin the top
      // below the fixed navbar with a little air.
      var target = slack >= 90 ? cardTop - slack / 2 : cardTop - pinTop;
      window.scrollTo({
        top: Math.max(0, Math.round(target)),
        behavior: reduceMotion ? "auto" : "smooth",
      });
    };

    var centerIfHashed = () => {
      if (window.location.hash === "#formulario") centerFormCard();
    };

    document.fonts.ready.then(() => requestAnimationFrame(centerIfHashed));
    // The browser's own #hash jump can land after fonts.ready; re-center
    // once it has settled so the final position is always the form card.
    window.setTimeout(centerIfHashed, 350);
    window.addEventListener("hashchange", () => {
      if (window.location.hash === "#formulario") centerFormCard();
    });
  }

  // --- Problem preselection: ?problema=<key> from the home cards (§3.4) ---
  var params = new URLSearchParams(window.location.search);
  var problema = params.get("problema");
  var problemInput = document.getElementById("problema-input");
  var problemNote = document.getElementById("problema-note");

  if (problema && problemMap[problema] && problemInput && problemNote) {
    problemInput.value = problema;
    problemNote.textContent = problemPrefix + " " + problemMap[problema];
    problemNote.classList.remove("hidden");
  }

  // --- Web3Forms submit + success screen (§7) ---
  var form = document.getElementById("diagnostico-form");
  var success = document.getElementById("form-success");

  if (form && success) {
    form.addEventListener("submit", function (event) {
      event.preventDefault();
      var submitBtn = form.querySelector("button[type=submit]");
      if (submitBtn) submitBtn.disabled = true;

      var payload = {};
      new FormData(form).forEach(function (value, key) {
        payload[key] = value;
      });

      fetch(form.action, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(payload),
      })
        .then(function (res) {
          return res.json();
        })
        .then(function (json) {
          if (json.success) {
            var nameEl = document.getElementById("success-name");
            var nameInput = document.getElementById("nombre");
            if (nameEl && nameInput) nameEl.textContent = (nameInput.value || "").trim();
            form.classList.add("hidden");
            success.classList.remove("hidden");
            // TODO: fire Meta Pixel Lead event + Conversions API here before
            // paid campaigns (ESTRATEGIA-COPY.md §7).
            var card = document.getElementById("form-card");
            if (card) card.scrollIntoView({ behavior: "smooth", block: "start" });
          } else {
            if (submitBtn) submitBtn.disabled = false;
          }
        })
        .catch(function () {
          if (submitBtn) submitBtn.disabled = false;
        });
    });
  }
</script>

<style>
  /* Native anchor landing (before the centering script runs) also clears
     the fixed navbar instead of hiding the form header behind it. */
  #formulario,
  #form-card {
    scroll-margin-top: 5.5rem;
  }
</style>
