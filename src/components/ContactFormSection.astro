---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { ctaContent } = getContent(lang);

const eyebrow = lang === "en" ? "// DIRECT RESPONSE CHANNEL" : "// CANAL DE RESPUESTA DIRECTA";
const heading = lang === "en" ? "LET'S TALK DIRECTLY." : "HABLEMOS SIN FILTROS.";
const lead =
  lang === "en"
    ? "If you have an urgent delivery timeline or prefer talking directly with an engineer before finalizing scope, reach us through these channels:"
    : "Si tienes un requerimiento urgente o prefieres hablar directamente con un ingeniero técnico antes de definir presupuestos, estamos disponibles en estos canales:";

const whatsappLabel = lang === "en" ? "INSTANT MESSAGING" : "MENSAJERÍA INSTANTÁNEA";
const whatsappTitle = lang === "en" ? "DIRECT WHATSAPP" : "WHATSAPP DIRECTO";
const emailLabel = lang === "en" ? "ELECTRONIC MAIL" : "CORREO ELECTRÓNICO";
const turnaround =
  lang === "en"
    ? "AVERAGE RESPONSE TIME: < 2 HOURS DURING BUSINESS DAYS."
    : "TIEMPO MEDIO DE RESPUESTA: < 2 HORAS EN DÍAS HÁBILES.";

const formHeading = lang === "en" ? "SEND YOUR INQUIRY" : "ENVÍA TU CONSULTA";
const formSubheading =
  lang === "en"
    ? "FILL OUT THE FORM AND WE'LL GET BACK TO YOU WITH A TECHNICAL PROPOSAL."
    : "COMPLETA EL FORMULARIO Y TE CONTACTAREMOS CON UNA PROPUESTA TÉCNICA.";

const nameLabel = lang === "en" ? "NAME & COMPANY *" : "NOMBRE Y APELLIDO / EMPRESA *";
const namePlaceholder = lang === "en" ? "e.g. Alex Rivera - Apex Labs" : "Ej: Marcos Rossi - Apex Solutions";
const emailFieldLabel = lang === "en" ? "EMAIL ADDRESS *" : "CORREO ELECTRÓNICO *";
const projectTypeLabel = lang === "en" ? "PROJECT TYPE" : "TIPO DE PROYECTO";
const messageLabel = lang === "en" ? "PROJECT SCOPE & GOALS *" : "DESCRIPCIÓN DEL REQUERIMIENTO *";
const messagePlaceholder =
  lang === "en"
    ? "Briefly describe what you need to build, estimated timelines, or current performance bottlenecks..."
    : "Cuéntanos brevemente qué necesitas construir, plazos estimados o desafíos actuales...";
const submitBtnText = lang === "en" ? "SEND INQUIRY" : "ENVIAR MENSAJE";
---

<section id="formulario" class="bg-black text-white py-20 px-4 md:px-12 border-b-2 border-black">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Direct Info & Rapid Channels -->
      <div class="lg:col-span-5 flex flex-col justify-between h-full">
        <div>
          <span class="font-mono-meta text-xs uppercase text-[#FF4D00] font-bold tracking-widest block mb-2">
            {eyebrow}
          </span>
          <h2 class="font-display text-4xl sm:text-5xl text-white uppercase tracking-[-0.04em] leading-[0.9] mb-6">
            {heading}
          </h2>
          <p class="font-sans text-base text-white/75 leading-relaxed mb-8">
            {lead}
          </p>

          <!-- Rapid Action Cards -->
          <div class="flex flex-col gap-4 mb-8">
            <a
              href={ctaContent.buttonHref}
              target="_blank"
              rel="noopener noreferrer"
              class="border-2 border-white/20 p-5 flex items-center justify-between hover:border-[#FF4D00] hover:bg-white/[0.03] transition-all group"
            >
              <div>
                <span class="font-mono-meta text-xs text-[#FF4D00] uppercase font-bold block">
                  {whatsappLabel}
                </span>
                <span class="font-display text-xl text-white uppercase tracking-tight">
                  {whatsappTitle}
                </span>
              </div>
              <div class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-[#FF4D00] group-hover:bg-[#FF4D00] group-hover:text-black transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </div>
            </a>

            <a
              href={`mailto:${ctaContent.emailLabel}`}
              class="border-2 border-white/20 p-5 flex items-center justify-between hover:border-[#FF4D00] hover:bg-white/[0.03] transition-all group"
            >
              <div>
                <span class="font-mono-meta text-xs text-[#FF4D00] uppercase font-bold block">
                  {emailLabel}
                </span>
                <span class="font-mono-meta text-sm sm:text-base text-white font-bold tracking-tight">
                  {ctaContent.emailLabel}
                </span>
              </div>
              <div class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-[#FF4D00] group-hover:bg-[#FF4D00] group-hover:text-black transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </div>
            </a>
          </div>
        </div>

        <div class="font-mono-meta text-xs text-white/50 border-t border-white/10 pt-4">
          {turnaround}
        </div>
      </div>

      <!-- Right Column: Interactive Form -->
      <div class="lg:col-span-7 bg-[#FF4D00] text-black p-8 sm:p-12 border-2 border-black shadow-[12px_12px_0_#FFFFFF]">
        <h3 class="font-display text-2xl sm:text-3xl text-black uppercase tracking-tight mb-2">
          {formHeading}
        </h3>
        <p class="font-mono-meta text-xs text-black/80 uppercase font-bold mb-8">
          {formSubheading}
        </p>

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="flex flex-col gap-6"
        >
          <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <!-- Name -->
          <div class="flex flex-col gap-2">
            <label for="name" class="font-mono-meta text-xs font-bold uppercase tracking-wider text-black">
              {nameLabel}
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder={namePlaceholder}
              class="w-full bg-black text-white font-mono-meta text-sm p-4 border-2 border-black focus:outline-none focus:ring-2 focus:ring-white placeholder:text-white/40"
            />
          </div>

          <!-- Email -->
          <div class="flex flex-col gap-2">
            <label for="email" class="font-mono-meta text-xs font-bold uppercase tracking-wider text-black">
              {emailFieldLabel}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="contact@company.com"
              class="w-full bg-black text-white font-mono-meta text-sm p-4 border-2 border-black focus:outline-none focus:ring-2 focus:ring-white placeholder:text-white/40"
            />
          </div>

          <!-- Project Type -->
          <div class="flex flex-col gap-2">
            <label for="project_type" class="font-mono-meta text-xs font-bold uppercase tracking-wider text-black">
              {projectTypeLabel}
            </label>
            <select
              id="project_type"
              name="project_type"
              class="w-full bg-black text-white font-mono-meta text-sm p-4 border-2 border-black focus:outline-none focus:ring-2 focus:ring-white"
            >
              {lang === "en" ? (
                <>
                  <option value="landing">HIGH-IMPACT LANDING PAGE</option>
                  <option value="saas">FULL-STACK APP / SAAS PLATFORM</option>
                  <option value="erp">CUSTOM SYSTEM / INTERNAL ERP</option>
                  <option value="optimization">AUDIT & PERFORMANCE OPTIMIZATION</option>
                  <option value="other">OTHER INQUIRY</option>
                </>
              ) : (
                <>
                  <option value="landing">LANDING PAGE DE ALTO IMPACTO</option>
                  <option value="saas">APLICACIÓN FULL-STACK / SAAS</option>
                  <option value="erp">SISTEMA A MEDIDA / ERP INTERNO</option>
                  <option value="optimization">AUDITORÍA Y OPTIMIZACIÓN WEB</option>
                  <option value="other">OTRO REQUERIMIENTO</option>
                </>
              )}
            </select>
          </div>

          <!-- Message -->
          <div class="flex flex-col gap-2">
            <label for="message" class="font-mono-meta text-xs font-bold uppercase tracking-wider text-black">
              {messageLabel}
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder={messagePlaceholder}
              class="w-full bg-black text-white font-sans text-sm p-4 border-2 border-black focus:outline-none focus:ring-2 focus:ring-white placeholder:text-white/40"
            ></textarea>
          </div>

          <!-- Submit Button (stays black on hover) -->
          <button
            type="submit"
            class="w-full bg-black text-white font-mono-meta text-sm sm:text-base font-bold uppercase p-5 rounded-full border-2 border-black hover:bg-black hover:text-[#FF4D00] hover:border-black transition-all hover:scale-[1.02] shadow-lg flex items-center justify-center gap-3 cursor-pointer mt-2"
          >
            <span>{submitBtnText}</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </form>
      </div>

    </div>
  </div>
</section>
