---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { ctaContent, socialLinks } = getContent(lang);

// Rapid action channels: email, Instagram, LinkedIn. Direct WhatsApp
// contact was retired site-wide (user rule 2026-11-11): messaging
// outreach only happens through the optional phone field in the form.
const instagramLink = socialLinks.find((s) => s.platform === "instagram");
const linkedinLink = socialLinks.find((s) => s.platform === "linkedin");
const instagramHandle = "DEFTCODE.AR";
const linkedinName = "DEFTCODE";

const eyebrow = lang === "en" ? "// DIRECT RESPONSE CHANNEL" : "// CANAL DE RESPUESTA DIRECTA";
const heading = lang === "en" ? "LET'S TALK DIRECTLY." : "HABLEMOS SIN FILTROS.";
const lead =
  lang === "en"
    ? "If you have an urgent delivery timeline or prefer talking directly with an engineer before finalizing scope, reach us through these channels:"
    : "Si tienes un requerimiento urgente o prefieres hablar directamente con un ingeniero técnico antes de definir presupuestos, estamos disponibles en estos canales:";

const emailLabel = lang === "en" ? "ELECTRONIC MAIL" : "CORREO ELECTRÓNICO";
const turnaround =
  lang === "en"
    ? "AVERAGE RESPONSE TIME: < 24 HOURS DURING BUSINESS DAYS."
    : "TIEMPO MEDIO DE RESPUESTA: < 24 HORAS EN DÍAS HÁBILES.";

const formHeading = lang === "en" ? "SEND YOUR INQUIRY" : "ENVÍA TU CONSULTA";
const formSubheading =
  lang === "en"
    ? "FILL OUT THE FORM AND WE'LL GET BACK TO YOU WITH A TECHNICAL PROPOSAL."
    : "COMPLETA EL FORMULARIO Y TE CONTACTAREMOS CON UNA PROPUESTA TÉCNICA.";

const nameLabel = lang === "en" ? "NAME & COMPANY *" : "NOMBRE Y APELLIDO / EMPRESA *";
const namePlaceholder = lang === "en" ? "e.g. Alex Rivera - Apex Labs" : "Ej: Marcos Rossi - Apex Solutions";
const emailFieldLabel = lang === "en" ? "EMAIL ADDRESS *" : "CORREO ELECTRÓNICO *";
const projectTypeLabel = lang === "en" ? "PROJECT TYPE" : "TIPO DE PROYECTO";
const projectTypePlaceholder = lang === "en" ? "SELECT AN OPTION" : "ELEGÍ UNA OPCIÓN";
const projectTypeOptions: { value: string; label: string }[] = lang === "en"
  ? [
      { value: "landing", label: "HIGH-IMPACT LANDING PAGE" },
      { value: "saas", label: "FULL-STACK APP / SAAS PLATFORM" },
      { value: "erp", label: "CUSTOM SYSTEM / INTERNAL ERP" },
      { value: "optimization", label: "AUDIT & PERFORMANCE OPTIMIZATION" },
      { value: "other", label: "OTHER INQUIRY" },
    ]
  : [
      { value: "landing", label: "LANDING PAGE DE ALTO IMPACTO" },
      { value: "saas", label: "APLICACIÓN FULL-STACK / SAAS" },
      { value: "erp", label: "SISTEMA A MEDIDA / ERP INTERNO" },
      { value: "optimization", label: "AUDITORÍA Y OPTIMIZACIÓN WEB" },
      { value: "other", label: "OTRO REQUERIMIENTO" },
    ];
const phoneLabel = lang === "en" ? "PHONE (OPTIONAL)" : "TELÉFONO (OPCIONAL)";
const phonePlaceholder = lang === "en" ? "+1 555 000 0000" : "+54 9 ...";
const phoneHint =
  lang === "en"
    ? "LEAVE IT AND WE'LL REACH OUT VIA WHATSAPP."
    : "SI LO DEJÁS, TE CONTACTAMOS POR WHATSAPP.";
const messageLabel = lang === "en" ? "PROJECT SCOPE & GOALS *" : "DESCRIPCIÓN DEL REQUERIMIENTO *";
const messagePlaceholder =
  lang === "en"
    ? "Briefly describe what you need to build, estimated timelines, or current performance bottlenecks..."
    : "Cuéntanos brevemente qué necesitas construir, plazos estimados o desafíos actuales...";
const submitBtnText = lang === "en" ? "SEND INQUIRY" : "ENVIAR MENSAJE";
---

<section id="formulario" class="relative bg-black text-white py-20 px-4 md:px-12 rule-page-bottom">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Direct Info & Rapid Channels -->
      <div class="lg:col-span-5 flex flex-col justify-between h-full">
        <div>
          <span class="font-mono-meta text-xs uppercase text-[#FF4D00] font-bold tracking-widest block mb-2">
            {eyebrow}
          </span>
          <h2 class="reveal font-display text-4xl sm:text-5xl text-white uppercase tracking-[-0.04em] leading-[0.9] mb-6">
            {heading}
          </h2>
          <p class="font-sans text-base text-white/75 leading-relaxed mb-8">
            {lead}
          </p>

          <!-- Rapid Action Cards: email, Instagram, LinkedIn (no direct
               WhatsApp contact anywhere on the site) -->
          <div class="flex flex-col gap-4 mb-8">
            <a
              href={`mailto:${ctaContent.emailLabel}`}
              class="border-2 border-white/20 p-5 flex items-center justify-between hover:border-[#FF4D00] hover:bg-white/[0.03] transition-all group"
            >
              <div>
                <span class="font-mono-meta text-xs text-[#FF4D00] uppercase font-bold block">
                  {emailLabel}
                </span>
                <span class="font-mono-meta text-sm sm:text-base text-white font-bold tracking-tight">
                  {ctaContent.emailLabel}
                </span>
              </div>
              <div class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-[#FF4D00] group-hover:bg-[#FF4D00] group-hover:text-black transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </div>
            </a>

            {instagramLink && (
              <a
                href={instagramLink.href}
                target="_blank"
                rel="noopener noreferrer"
                class="border-2 border-white/20 p-5 flex items-center justify-between hover:border-[#FF4D00] hover:bg-white/[0.03] transition-all group"
              >
                <div>
                  <span class="font-mono-meta text-xs text-[#FF4D00] uppercase font-bold block">
                    {instagramLink.label}
                  </span>
                  <span class="font-display text-xl text-white uppercase tracking-tight">
                    {instagramHandle}
                  </span>
                </div>
                <div class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-[#FF4D00] group-hover:bg-[#FF4D00] group-hover:text-black transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                    <circle cx="12" cy="12" r="4.5"></circle>
                    <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"></circle>
                  </svg>
                </div>
              </a>
            )}

            {linkedinLink && (
              <a
                href={linkedinLink.href}
                target="_blank"
                rel="noopener noreferrer"
                class="border-2 border-white/20 p-5 flex items-center justify-between hover:border-[#FF4D00] hover:bg-white/[0.03] transition-all group"
              >
                <div>
                  <span class="font-mono-meta text-xs text-[#FF4D00] uppercase font-bold block">
                    {linkedinLink.label}
                  </span>
                  <span class="font-display text-xl text-white uppercase tracking-tight">
                    {linkedinName}
                  </span>
                </div>
                <div class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-[#FF4D00] group-hover:bg-[#FF4D00] group-hover:text-black transition-colors">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"></path>
                  </svg>
                </div>
              </a>
            )}
          </div>
        </div>

        <div class="font-mono-meta text-xs text-white/50 border-t border-white/10 pt-4">
          {turnaround}
        </div>
      </div>

      <!-- Right Column: Interactive Form -->
      <div id="formulario-card" class="lg:col-span-7 bg-[#FF4D00] text-black p-8 sm:p-12 border-2 border-black shadow-[12px_12px_0_#FF4D00]">
        <h3 class="font-display text-2xl sm:text-3xl text-black uppercase tracking-tight mb-2">
          {formHeading}
        </h3>
        <p class="font-mono-meta text-xs text-black/80 uppercase font-bold mb-8">
          {formSubheading}
        </p>

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="flex flex-col gap-6"
        >
          <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <!-- Name -->
          <div class="flex flex-col gap-2">
            <label for="name" class="font-mono-meta text-xs font-bold uppercase tracking-wider text-black">
              {nameLabel}
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder={namePlaceholder}
              class="w-full bg-black text-white font-mono-meta text-sm p-4 border-2 border-black focus:outline-none focus:ring-1 focus:ring-white placeholder:text-white/40"
            />
          </div>

          <!-- Email -->
          <div class="flex flex-col gap-2">
            <label for="email" class="font-mono-meta text-xs font-bold uppercase tracking-wider text-black">
              {emailFieldLabel}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="contact@company.com"
              class="w-full bg-black text-white font-mono-meta text-sm p-4 border-2 border-black focus:outline-none focus:ring-1 focus:ring-white placeholder:text-white/40"
            />
          </div>

          <!-- Phone (optional): the only WhatsApp touchpoint on the site -->
          <div class="flex flex-col gap-2">
            <label for="phone" class="font-mono-meta text-xs font-bold uppercase tracking-wider text-black">
              {phoneLabel}
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder={phonePlaceholder}
              class="w-full bg-black text-white font-mono-meta text-sm p-4 border-2 border-black focus:outline-none focus:ring-1 focus:ring-white placeholder:text-white/40"
            />
            <p class="font-mono-meta text-[11px] text-black/70 uppercase font-bold tracking-wider m-0">
              {phoneHint}
            </p>
          </div>

          <!-- Project Type: custom listbox. The native select popup can't
               be themed to the site palette (white/blue OS chrome); options
               sit 2px apart and the panel opens 2px below the trigger so
               the 1px white focus ring never gets covered. -->
          <div class="flex flex-col gap-2">
            <span id="project_type_label" class="font-mono-meta text-xs font-bold uppercase tracking-wider text-black">
              {projectTypeLabel}
            </span>
            <div class="relative" data-project-select>
              <button
                type="button"
                class="w-full bg-black text-white font-mono-meta text-sm p-4 border-2 border-black focus:outline-none focus:ring-1 focus:ring-white flex items-center justify-between gap-3 text-left"
                data-select-trigger
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-labelledby="project_type_label"
              >
                <span data-select-value class="text-white/40">{projectTypePlaceholder}</span>
                <svg
                  data-select-chevron
                  class="w-4 h-4 shrink-0 text-[#FF4D00] transition-transform duration-200"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path stroke-linecap="square" stroke-linejoin="miter" d="M6 9l6 6 6-6"></path>
                </svg>
              </button>
              <input type="hidden" name="project_type" data-select-input />
              <ul
                role="listbox"
                aria-labelledby="project_type_label"
                data-select-panel
                class="hidden absolute left-0 right-0 top-[calc(100%+2px)] z-20 max-h-72 overflow-y-auto bg-black border-2 border-white/20 shadow-[0_16px_40px_rgba(0,0,0,0.5)] p-0.5 m-0 flex-col gap-0.5 list-none"
              >
                {projectTypeOptions.map((option) => (
                  <li
                    role="option"
                    aria-selected="false"
                    data-value={option.value}
                    tabindex="-1"
                    class="font-mono-meta text-sm p-4 bg-black text-white hover:bg-[#FF4D00] hover:text-black focus:outline-none focus:bg-[#FF4D00] focus:text-black cursor-pointer"
                  >
                    {option.label}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Message -->
          <div class="flex flex-col gap-2">
            <label for="message" class="font-mono-meta text-xs font-bold uppercase tracking-wider text-black">
              {messageLabel}
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder={messagePlaceholder}
              class="w-full bg-black text-white font-sans text-sm p-4 border-2 border-black focus:outline-none focus:ring-1 focus:ring-white placeholder:text-white/40"
            ></textarea>
          </div>

          <!-- Submit Button (stays black on hover) -->
          <button
            type="submit"
            class="w-full bg-black text-white font-mono-meta text-sm sm:text-base font-bold uppercase p-5 rounded-full border-2 border-black hover:bg-black hover:text-[#FF4D00] hover:border-black transition-all hover:scale-[1.02] shadow-lg flex items-center justify-center gap-3 cursor-pointer mt-2"
          >
            <span>{submitBtnText}</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  // --- Entry scroll: center the form card on every /contacto/ arrival ---
  const formCard = document.getElementById("formulario-card");

  if (formCard) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const centerFormCard = () => {
      const viewportH = window.innerHeight;
      const rect = formCard.getBoundingClientRect();
      const cardTop = window.scrollY + rect.top;
      const slack = viewportH - rect.height;
      // Enough slack: perfect vertical centering. Tight fit (the fixed
      // navbar would cover the heading): pin the top with air instead.
      const target = slack >= 90 ? cardTop - slack / 2 : cardTop - 64;
      window.scrollTo({
        top: Math.max(0, Math.round(target)),
        behavior: reduceMotion ? "auto" : "smooth",
      });
    };

    // Fonts change card metrics: wait for them, then scroll once.
    document.fonts.ready.then(() => requestAnimationFrame(centerFormCard));
  }

  // --- Custom project-type listbox (black/white/orange only) ---
  const projectSelect = document.querySelector("[data-project-select]");

  if (projectSelect) {
    const trigger = projectSelect.querySelector<HTMLButtonElement>("[data-select-trigger]");
    const valueLabel = projectSelect.querySelector<HTMLElement>("[data-select-value]");
    const chevron = projectSelect.querySelector<SVGElement>("[data-select-chevron]");
    const panel = projectSelect.querySelector<HTMLUListElement>("[data-select-panel]");
    const hiddenInput = projectSelect.querySelector<HTMLInputElement>("[data-select-input]");
    const optionItems = Array.from(projectSelect.querySelectorAll<HTMLElement>('[role="option"]'));

    if (trigger && valueLabel && chevron && panel && hiddenInput && optionItems.length > 0) {
      let isOpen = false;

      const setOpen = (next: boolean) => {
        isOpen = next;
        panel.classList.toggle("hidden", !isOpen);
        panel.classList.toggle("flex", isOpen);
        trigger.setAttribute("aria-expanded", String(isOpen));
        chevron.classList.toggle("rotate-180", isOpen);
      };

      const selectOption = (option: HTMLElement) => {
        hiddenInput.value = option.dataset.value ?? "";
        valueLabel.textContent = option.textContent?.trim() ?? "";
        valueLabel.classList.remove("text-white/40");
        optionItems.forEach((o) => o.setAttribute("aria-selected", String(o === option)));
        setOpen(false);
        trigger.focus();
      };

      const moveFocus = (current: HTMLElement, delta: number) => {
        const index = optionItems.indexOf(current);
        const next = optionItems[Math.min(optionItems.length - 1, Math.max(0, index + delta))];
        next?.focus();
        next?.scrollIntoView({ block: "nearest" });
      };

      trigger.addEventListener("click", () => {
        setOpen(!isOpen);
        if (isOpen) {
          const selected = optionItems.find((o) => o.getAttribute("aria-selected") === "true");
          (selected ?? optionItems[0])?.focus();
        }
      });

      panel.addEventListener("click", (event) => {
        const option = (event.target as HTMLElement).closest('[role="option"]');
        if (option instanceof HTMLElement) selectOption(option);
      });

      panel.addEventListener("keydown", (event) => {
        const current = document.activeElement;
        if (!(current instanceof HTMLElement) || !optionItems.includes(current)) return;
        if (event.key === "ArrowDown") {
          event.preventDefault();
          moveFocus(current, 1);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          moveFocus(current, -1);
        } else if (event.key === "Home") {
          event.preventDefault();
          optionItems[0]?.focus();
        } else if (event.key === "End") {
          event.preventDefault();
          optionItems[optionItems.length - 1]?.focus();
        } else if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          selectOption(current);
        } else if (event.key === "Escape") {
          event.preventDefault();
          setOpen(false);
          trigger.focus();
        } else if (event.key === "Tab") {
          setOpen(false);
        }
      });

      document.addEventListener("click", (event) => {
        if (isOpen && event.target instanceof Node && !projectSelect.contains(event.target)) {
          setOpen(false);
        }
      });
    }
  }
</script>
