---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { howWeWork } = getContent(lang);

const eyebrow = lang === "en" ? "// PROCESS & METHODOLOGY" : "// PROCESO & METODOLOGÍA";
const title = lang === "en" ? "HOW WE SHIP" : "CÓMO TRABAJAMOS";
const intro =
  lang === "en"
    ? "FROM INITIAL DISCOVERY TO CONTINUOUS DEPLOYMENT IN 4 PRECISE PHASES."
    : "DE LA IDEA AL DESPLIEGUE CONTINUO EN 4 ETAPAS PRECISAS.";
---

<section class="relative bg-[#FF4D00] text-black py-20 px-4 md:px-12 rule-page-bottom">
  <div class="max-w-7xl mx-auto">
    <div class="border-b-2 border-black pb-8 mb-12 flex flex-col sm:flex-row justify-between sm:items-end gap-4">
      <div>
        <span class="font-mono-meta text-xs uppercase text-black font-bold tracking-widest block mb-2">
          {eyebrow}
        </span>
        <h2 class="reveal font-display text-4xl sm:text-5xl text-black uppercase tracking-[-0.04em] leading-[0.9]">
          {title}
        </h2>
      </div>
      <p class="font-mono-meta text-xs sm:text-sm text-black/80 max-w-sm sm:text-right font-medium">
        {intro}
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        howWeWork.map((step) => (
          <article class="bg-black text-white p-6 md:p-8 border-2 border-black flex flex-col justify-between shadow-[8px_8px_0_#000000] hover:translate-x-[-2px] hover:translate-y-[-2px] transition-transform">
            <div>
              <div class="flex items-center justify-between border-b border-white/20 pb-3 mb-6">
                <span class="font-mono-meta text-2xl font-bold text-[#FF4D00]">
                  [{step.step}]
                </span>
                <span class="w-2 h-2 bg-[#FF4D00]"></span>
              </div>
              <h3 class="font-display text-xl md:text-2xl text-white uppercase tracking-[-0.03em] leading-tight mb-3">
                {step.title}
              </h3>
            </div>
            <p class="font-sans text-xs sm:text-sm text-white/70 leading-relaxed mt-4">
              {step.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
