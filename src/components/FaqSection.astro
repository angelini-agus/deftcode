---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const content = getContent(lang);
const { pricing, faqList } = content;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqList.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const faqTitle = lang === "en" ? "FREQUENTLY ASKED QUESTIONS" : "PREGUNTAS FRECUENTES";
---

<!-- Pricing reference table (§3.11): its own section, always rendered
     before the FAQ by this component (home, /contacto and EN mirrors).
     Unresolved figures stay as [COMPLETAR] literals per the placeholder
     discipline. -->
<section id="precios" class="relative bg-[#FF4D00] text-black py-20 px-4 md:px-12">
  <div class="max-w-7xl mx-auto">
    <div class="border-b-2 border-black pb-8 mb-12">
      <h2 data-fit-title class="reveal font-display text-4xl sm:text-5xl text-black uppercase tracking-[-0.04em] leading-[0.9]">
        {pricing.title}
      </h2>
    </div>

    <div class="reveal border-2 border-black bg-black text-white shadow-[8px_8px_0_#000000]">
      <table class="w-full table-fixed text-left border-collapse">
        <thead>
          <tr class="border-b-2 border-white/20">
            <th scope="col" class="font-mono-meta text-[10px] sm:text-[11px] uppercase text-[#FF4D00] font-bold tracking-widest px-3 sm:px-6 py-4 w-[32%] sm:w-auto">
              {pricing.whatHeading}
            </th>
            <th scope="col" class="font-mono-meta text-[10px] sm:text-[11px] uppercase text-[#FF4D00] font-bold tracking-widest px-3 sm:px-6 py-4 w-[38%] sm:w-auto">
              {pricing.priceHeading}
            </th>
            <th scope="col" class="font-mono-meta text-[10px] sm:text-[11px] uppercase text-[#FF4D00] font-bold tracking-widest px-3 sm:px-6 py-4 w-[30%] sm:w-auto">
              {pricing.timeframeHeading}
            </th>
          </tr>
        </thead>
        <tbody>
          {
            pricing.rows.map((row) => (
              <tr class="border-b border-white/10 last:border-b-0">
                <td class="font-sans text-xs sm:text-base font-bold px-3 sm:px-6 py-4 wrap-anywhere">{row.what}</td>
                <td class="font-mono-meta text-[11px] sm:text-sm text-[#FF4D00] font-bold px-3 sm:px-6 py-4 wrap-anywhere">{row.price}</td>
                <td class="font-mono-meta text-[10px] sm:text-xs text-white/80 uppercase px-3 sm:px-6 py-4 wrap-anywhere">{row.timeframe}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="font-mono-meta text-[11px] text-black/70 uppercase tracking-wide mt-6 mb-0 text-center">
      {pricing.footnote}
    </p>
  </div>
</section>

<section id="faq" class="relative bg-black text-white py-20 px-4 md:px-12">
  <!-- Schema.org FAQPage Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-7xl mx-auto">
    <div class="border-b border-white/20 pb-8 mb-12">
      <div>
        <h2 data-fit-title class="reveal font-display text-4xl sm:text-5xl text-white uppercase tracking-[-0.04em] leading-[0.9]">
          {faqTitle}
        </h2>
      </div>
    </div>

    <!-- Accordion List -->
    <div class="divide-y divide-white/20" data-stagger="70">
      {
        faqList.map((item, index) => (
          <details class="reveal group py-6 cursor-pointer">
            <summary class="list-none flex items-center justify-between gap-4 font-display text-xl sm:text-2xl text-white uppercase tracking-tight hover:text-[#FF4D00] transition-colors focus-visible:outline-none">
              <span class="flex items-center gap-4">
                <span class="font-mono-meta text-sm text-[#FF4D00] font-bold">
                  [{String(index + 1).padStart(2, "0")}]
                </span>
                {item.question}
              </span>
              <span class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center text-[#FF4D00] group-open:rotate-45 group-open:bg-[#FF4D00] group-open:text-black transition-all duration-200 shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="square" stroke-linejoin="miter" d="M12 4v16m8-8H4"></path>
                </svg>
              </span>
            </summary>
            <div class="pt-4 pb-2 pl-12 pr-4 text-white/80 font-sans text-sm sm:text-base leading-relaxed">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
