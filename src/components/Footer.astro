---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { socialLinks } = getContent(lang);
const currentYear = new Date().getFullYear();

const privacyHref = lang === "en" ? "/en/privacy/" : "/privacidad/";
const privacyLabel = lang === "en" ? "PRIVACY" : "PRIVACIDAD";
const rightsText = lang === "en" ? "ALL RIGHTS RESERVED." : "TODOS LOS DERECHOS RESERVADOS.";
const topLabel = lang === "en" ? "TOP" : "ARRIBA";
---

<footer class="bg-black text-white border-t-2 border-black py-12 px-4 md:px-12">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <!-- Left: Brand / Copyright -->
    <div class="flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left">
      <span class="font-display text-xl text-[#FF4D00] uppercase tracking-tight">
        DEFTCODE
      </span>
      <span class="hidden sm:inline text-white/40">//</span>
      <p class="font-mono-meta text-[12px] text-white/70 uppercase tracking-tight m-0">
        © {currentYear} DEFTCODE STUDIO. {rightsText}
      </p>
    </div>

    <!-- Center / Right: Horizontal Links in Space Mono (12px) -->
    <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6">
      {
        socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono-meta text-[12px] uppercase font-bold text-white/80 hover:text-[#FF4D00] transition-colors py-1"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={privacyHref}
        class="font-mono-meta text-[12px] uppercase font-bold text-white/60 hover:text-[#FF4D00] transition-colors py-1"
      >
        {privacyLabel}
      </a>
    </div>

    <!-- Right: Back to top -->
    <div>
      <a
        href="#top"
        class="font-mono-meta text-[12px] uppercase font-bold text-[#FF4D00] hover:text-white transition-colors flex items-center gap-2"
      >
        <span>{topLabel}</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path stroke-linecap="square" stroke-linejoin="miter" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
