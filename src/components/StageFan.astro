---
/**
 * "Acompañamiento en cada etapa" — ported from the pediatric landing's
 * #acompanamiento section, rebuilt for deftcode without React:
 * desktop (≥1280px) shows an interactive card FAN with an elastic GSAP
 * entrance and hover that pushes the siblings apart; below 1280px the
 * same cards become a horizontal snap carousel with arrows.
 *
 * Copy is component-local (like ProjectsStack) so it does not touch
 * content.ts. Reduced motion: cards render fanned and static, no push.
 */
interface Props {
  lang?: Lang;
}
type Lang = "es" | "en";
const { lang = "es" } = Astro.props;

const copy = {
  es: {
    eyebrow: "// GARANTÍAS Y ACOMPAÑAMIENTO",
    title: "TE ACOMPAÑAMOS EN CADA ETAPA, CON GARANTÍAS POR ESCRITO.",
    intro:
      "No desaparecemos después de la entrega: el mismo equipo que escribe el código te acompaña en cada etapa con cada garantía firmada en el contrato.",
    cta: "QUIERO MI DIAGNÓSTICO",
    aria: "Garantías y acompañamiento en cada etapa del proyecto",
  },
  en: {
    eyebrow: "// GUARANTEES & SUPPORT",
    title: "WE'RE WITH YOU AT EVERY STAGE, WITH WRITTEN GUARANTEES.",
    intro:
      "We don't disappear after delivery: the same team that writes the code walks your system through every stage with every guarantee in the contract.",
    cta: "I WANT MY DIAGNOSIS",
    aria: "Guarantees and support at every stage of the project",
  },
}[lang];

const STAGES = [
  {
    badge: lang === "en" ? "STEP 01" : "PASO 01",
    title: lang === "en" ? "DIAGNOSIS" : "DIAGNÓSTICO",
    description:
      lang === "en"
        ? "1-hour interview + 48 h report. We understand your business and tell you where money leaks."
        : "Entrevista de 1 hora + informe en 48 h. Entendemos tu negocio y te decimos dónde se te va la plata.",
  },
  {
    badge: lang === "en" ? "STEP 02" : "PASO 02",
    title: lang === "en" ? "FREE PROTOTYPE" : "PROTOTIPO GRATIS",
    description:
      lang === "en"
        ? "You see a working mockup with your data before signing. If you don't like it, you don't pay."
        : "Ves una maqueta funcional con tus datos antes de firmar. Si no te convence, no pagás.",
  },
  {
    badge: lang === "en" ? "GUARANTEE" : "GARANTÍA",
    title: lang === "en" ? "CLOSED PRICE" : "PRECIO CERRADO",
    description:
      lang === "en"
        ? "Fixed budget from day one: an upfront deposit to start and the balance on validated production delivery."
        : "Presupuesto fijo desde el día uno: un anticipo al iniciar y el saldo contra entrega validada en producción.",
  },
  {
    badge: lang === "en" ? "STEP 03" : "PASO 03",
    title: lang === "en" ? "DEVELOPMENT" : "DESARROLLO",
    description:
      lang === "en"
        ? "Weekly visible progress on a test environment. You weigh in while it gets built."
        : "Avances semanales visibles en un entorno de prueba. Vos opinás mientras se construye.",
  },
  {
    badge: lang === "en" ? "STEP 04" : "PASO 04",
    title: lang === "en" ? "LAUNCH" : "LANZAMIENTO",
    description:
      lang === "en"
        ? "Production with documentation and training for your team, on the exact date written in the contract."
        : "Salimos a producción en la fecha firmada por contrato, con documentación y capacitación para tu equipo.",
  },
  {
    badge: lang === "en" ? "GUARANTEE" : "GARANTÍA",
    title: lang === "en" ? "FREE BUG FIXES" : "ERRORES SIN CARGO",
    description:
      lang === "en"
        ? "If a bug appears after launch, we fix it for free. Plus, the code is 100% yours."
        : "Si encontrás un error después del lanzamiento, lo arreglamos gratis. Además el código es 100% tuyo.",
  },
  {
    badge: lang === "en" ? "STEP 05" : "PASO 05",
    title: lang === "en" ? "SUPPORT" : "SOPORTE",
    description:
      lang === "en"
        ? "Monthly maintenance with development hours for whatever comes after launch."
        : "Mantenimiento mensual con horas de desarrollo para los cambios que vengan después.",
  },
];

/* Symmetric fan transforms (mirrors the React Bits BounceCards setup). */
const FAN = [
  { x: -450, rotate: -9 },
  { x: -300, rotate: -6 },
  { x: -150, rotate: -3 },
  { x: 0, rotate: 0 },
  { x: 150, rotate: 3 },
  { x: 300, rotate: 6 },
  { x: 450, rotate: 9 },
];
---

<section
  id="acompanamiento"
  class="stage-fan relative overflow-hidden bg-[#FF4D00] text-black py-16 md:py-20 px-4 md:px-12 scroll-mt-16"
  aria-label={copy.aria}
  data-stage-fan
>
  <div class="relative z-10 mx-auto max-w-7xl">
    <!-- Header: standard section header matching Inicio/Servicios -->
    <div class="border-b-2 border-black pb-8 mb-12">
      <span class="reveal font-mono-meta text-xs uppercase text-black font-bold tracking-widest block mb-2">
        {copy.eyebrow}
      </span>
      <h2 data-fit-title class="reveal font-display text-4xl sm:text-5xl lg:text-6xl uppercase tracking-[-0.04em] leading-[0.88] text-black m-0">
        {copy.title}
      </h2>
    </div>

    <!-- Card fan (≥1280px) -->
    <div class="stage-fan__fan mt-14 hidden xl:flex justify-center">
      <div class="stage-fan__stage relative" style="width: min(1200px, 100%); height: 480px;">
        {
          STAGES.map((stage, i) => (
            <article
              class="stage-fan__card"
              data-fan-card={i}
              style={`z-index: ${i + 1};`}
            >
              <div class="stage-fan__pos">
                <div class="stage-fan__pop group/card flex h-full w-full flex-col justify-between p-6 text-left bg-black text-white border-2 border-black shadow-[8px_8px_0_#000000]">
                  <div>
                    <div class="flex items-center justify-between border-b border-white/20 pb-3 mb-6">
                      <span class="font-mono-meta text-lg font-bold text-[#FF4D00]">
                        [{stage.badge}]
                      </span>
                      <span class="w-2 h-2 bg-[#FF4D00] shrink-0"></span>
                    </div>
                    <h3 data-decode-skip class="font-display text-xl md:text-2xl uppercase tracking-[-0.03em] leading-tight mb-3 text-white m-0 origin-left transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/card:scale-[1.06] motion-reduce:transition-none motion-reduce:group-hover/card:scale-100">
                      {stage.title}
                    </h3>
                    <p class="font-sans text-xs sm:text-sm leading-relaxed text-white/70 mt-4 m-0">
                      {stage.description}
                    </p>
                  </div>
                  <a
                    href={lang === "en" ? "/en/contact/#formulario" : "/contacto/#formulario"}
                    class="group mt-6 self-center inline-flex items-center gap-2 bg-white text-black font-mono-meta text-[11px] font-bold uppercase tracking-wider px-5 py-2.5 rounded-full border-2 border-black hover:scale-105 transition-transform duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
                  >
                    <span>{copy.cta}</span>
                    <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                      <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Carousel (<1280px) -->
    <div class="relative mt-12 xl:hidden">
      <div
        class="hidden md:flex absolute -left-4 top-1/2 -translate-y-1/2 z-20"
        aria-hidden="true"
      >
        <button
          type="button"
          data-fan-prev
          class="flex h-12 w-12 items-center justify-center rounded-full bg-black text-white shadow-lg transition-all hover:scale-105 active:scale-95"
          aria-label={lang === "en" ? "Previous stages" : "Etapas anteriores"}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="square" stroke-linejoin="miter" d="M15 5l-7 7 7 7" />
          </svg>
        </button>
      </div>
      <div
        class="hidden md:flex absolute -right-4 top-1/2 -translate-y-1/2 z-20"
        aria-hidden="true"
      >
        <button
          type="button"
          data-fan-next
          class="flex h-12 w-12 items-center justify-center rounded-full bg-black text-white shadow-lg transition-all hover:scale-105 active:scale-95"
          aria-label={lang === "en" ? "Next stages" : "Siguientes etapas"}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="square" stroke-linejoin="miter" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <div
        data-fan-track
        class="grid grid-cols-1 gap-6 pr-2 pb-4 sm:flex sm:gap-6 sm:overflow-x-auto sm:pt-3 sm:pr-3 sm:pb-12 sm:snap-x sm:snap-mandatory scroll-smooth"
        style="scrollbar-width: none;"
      >
        {
          STAGES.map((stage) => (
            <article
              data-fan-slide
              class="group/card relative flex w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] shrink-0 snap-start flex-col justify-between p-6 md:p-8 text-left bg-black text-white border-2 border-black shadow-[8px_8px_0_#000000] hover:translate-x-[-2px] hover:translate-y-[-2px] transition-transform"
            >
              <div>
                <div class="flex items-center justify-between border-b border-white/20 pb-3 mb-6">
                  <span class="font-mono-meta text-lg sm:text-xl font-bold text-[#FF4D00]">
                    [{stage.badge}]
                  </span>
                  <span class="w-2 h-2 bg-[#FF4D00] shrink-0"></span>
                </div>
                <h3 data-decode-skip class="font-display text-xl md:text-2xl uppercase tracking-[-0.03em] leading-tight mb-3 text-white m-0 origin-left transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/card:scale-[1.06] motion-reduce:transition-none motion-reduce:group-hover/card:scale-100">
                  {stage.title}
                </h3>
              </div>
              <p class="font-sans text-xs sm:text-sm leading-relaxed mt-4 text-white/70 mb-0">
                {stage.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .stage-fan__card {
    position: absolute;
    left: 50%;
    top: 0;
    width: 300px;
    height: 440px;
    margin-left: -150px;
  }
  .stage-fan__pos {
    width: 100%;
    height: 100%;
    /* Hover push & lift ride on this layer: JS swaps --push and scale. */
    transform: translateX(var(--push, 0px));
    transition:
      transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      scale 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .stage-fan__pop {
    position: relative;
    overflow: hidden;
  }
  .stage-fan__track::-webkit-scrollbar,
  [data-fan-track]::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  import gsap from "gsap";

  const section = document.querySelector<HTMLElement>("[data-stage-fan]");
  // Only the OS reduced-motion preference disables the scroll-triggered
  // fan. `preload-skip` / `motion-static` mean "internal navigation, skip
  // the page-load intro" — they must not kill section animations that play
  // on scroll, or the cards arrive already frozen when you click to here.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (section) {
    const cards = Array.from(section.querySelectorAll<HTMLElement>("[data-fan-card]"));
    const FAN = [
      { x: -450, rotate: -9 },
      { x: -300, rotate: -6 },
      { x: -150, rotate: -3 },
      { x: 0, rotate: 0 },
      { x: 150, rotate: 3 },
      { x: 300, rotate: 6 },
      { x: 450, rotate: 9 },
    ];

    // Hover push: the hovered card lifts, siblings are pushed away by an
    // offset that falls off with distance (adjacent gets the full push).
    const applyPush = (hovered: number | null) => {
      cards.forEach((card, i) => {
        const pos = card.querySelector<HTMLElement>(".stage-fan__pos");
        if (!pos) return;
        if (hovered === null) {
          pos.style.setProperty("--push", "0px");
          pos.style.scale = "1";
          card.style.zIndex = String(i + 1);
          return;
        }
        if (i === hovered) {
          pos.style.setProperty("--push", "0px");
          pos.style.scale = "1.06";
          card.style.zIndex = "30";
        } else {
          const dir = i < hovered ? -1 : 1;
          const dist = Math.abs(i - hovered);
          pos.style.setProperty("--push", `${dir * (90 / dist)}px`);
          pos.style.scale = "1";
          card.style.zIndex = String(i + 1);
        }
      });
    };

    cards.forEach((card, i) => {
      card.addEventListener("mouseenter", () => applyPush(i));
      card.addEventListener("mouseleave", () => applyPush(null));
    });

    // Carousel arrows (<1280px).
    const track = section.querySelector<HTMLElement>("[data-fan-track]");
    const prev = section.querySelector<HTMLElement>("[data-fan-prev]");
    const next = section.querySelector<HTMLElement>("[data-fan-next]");
    const scrollCards = (dir: 1 | -1) => {
      if (!track) return;
      const card = track.querySelector<HTMLElement>("[data-fan-slide]");
      const stepW = card ? card.offsetWidth + 24 : 300;
      track.scrollBy({ left: dir * stepW, behavior: "smooth" });
    };
    prev?.addEventListener("click", () => scrollCards(-1));
    next?.addEventListener("click", () => scrollCards(1));

    // Elastic entrance: cards start stacked small at the center and bounce
    // out to their fan positions (elastic.out 1.1s, stagger 0.07) — the
    // port of React Bits BounceCards. Runs once, on scroll into view.
    if (!reduceMotion && cards.length > 0) {
      gsap.set(cards, { x: 0, rotation: 0, scale: 0.3, opacity: 0 });
      const play = () => {
        cards.forEach((card, i) => {
          gsap.to(card, {
            x: FAN[i].x,
            rotation: FAN[i].rotate,
            scale: 1,
            opacity: 1,
            duration: 1.1,
            ease: "elastic.out(1, 0.75)",
            delay: 0.07 * i,
          });
        });
      };
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              play();
              io.disconnect();
              break;
            }
          }
        },
        { threshold: 0.3 },
      );
      io.observe(section);
    } else if (cards.length > 0) {
      // Reduced motion: fan in place, no entrance, no push.
      cards.forEach((card, i) => {
        gsap.set(card, { x: FAN[i].x, rotation: FAN[i].rotate, scale: 1, opacity: 1 });
      });
      cards.forEach((card) => {
        card.replaceWith(card.cloneNode(true));
      });
    }
  }
</script>
