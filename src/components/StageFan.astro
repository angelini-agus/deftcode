---
/**
 * "Acompañamiento en cada etapa" — ported from the pediatric landing's
 * #acompanamiento section, rebuilt for deftcode without React:
 * desktop (≥1280px) shows an interactive card FAN with an elastic GSAP
 * entrance and hover that pushes the siblings apart; below 1280px the
 * same cards become a horizontal snap carousel with arrows.
 *
 * Copy is component-local (like ProjectsStack) so it does not touch
 * content.ts. Reduced motion: cards render fanned and static, no push.
 */
interface Props {
  lang?: Lang;
}
type Lang = "es" | "en";
const { lang = "es" } = Astro.props;

const copy = {
  es: {
    eyebrow: "// ACOMPAÑAMIENTO EN CADA ETAPA",
    title: "TE ACOMPAÑAMOS ANTES, DURANTE Y DESPUÉS DEL LANZAMIENTO.",
    intro:
      "No desaparecemos después de la entrega: el mismo equipo que escribe el código te acompaña en cada etapa del sistema.",
    cta: "QUIERO MI DIAGNÓSTICO",
    aria: "Acompañamiento en cada etapa del proyecto",
  },
  en: {
    eyebrow: "// SUPPORT AT EVERY STAGE",
    title: "WE'RE WITH YOU BEFORE, DURING AND AFTER LAUNCH.",
    intro:
      "We don't disappear after delivery: the same team that writes the code walks your system through every stage.",
    cta: "I WANT MY DIAGNOSIS",
    aria: "Support at every stage of the project",
  },
}[lang];

const STAGES = [
  {
    badge: lang === "en" ? "STEP 01" : "PASO 01",
    title: "DIAGNÓSTICO",
    description:
      lang === "en"
        ? "2-hour interview + 48 h report. We understand your business and tell you where money leaks."
        : "Entrevista de 2 horas + informe en 48 h. Entendemos tu negocio y te decimos dónde se te va la plata.",
  },
  {
    badge: lang === "en" ? "STEP 02" : "PASO 02",
    title: "PROTOTIPO",
    description:
      lang === "en"
        ? "You see a working mockup of your system before signing. If you don't like it, you don't pay."
        : "Ves una maqueta funcional de tu sistema antes de firmar. Si no te convence, no pagás.",
  },
  {
    badge: lang === "en" ? "STEP 03" : "PASO 03",
    title: "DESARROLLO",
    description:
      lang === "en"
        ? "Weekly visible progress on a test environment. You weigh in while it gets built."
        : "Avances semanales visibles en un entorno de prueba. Vos opinás mientras se construye.",
  },
  {
    badge: lang === "en" ? "STEP 04" : "PASO 04",
    title: "LANZAMIENTO",
    description:
      lang === "en"
        ? "Production with documentation and training for your team, on the date written in the contract."
        : "Salimos a producción con documentación y capacitación para tu equipo, en la fecha del contrato.",
  },
  {
    badge: lang === "en" ? "STEP 05" : "PASO 05",
    title: "SOPORTE",
    description:
      lang === "en"
        ? "Monthly maintenance with development hours for whatever comes after launch."
        : "Mantenimiento mensual con horas de desarrollo para los cambios que vengan después.",
  },
];

/* Symmetric fan transforms (mirrors the React Bits BounceCards setup). */
const FAN = [
  { x: -400, rotate: -8 },
  { x: -200, rotate: -4 },
  { x: 0, rotate: 0 },
  { x: 200, rotate: 4 },
  { x: 400, rotate: 8 },
];
---

<section
  id="acompanamiento"
  class="stage-fan relative overflow-hidden bg-[#FF4D00] text-black py-20 lg:py-28 scroll-mt-16"
  aria-label={copy.aria}
  data-stage-fan
>
  <div class="relative z-10 mx-auto max-w-[1400px] px-6">
    <!-- Header: title left, intro right -->
    <div class="grid gap-6 lg:grid-cols-[1.2fr_1fr] lg:items-end lg:gap-12">
      <h2 class="reveal font-display text-4xl sm:text-5xl lg:text-6xl uppercase tracking-[-0.04em] leading-[0.88] text-black m-0">
        {copy.title}
      </h2>
      <p class="reveal font-sans text-sm lg:text-base leading-relaxed text-black/80 max-w-[460px] m-0" style="animation-delay: 90ms">
        {copy.intro}
      </p>
    </div>

    <!-- Card fan (≥1280px) -->
    <div class="stage-fan__fan mt-14 hidden xl:flex justify-center">
      <div class="stage-fan__stage relative" style="width: min(1100px, 100%); height: 470px;">
        {
          STAGES.map((stage, i) => (
            <article
              class="stage-fan__card"
              data-fan-card={i}
              style={`z-index: ${i + 1};`}
            >
              <div class="stage-fan__pos">
                <div class="stage-fan__pop flex h-full w-full flex-col items-center px-5 pb-7 pt-9 text-center bg-black text-white border-2 border-black shadow-[0_20px_50px_-20px_rgba(0,0,0,0.45)]">
                  <svg aria-hidden="true" viewBox="0 0 60 18" class="pointer-events-none absolute right-6 top-6 w-10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color: rgba(255,77,0,0.5)">
                    <path d="M2 12c4-8 8 4 12-4s8 4 12-4 8 4 12-4" />
                    <path d="M2 4c4-6 8 2 12-4" />
                  </svg>
                  <span class="font-mono-meta text-[11px] uppercase font-bold tracking-widest text-[#FF4D00] border border-[#FF4D00] rounded-full px-4 py-1">
                    {stage.badge}
                  </span>
                  <h3 class="font-display text-2xl sm:text-3xl uppercase tracking-[-0.03em] leading-[0.9] text-white mt-4 m-0">
                    {stage.title}
                  </h3>
                  <p class="font-sans text-sm leading-relaxed text-white/75 mt-2.5 m-0">
                    {stage.description}
                  </p>
                  <a
                    href="/contacto/"
                    class="mt-auto inline-flex items-center gap-2.5 pt-5 font-mono-meta text-[11px] font-bold uppercase tracking-wider text-white hover:text-[#FF4D00] transition-colors"
                  >
                    {copy.cta}
                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-[#FF4D00] text-black transition-transform duration-200 hover:translate-x-0.5">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                        <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Carousel (<1280px) -->
    <div class="relative mt-12 xl:hidden">
      <div
        class="hidden lg:flex absolute -left-4 top-1/2 -translate-y-1/2 z-20"
        aria-hidden="true"
      >
        <button
          type="button"
          data-fan-prev
          class="flex h-12 w-12 items-center justify-center rounded-full bg-black text-white shadow-lg transition-all hover:scale-105 active:scale-95"
          aria-label={lang === "en" ? "Previous stages" : "Etapas anteriores"}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="square" stroke-linejoin="miter" d="M15 5l-7 7 7 7" />
          </svg>
        </button>
      </div>
      <div
        class="hidden lg:flex absolute -right-4 top-1/2 -translate-y-1/2 z-20"
        aria-hidden="true"
      >
        <button
          type="button"
          data-fan-next
          class="flex h-12 w-12 items-center justify-center rounded-full bg-black text-white shadow-lg transition-all hover:scale-105 active:scale-95"
          aria-label={lang === "en" ? "Next stages" : "Siguientes etapas"}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="square" stroke-linejoin="miter" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <div
        data-fan-track
        class="flex gap-6 overflow-x-auto pt-3 pb-12 px-2 -mx-2 snap-x snap-mandatory lg:snap-none scroll-smooth"
        style="scrollbar-width: none;"
      >
        {
          STAGES.map((stage) => (
            <article
              data-fan-slide
              class="relative flex w-[280px] shrink-0 snap-start flex-col items-center px-6 pb-8 pt-9 text-center bg-black text-white border-2 border-black shadow-[0_20px_50px_-24px_rgba(0,0,0,0.35)] transition-transform duration-300 hover:-translate-y-1.5"
            >
              <span class="font-mono-meta text-[11px] uppercase font-bold tracking-widest text-[#FF4D00] border border-[#FF4D00] rounded-full px-4 py-1">
                {stage.badge}
              </span>
              <h3 class="font-display text-2xl uppercase tracking-[-0.03em] leading-[0.9] text-white mt-4 m-0">
                {stage.title}
              </h3>
              <p class="font-sans text-sm leading-relaxed text-white/75 mt-2.5 mb-0">
                {stage.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .stage-fan {
    /* Dot grid over the orange, echoing the analog instrument look. */
    background-image: radial-gradient(rgba(0, 0, 0, 0.12) 1.5px, transparent 1.5px);
    background-size: 22px 22px;
  }
  .stage-fan__card {
    position: absolute;
    left: 50%;
    top: 0;
    width: 300px;
    height: 440px;
    margin-left: -150px;
  }
  .stage-fan__pos {
    width: 100%;
    height: 100%;
    /* Hover push rides on this layer: JS only swaps --push. */
    transform: translateX(var(--push, 0px));
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .stage-fan__pop {
    position: relative;
    overflow: hidden;
  }
  .stage-fan__track::-webkit-scrollbar,
  [data-fan-track]::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  import gsap from "gsap";

  const section = document.querySelector<HTMLElement>("[data-stage-fan]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (section) {
    const cards = Array.from(section.querySelectorAll<HTMLElement>("[data-fan-card]"));
    const FAN = [
      { x: -400, rotate: -8 },
      { x: -200, rotate: -4 },
      { x: 0, rotate: 0 },
      { x: 200, rotate: 4 },
      { x: 400, rotate: 8 },
    ];

    // Hover push: the hovered card lifts, siblings are pushed away by an
    // offset that falls off with distance (adjacent gets the full push).
    const applyPush = (hovered: number | null) => {
      cards.forEach((card, i) => {
        const pos = card.querySelector<HTMLElement>(".stage-fan__pos");
        if (!pos) return;
        if (hovered === null) {
          pos.style.setProperty("--push", "0px");
          pos.style.scale = "1";
          card.style.zIndex = String(i + 1);
          return;
        }
        if (i === hovered) {
          pos.style.setProperty("--push", "0px");
          pos.style.scale = "1.06";
          card.style.zIndex = "30";
        } else {
          const dir = i < hovered ? -1 : 1;
          const dist = Math.abs(i - hovered);
          pos.style.setProperty("--push", `${dir * (90 / dist)}px`);
          pos.style.scale = "1";
          card.style.zIndex = String(i + 1);
        }
      });
    };

    cards.forEach((card, i) => {
      card.addEventListener("mouseenter", () => applyPush(i));
      card.addEventListener("mouseleave", () => applyPush(null));
    });

    // Carousel arrows (<1280px).
    const track = section.querySelector<HTMLElement>("[data-fan-track]");
    const prev = section.querySelector<HTMLElement>("[data-fan-prev]");
    const next = section.querySelector<HTMLElement>("[data-fan-next]");
    const scrollCards = (dir: 1 | -1) => {
      if (!track) return;
      const card = track.querySelector<HTMLElement>("[data-fan-slide]");
      const stepW = card ? card.offsetWidth + 24 : 300;
      track.scrollBy({ left: dir * stepW, behavior: "smooth" });
    };
    prev?.addEventListener("click", () => scrollCards(-1));
    next?.addEventListener("click", () => scrollCards(1));

    // Elastic entrance: cards start stacked small at the center and bounce
    // out to their fan positions (elastic.out 1.1s, stagger 0.07) — the
    // port of React Bits BounceCards. Runs once, on scroll into view.
    if (!reduceMotion && cards.length > 0) {
      gsap.set(cards, { x: 0, rotation: 0, scale: 0.3, opacity: 0 });
      const play = () => {
        cards.forEach((card, i) => {
          gsap.to(card, {
            x: FAN[i].x,
            rotation: FAN[i].rotate,
            scale: 1,
            opacity: 1,
            duration: 1.1,
            ease: "elastic.out(1, 0.75)",
            delay: 0.07 * i,
          });
        });
      };
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              play();
              io.disconnect();
              break;
            }
          }
        },
        { threshold: 0.3 },
      );
      io.observe(section);
    } else if (cards.length > 0) {
      // Reduced motion: fan in place, no entrance, no push.
      cards.forEach((card, i) => {
        gsap.set(card, { x: FAN[i].x, rotation: FAN[i].rotate, scale: 1, opacity: 1 });
      });
      cards.forEach((card) => {
        card.replaceWith(card.cloneNode(true));
      });
    }
  }
</script>
