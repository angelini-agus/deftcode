---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { heroContent } = getContent(lang);

const servicesHref = lang === "en" ? "#services" : "#servicios";
const scrollAriaLabel = lang === "en" ? "Scroll to services" : "Desplazarse a servicios";
const originLabel = lang === "en" ? "ORIGIN // COVERAGE" : "ORIGEN // COBERTURA";
---

<section
  id="top"
  class="relative bg-[#FF4D00] text-black flex flex-col justify-between min-h-screen pt-20 md:pt-24 pb-8 sm:pb-12 px-4 md:px-12"
>
  <!-- Top Utility Tag -->
  <div class="flex items-center justify-between pb-4">
    <div
      data-hero-label
      data-hero-scramble
      class="hidden sm:block font-mono-meta text-xs font-bold uppercase tracking-wider text-black ml-[var(--hero-indent,0px)]"
    >
      {lang === "en" ? "EST. 2026 // AGILE DEV" : "EST. 2026 // DESARROLLO ÁGIL"}
    </div>
  </div>

  <!-- Giant Typographic Headline (16vw) -->
  <div class="flex flex-col items-center justify-center text-center pt-44 pb-0 hero-middle">
    <h1
      data-hero-h1
      data-hero-scramble
      class="font-display text-[15vw] sm:text-[16vw] leading-[0.85] tracking-[-0.04em] text-black uppercase m-0 whitespace-nowrap w-full"
    >
      {heroContent.headlineMain}
    </h1>
    <p
      data-hero-sub
      data-hero-scramble
      class="font-display text-[4.6vw] leading-[0.9] tracking-[-0.03em] text-black uppercase mt-2 text-balance"
    >
      {heroContent.headlineSub}
    </p>
  </div>

  <!-- §7 conversion CTA: user request — the block sits at the exact
       vertical midpoint of the gap between the subheadline and the 2px
       divider. my-auto absorbs ALL leftover section space symmetrically
       around this block, so its center lands exactly on the midpoint of
       that gap regardless of viewport height. Microcopy on one line (sm+). -->
  <div class="my-auto flex items-center justify-center">
    <div data-hero-cta class="flex flex-col items-center gap-2">
      <a
        href={heroContent.ctaHref}
        class="group inline-flex items-center gap-3 bg-black text-white font-mono-meta text-xs sm:text-sm font-bold uppercase tracking-wider px-6 sm:px-8 py-3.5 sm:py-4 rounded-full border-2 border-black shadow-[0_10px_26px_rgba(0,0,0,0.35)] transition-all duration-200 hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
      >
        <span>{heroContent.ctaLabel}</span>
        <svg
          class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
      <p
        class="font-mono-meta text-[10px] sm:text-[11px] uppercase font-bold tracking-wider text-black/75 m-0 text-center whitespace-normal sm:whitespace-nowrap leading-relaxed"
      >
        {heroContent.microcopy}
      </p>
    </div>
  </div>

  <!-- 2px Black Divider & Metadata Row -->
  <div class="w-full max-w-7xl mx-auto">
    <!-- Horizontal Border Divider (2px solid #000000) -->
    <div class="w-full h-[2px] bg-black mb-6 hero-divider"></div>

    <div class="grid grid-cols-1 md:grid-cols-3 items-center gap-6 md:gap-4">
      <!-- Left: Location -->
      <div
        data-hero-origen
        class="font-mono-meta text-xs md:text-sm font-bold uppercase tracking-[-0.02em] text-black"
      >
        <span data-hero-scramble class="block text-[11px] opacity-75 font-normal">{originLabel}</span>
        <span data-hero-scramble class="block">{heroContent.locationText}</span>
      </div>

      <!-- Center: 144px Rotating Circular 'Scroll Down' Text Indicator with Dynamic Rotating Arrow -->
      <div class="flex justify-center items-center py-2">
        <a
          href={servicesHref}
          data-hero-arrow-link
          class="relative w-[144px] h-[144px] flex items-center justify-center group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black"
          aria-label={scrollAriaLabel}
        >
          <!-- Rotating SVG Text Container (360deg over 16s) -->
          <svg
            class="absolute inset-0 w-full h-full animate-spin-slow select-none pointer-events-none"
            viewBox="0 0 144 144"
          >
            <defs>
              <path
                id="circlePath"
                d="M 72, 72 m -54, 0 a 54,54 0 1,1 108,0 a 54,54 0 1,1 -108,0"
              />
            </defs>
            <text
              class="font-mono-meta text-[9px] font-bold fill-black uppercase"
              letter-spacing="0.18em"
            >
              <textPath href="#circlePath" startOffset="0%">
                {heroContent.scrollText} {heroContent.scrollText}
              </textPath>
            </text>
          </svg>

          <!-- Static Center Circle & Dynamic Rotating Arrow Icon -->
          <div
            class="w-12 h-12 rounded-full bg-black text-[#FF4D00] flex items-center justify-center border-2 border-black transition-transform duration-300 group-hover:scale-110 shadow-md"
          >
            <svg
              data-hero-arrow
              class="w-5 h-5 will-change-transform origin-center"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
            >
              <path stroke-linecap="square" stroke-linejoin="miter" d="M12 4v16m0 0l-6-6m6 6l6-6"></path>
            </svg>
          </div>
        </a>
      </div>

      <!-- Right: Role / Title description -->
      <div
        data-hero-role
        data-hero-scramble
        class="font-mono-meta text-xs md:text-sm font-bold uppercase tracking-[-0.02em] text-black md:text-right"
      >
        {heroContent.roleText}
      </div>
    </div>
  </div>
</section>

<style>
  /* Full first screen: the fold must sit below the tilted strip's highest
     corner, which rises tan(2deg) x 62.5vw (~2.2vw) above the marquee top.
     100svh keeps mobile browser chrome from letting the marquee peek;
     100vh fallback for older browsers. */
  #top {
    min-height: calc(100vh + 2.5vw);
    min-height: calc(100svh + 2.5vw);
  }
  /* Compact levels by window height: cut air only (paddings/margins),
     never the copy or the 144px scroll control. Thresholds measured
     from content: the hero holds exactly 90vh down to ~600px windows. */
  @media (max-height: 776px) {
    #top {
      padding-top: 3.5rem;
      padding-bottom: 1.5rem;
    }
    #top .hero-middle {
      padding-top: 0.5rem;
      padding-bottom: 0;
    }
    #top .hero-divider {
      margin-bottom: 1rem;
    }
    /* The CTA keeps its copy and control height; only its air shrinks.
       (No margin-bottom: the flex-1 half already centers the block.) */
    #top [data-hero-cta] {
      gap: 0.3rem;
    }
    #top [data-hero-cta] p {
      font-size: 10px;
    }
  }
  @media (max-height: 600px) {
    #top {
      padding-top: 2rem;
      padding-bottom: 1rem;
    }
    #top .hero-middle {
      padding-top: 0;
      padding-bottom: 0;
    }
    /* Below 600px the decorative EST. 2026 tag collides with the fixed
       navbar: hide it (it is brand air, not copy) and let the headline
       breathe. */
    #top [data-hero-label] {
      display: none;
    }
    #top [data-hero-cta] {
      margin-bottom: 0.75rem;
    }
  }
</style>

<style is:global>
  /* Intro entrance initial states, applied ONLY while the intro actually
     runs: the BaseLayout head script adds html.intro-run pre-paint when it
     decides not to skip (no sessionStorage flag, motion OK). Subsequent
     navigations (.preload-skip), reduced motion and no-JS never match, so
     the hero always paints fully rendered. GSAP drives these states to
     their natural values from the 2.1s handoff event and drops .intro-run
     when the entrance completes. */
  /* Every group arrives from its own side: headline from the LEFT, sub
     from the RIGHT, top label from ABOVE, origen from the left, role
     from the right, scroll circle from BELOW. */
  html.intro-run [data-hero-h1] {
    opacity: 0;
    transform: translateX(-70px);
  }
  html.intro-run [data-hero-sub] {
    opacity: 0;
    transform: translateX(70px);
  }
  html.intro-run [data-hero-label] {
    opacity: 0;
    transform: translateY(-22px);
  }
  html.intro-run [data-hero-origen] {
    opacity: 0;
    transform: translateX(-30px);
  }
  html.intro-run [data-hero-role] {
    opacity: 0;
    transform: translateX(30px);
  }
  html.intro-run .hero-divider {
    transform: scaleX(0);
  }
  html.intro-run [data-hero-arrow-link] {
    transform: translateY(34px) scale(0.8) rotate(-90deg);
  }
  /* Conversion CTA rises from below with the metadata row (no scramble:
     it is a single short label, so one slide-in is enough). */
  html.intro-run [data-hero-cta] {
    opacity: 0;
    transform: translateY(22px);
  }
  /* The terminal scramble keeps one line but transiently varies the line
     width; clip it inside the section for the intro only. */
  html.intro-run #top {
    overflow-x: clip;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";

  gsap.registerPlugin(ScrambleTextPlugin);

  const initHeroArrowRotation = () => {
    const arrow = document.querySelector<SVGElement>("[data-hero-arrow]");
    const link = document.querySelector<HTMLAnchorElement>("[data-hero-arrow-link]");

    if (!arrow) return;

    let targetRotation = 0;
    let currentRotation = 0;
    let rafId: number | null = null;

    const tick = () => {
      // Smooth lerp: glides tranqui without abrupt jumps
      const diff = targetRotation - currentRotation;

      if (Math.abs(diff) < 0.05) {
        currentRotation = targetRotation;
        arrow.style.transform = `rotate(${currentRotation.toFixed(2)}deg)`;
        rafId = null;
        return;
      }

      currentRotation += diff * 0.075;
      arrow.style.transform = `rotate(${currentRotation.toFixed(2)}deg)`;
      rafId = requestAnimationFrame(tick);
    };

    const requestTick = () => {
      if (rafId === null) {
        rafId = requestAnimationFrame(tick);
      }
    };

    const onScroll = () => {
      const scrollY = window.scrollY;
      // Gradual, elegant scroll runway across the hero section
      const maxScroll = Math.max(350, window.innerHeight * 0.8);
      const progress = Math.min(1, Math.max(0, scrollY / maxScroll));

      // Opposite direction: rotates towards the right (clockwise) to +180deg until pointing up
      targetRotation = progress * 180;
      requestTick();
    };

    if (link) {
      link.addEventListener("click", (e) => {
        const scrollY = window.scrollY;
        const maxScroll = Math.max(350, window.innerHeight * 0.8);
        const progress = Math.min(1, Math.max(0, scrollY / maxScroll));
        if (progress > 0.6) {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
      });
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    onScroll();
  };

  document.addEventListener("DOMContentLoaded", initHeroArrowRotation);
  initHeroArrowRotation();

  // Align the EST. 2026 label with the h1's left text edge: the giant
  // centered headline starts well inside the section padding, and the
  // label must carry the same visual margin at any viewport width.
  const heroSection = document.getElementById("top");
  const heroLabel = document.querySelector("[data-hero-label]");
  const heroH1 = heroSection?.querySelector("h1");

  // One-line headline: the giant h1 must never wrap. Start from the CSS
  // fluid size, then shrink proportionally by the measured overflow ratio
  // until the text fits its container width on exactly one line.
  const fitHeroH1 = () => {
    if (!heroH1) return;
    heroH1.style.fontSize = "";
    let px = parseFloat(getComputedStyle(heroH1).fontSize);
    for (let pass = 0; pass < 3; pass++) {
      const overflow = heroH1.scrollWidth / heroH1.clientWidth;
      if (overflow <= 1) break;
      px = Math.max(16, Math.floor((px / overflow) * 0.98));
      heroH1.style.fontSize = `${px}px`;
    }
  };

  const alignHeroLabel = () => {
    if (!heroSection || !heroLabel || !heroH1) return;
    const range = document.createRange();
    range.selectNodeContents(heroH1);
    const rects = Array.from(range.getClientRects());
    const textLeft = rects.length ? Math.min(...rects.map((r) => r.left)) : heroH1.getBoundingClientRect().left;
    const padding = parseFloat(getComputedStyle(heroSection).paddingLeft) || 0;
    const indent = Math.max(0, Math.round(textLeft - heroSection.getBoundingClientRect().left - padding));
    heroSection.style.setProperty("--hero-indent", `${indent}px`);
  };

  // During the intro decode the h1 text is transient scramble garbage:
  // fitting waits until the final string is restored (see onComplete).
  let introScrambling = false;
  const onHeroLayout = () => {
    if (introScrambling) return;
    fitHeroH1();
    alignHeroLabel();
  };

  if (heroSection && heroLabel && heroH1) {
    document.fonts.ready.then(() => {
      fitHeroH1();
      alignHeroLabel();
    });
    window.addEventListener("resize", onHeroLayout, { passive: true });
    onHeroLayout();
  }

  // --- Intro entrance (phase 4, 2.1s–3.3s) --------------------------------
  // Final strings are read from the DOM at runtime (never hardcoded): the
  // scramble decodes letter by letter and restores them exactly, so the
  // one-line fit (fitHeroH1, whitespace-nowrap) keeps holding. Normalizing
  // the captured strings is render-neutral: HTML collapses whitespace.
  const introRoot = document.documentElement;
  const finalTexts = new Map<HTMLElement, string>();
  for (const el of Array.from(document.querySelectorAll<HTMLElement>("[data-hero-scramble]"))) {
    const original = (el.textContent ?? "").replace(/\s+/g, " ").trim();
    if (original) {
      finalTexts.set(el, original);
      el.textContent = original;
    }
  }

  let heroIntroStarted = false;

  const startHeroIntro = () => {
    if (heroIntroStarted) return;
    // The inline 4s failsafe may already have revealed everything.
    if (!introRoot.classList.contains("intro-run")) return;
    heroIntroStarted = true;
    introRoot.dataset.introStarted = "1";

    const tl = gsap.timeline({
      defaults: { ease: "power3.out" },
      onComplete: () => {
        introRoot.classList.remove("intro-run");
        introScrambling = false;
        fitHeroH1();
        alignHeroLabel();
      },
    });

    const h1 = document.querySelector<HTMLElement>("[data-hero-h1]");
    const sub = document.querySelector<HTMLElement>("[data-hero-sub]");
    const label = document.querySelector<HTMLElement>("[data-hero-label]");
    const origen = document.querySelector<HTMLElement>("[data-hero-origen]");
    const role = document.querySelector<HTMLElement>("[data-hero-role]");
    const divider = document.querySelector<HTMLElement>(".hero-divider");
    const circle = document.querySelector<HTMLElement>("[data-hero-arrow-link]");
    const cta = document.querySelector<HTMLElement>("[data-hero-cta]");
    const origenLines = origen
      ? Array.from(origen.querySelectorAll<HTMLElement>("[data-hero-scramble]"))
      : [];

    // Per-letter decode: each character is an inline-block span that
    // GROWS from small (scale 0.25) to full size while its glyph cycles
    // through the narrow glitch set — letters appear small and get bigger
    // exactly as they stop glitching.
    const GLYPHS = "10_/X";
    const restored: HTMLElement[] = [];

    const buildCharSpans = (el: HTMLElement, text: string) => {
      el.textContent = "";
      const spans: { node: HTMLSpanElement; final: string }[] = [];
      for (const ch of text) {
        if (ch === " ") {
          el.appendChild(document.createTextNode(" "));
          continue;
        }
        const node = document.createElement("span");
        node.style.display = "inline-block";
        node.textContent = ch;
        el.appendChild(node);
        spans.push({ node, final: ch });
      }
      // Lock every letter box to its FINAL glyph width before the flicker
      // starts: the cycling glyphs keep the exact box the settled letter
      // will occupy, so the paragraph wraps identically mid-glitch (the
      // sub never reflows past its final two lines) and the nowrap h1
      // keeps a constant width. Widths are in em (relative to the current
      // font size) so fitHeroH1 can rescale the heading and the boxes
      // scale with it — the spans stay permanent, which is what kills the
      // end-of-intro compaction: unwrapping re-enables GPOS kerning that
      // inline blocks suppress, and the kerning shift was the jump users
      // saw in the last half second.
      const fsNow = parseFloat(getComputedStyle(el).fontSize) || 16;
      for (const { node } of spans) {
        const w = node.getBoundingClientRect().width;
        node.style.width = `${w / fsNow}em`;
        node.style.textAlign = "center";
        node.dataset.final = node.textContent;
        node.textContent = GLYPHS[(Math.random() * GLYPHS.length) | 0];
      }
      return spans;
    };

    const decode = (el: HTMLElement | null, at: number, total = 0.42) => {
      const text = el ? finalTexts.get(el) : undefined;
      if (!el || !text) return;
      restored.push(el);
      const spans = buildCharSpans(el, text);
      const each = Math.min(0.022, 0.3 / spans.length);
      const flickerMs = 110;
      spans.forEach(({ node, final }, i) => {
        const startAt = at + i * each;
        tl.fromTo(
          node,
          { scale: 0.25, opacity: 0 },
          { scale: 1, opacity: 1, duration: 0.28, ease: "back.out(1.8)" },
          startAt,
        );
        tl.call(
          () => {
            node.dataset.settled = "1";
            node.textContent = final;
          },
          undefined,
          startAt + flickerMs / 1000,
        );
      });
      // Random glyph cycling for every letter that has not settled yet.
      const cycler = window.setInterval(() => {
        for (const { node } of spans) {
          if (!node.dataset.settled) {
            node.textContent = GLYPHS[(Math.random() * GLYPHS.length) | 0];
          }
        }
      }, 42);
      tl.call(() => window.clearInterval(cycler), undefined, at + total + 0.1);
    };

    introScrambling = true;

    // Headline enters from the LEFT, sub from the RIGHT: each group
    // slides while its letters grow from small and de-glitch.
    if (h1) {
      tl.to(h1, { x: 0, opacity: 1, duration: 0.45 }, 0);
      decode(h1, 0, 0.42);
    }
    if (sub) {
      tl.to(sub, { x: 0, opacity: 1, duration: 0.45 }, 0.06);
      decode(sub, 0.06, 0.5);
    }
    // Top label drops from above, origen from the left, role from the
    // right — letters growing while the flicker cycles.
    if (label) {
      tl.to(label, { y: 0, opacity: 1, duration: 0.4 }, 0.02);
      decode(label, 0.02, 0.32);
    }
    if (origen) {
      tl.to(origen, { x: 0, opacity: 1, duration: 0.4 }, 0.08);
      origenLines.forEach((line, i) => decode(line, 0.08 + i * 0.05, 0.28));
    }
    if (role) {
      tl.to(role, { x: 0, opacity: 1, duration: 0.4 }, 0.14);
      decode(role, 0.14, 0.32);
    }
    // Divider: scaleX 0→1 from the center.
    if (divider) {
      tl.to(divider, { scaleX: 1, duration: 0.45 }, 0.1);
    }
    // Scroll circle: rises from below with a slight rotation settle.
    if (circle) {
      tl.to(circle, { y: 0, scale: 1, rotation: 0, duration: 0.55, ease: "back.out(1.6)" }, 0.12);
    }
    // Conversion CTA rises from below, last: the eye reads headline → CTA.
    if (cta) {
      tl.to(cta, { y: 0, opacity: 1, duration: 0.4 }, 0.18);
    }

    // The char spans stay permanently (widths in em, tracking-free):
    // unwrapping them re-enabled GPOS kerning that inline blocks suppress
    // and compacted the text in the last half second of the intro. With
    // the spans kept, settled glyphs only swap textContent inside a fixed
    // box, so the width never changes and the entrance stays fluid.
    // fitHeroH1/alignHeroLabel measure the live DOM (spans included) and
    // run in onComplete as before.
  };

  if (introRoot.dataset.introHandoff === "1") {
    // The handoff fired before this module executed: start immediately.
    startHeroIntro();
  } else {
    window.addEventListener("deft:intro:hero", startHeroIntro, { once: true });
  }
</script>
