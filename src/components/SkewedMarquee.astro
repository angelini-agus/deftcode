---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { marqueeItems } = getContent(lang);
---

<section class="relative w-full overflow-hidden bg-black py-16 -my-2 select-none border-y-2 border-black z-10">
  <!-- Skewed Container (-2deg) -->
  <div class="transform -rotate-2 -scale-x-100 scale-y-100 origin-center scale-105 my-[-2vw]">
    <div class="transform -scale-x-100 flex flex-col gap-4 marquee-container">
      
      <!-- Row 1: Orange (#FF4D00) Archivo Black text, 8-10vw, scrolling left -->
      <div class="overflow-hidden flex whitespace-nowrap">
        <div class="animate-marquee flex items-center">
          {
            [...marqueeItems.row1, ...marqueeItems.row1, ...marqueeItems.row1].map((item) => (
              <div class="flex items-center">
                <span class="font-display text-[8vw] sm:text-[9vw] leading-none text-[#FF4D00] uppercase tracking-[-0.04em] px-6">
                  {item}
                </span>
                <span class="inline-block w-4 h-4 sm:w-6 sm:h-6 bg-[#FF4D00] mx-4 rotate-45 flex-shrink-0"></span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Row 2: White text with 80% opacity, scrolling in reverse (right) -->
      <div class="overflow-hidden flex whitespace-nowrap">
        <div class="animate-marquee-reverse flex items-center">
          {
            [...marqueeItems.row2, ...marqueeItems.row2, ...marqueeItems.row2].map((item) => (
              <div class="flex items-center">
                <span class="font-display text-[7.5vw] sm:text-[8.5vw] leading-none text-white/80 uppercase tracking-[-0.04em] px-6">
                  {item}
                </span>
                <span class="inline-block w-3 h-3 sm:w-5 sm:h-5 bg-white/50 mx-4 rotate-45 flex-shrink-0"></span>
              </div>
            ))
          }
        </div>
      </div>

    </div>
  </div>
</section>
