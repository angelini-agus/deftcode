---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { marqueeItems } = getContent(lang);
---

<section class="relative w-full overflow-x-clip overflow-y-visible select-none">
  <!-- Tilted Black Strip (-2deg) matching reference -->
  <div class="relative w-[125vw] -left-[12.5vw] bg-black border-t-2 border-black transform -rotate-2 origin-center pt-8 sm:pt-10 md:pt-14 pb-16 sm:pb-20 md:pb-28 shadow-2xl">
    <div class="flex flex-col gap-4 sm:gap-6 marquee-container">
      
      <!-- Row 1: Orange (#FF4D00) Archivo Black text, scrolling left -->
      <div class="overflow-hidden flex whitespace-nowrap">
        <div class="animate-marquee flex items-center">
          {
            [...marqueeItems.row1, ...marqueeItems.row1, ...marqueeItems.row1, ...marqueeItems.row1].map((item) => (
              <div class="flex items-center">
                <span class="font-display text-[7.5vw] sm:text-[8.5vw] md:text-[9.5vw] leading-none text-[#FF4D00] uppercase tracking-[-0.04em] px-4 sm:px-6">
                  {item}
                </span>
                <span class="inline-block w-3.5 h-3.5 sm:w-5 sm:h-5 md:w-6 md:h-6 rounded-full bg-[#FF4D00] mx-4 sm:mx-6 flex-shrink-0"></span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Row 2: White text with 80% opacity, scrolling in reverse (right) -->
      <div class="overflow-hidden flex whitespace-nowrap">
        <div class="animate-marquee-reverse flex items-center">
          {
            [...marqueeItems.row2, ...marqueeItems.row2, ...marqueeItems.row2, ...marqueeItems.row2].map((item) => (
              <div class="flex items-center">
                <span class="font-display text-[6.5vw] sm:text-[7.5vw] md:text-[8.5vw] leading-none text-white/80 uppercase tracking-[-0.04em] px-4 sm:px-6">
                  {item}
                </span>
                <span class="inline-block w-3 h-3 sm:w-4 sm:h-4 md:w-5 md:h-5 rounded-full bg-white/50 mx-4 sm:mx-6 flex-shrink-0"></span>
              </div>
            ))
          }
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom seamless transition to black services section -->
  <div class="w-full h-24 bg-black -mt-12"></div>
</section>
