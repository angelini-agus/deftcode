---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { marqueeItems } = getContent(lang);
---

<section class="relative w-full overflow-x-clip overflow-y-visible select-none">
  <!-- Tilted Black Strip (-2deg) matching reference -->
  <div class="relative w-[125vw] -left-[12.5vw] bg-black border-t-2 border-black transform -rotate-2 origin-center pt-8 sm:pt-10 md:pt-14 pb-16 sm:pb-20 md:pb-28 shadow-2xl">
    <div class="flex flex-col gap-4 sm:gap-6 marquee-container">
      
      <!-- Row 1: Orange (#FF4D00) Archivo Black text, scrolling left -->
      <div class="overflow-hidden flex whitespace-nowrap">
        <div class="animate-marquee flex items-center">
          {
            [...marqueeItems.row1, ...marqueeItems.row1, ...marqueeItems.row1, ...marqueeItems.row1].map((item) => (
              <div class="flex items-center">
                <span class="font-display text-[7.5vw] sm:text-[8.5vw] md:text-[9.5vw] leading-none text-[#FF4D00] uppercase tracking-[-0.04em] px-4 sm:px-6">
                  {item}
                </span>
                <span class="inline-block w-3.5 h-3.5 sm:w-5 sm:h-5 md:w-6 md:h-6 rounded-full bg-[#FF4D00] mx-4 sm:mx-6 flex-shrink-0"></span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Row 2: White text with 80% opacity, scrolling in reverse (right) -->
      <div class="overflow-hidden flex whitespace-nowrap">
        <div class="animate-marquee-reverse flex items-center">
          {
            [...marqueeItems.row2, ...marqueeItems.row2, ...marqueeItems.row2, ...marqueeItems.row2].map((item) => (
              <div class="flex items-center">
                <span class="font-display text-[6.5vw] sm:text-[7.5vw] md:text-[8.5vw] leading-none text-white/80 uppercase tracking-[-0.04em] px-4 sm:px-6">
                  {item}
                </span>
                <span class="inline-block w-3 h-3 sm:w-4 sm:h-4 md:w-5 md:h-5 rounded-full bg-white/50 mx-4 sm:mx-6 flex-shrink-0"></span>
              </div>
            ))
          }
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom seamless transition to black services section -->
  <div class="w-full h-24 bg-black -mt-12"></div>
</section>
<script>
  // Marquee: hover slows the belt to 25% of its speed instead of freezing it.
  // Driven by JS for the lerp; the CSS keyframes remain the no-JS fallback.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function initMarquee(container: HTMLElement) {
    if (container.dataset.marqueeJs === "1") return;
    container.dataset.marqueeJs = "1";

    type Track = { el: HTMLElement; dir: 1 | -1; period: number; x: number };
    const items: Track[] = Array.from(
      container.querySelectorAll<HTMLElement>(".animate-marquee, .animate-marquee-reverse"),
    ).map((el: HTMLElement): Track => {
      const matrix = new DOMMatrixReadOnly(getComputedStyle(el).transform);
      // Markup repeats each row 4 times, so one pattern = 1/4 of the strip.
      const period = el.scrollWidth / 4 || 1;
      const dir: 1 | -1 = el.classList.contains("animate-marquee-reverse") ? 1 : -1;
      el.style.animation = "none";
      return { el, dir, period, x: matrix.e };
    });

    const remeasure = () => {
      for (const t of items) t.period = t.el.scrollWidth / 4 || 1;
    };

    let factor = 1;
    let target = 1;
    let raf = 0;
    let last = 0;

    const tick = (now: number) => {
      const dt = Math.min(100, now - last) / 1000;
      last = now;
      factor += (target - factor) * (1 - Math.exp(-dt * 6));
      for (const t of items) {
        // Same base speed as the 60s CSS loop: half a strip per 60s.
        t.x += t.dir * ((t.period * 2) / 60) * factor * dt;
        let n = ((t.x % t.period) + t.period) % t.period;
        if (n > 0) n -= t.period;
        t.el.style.transform = `translate3d(${n}px, 0, 0)`;
      }
      raf = requestAnimationFrame(tick);
    };

    const start = () => (last = performance.now(), (raf = requestAnimationFrame(tick)));
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };

    container.addEventListener("pointerenter", () => (target = 0.25));
    container.addEventListener("pointerleave", () => (target = 1));

    document.fonts?.ready.then(remeasure);
    window.addEventListener("resize", remeasure, { passive: true });

    const observer = new IntersectionObserver((entries) => {
      const inside = entries.some((e) => e.isIntersecting);
      if (inside && !raf && !reduceMotion.matches) start();
      if (!inside && raf) stop();
    });
    observer.observe(container);
    if (!reduceMotion.matches) start();

    reduceMotion.addEventListener("change", () => {
      if (reduceMotion.matches && raf) stop();
      if (!reduceMotion.matches && !raf) start();
    });
  }

  document.querySelectorAll<HTMLElement>(".marquee-container").forEach(initMarquee);
</script>
