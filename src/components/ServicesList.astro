---
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { servicesHome } = getContent(lang);
const sectionId = lang === "en" ? "services" : "servicios";
const basePath = lang === "en" ? "/en/services/" : "/servicios/";
const sheetLabel = lang === "en" ? "FULL SERVICE SHEET" : "FICHA COMPLETA";
---

<section id={sectionId} class="relative bg-black text-white py-20 md:py-24 px-4 md:px-12">
  <div class="max-w-7xl mx-auto @container">
    <!-- Editorial heading (§3.5 intro removed by user request) -->
    <div class="border-b border-white/20 pb-8">
      <span class="reveal font-mono-meta text-xs uppercase text-[#FF4D00] font-bold tracking-widest block mb-2">
        {servicesHome.eyebrow}
      </span>
      <h2 data-fit-title class="reveal font-display text-[15vw] sm:text-[13vw] leading-[0.85] tracking-[-0.04em] text-white uppercase m-0">
        {servicesHome.title}
      </h2>
    </div>

    <!-- Service rows: ( index ) + title + line + §3.5 button. The ( 00 )
         diagnostic row is the entry offer: its title is not a sheet link. -->
    <div class="border-b border-white/20" data-stagger="90">
      {
        servicesHome.items.map((item) => (
          <article class="reveal relative py-9 sm:py-10 md:py-12 border-t border-white/20">
            <div class="grid grid-cols-[2.75rem_minmax(0,1fr)] md:grid-cols-[5.5rem_minmax(0,1fr)] lg:grid-cols-[5.5rem_minmax(0,1fr)_auto] items-start gap-x-3 md:gap-x-6">
              <span class="font-mono-meta text-sm md:text-xl font-bold text-[#FF4D00] pt-2 md:pt-4 tracking-tight">
                ( {item.index} )
              </span>

              <div class="min-w-0">
                {item.slug ? (
                  <a
                    href={`${basePath}${item.slug}/`}
                    class="group inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF4D00]"
                  >
                    <h3 class="font-display text-3xl sm:text-5xl md:text-[6.5cqw] lg:text-[4.7cqw] uppercase tracking-[-0.04em] leading-[0.85] text-white group-hover:text-[#FF4D00] transition-colors duration-200 m-0">
                      {item.title}
                    </h3>
                  </a>
                ) : (
                  <a
                    href={item.buttonHref}
                    class="group inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF4D00]"
                  >
                    <h3 class="font-display text-3xl sm:text-5xl md:text-[6.5cqw] lg:text-[4.7cqw] uppercase tracking-[-0.04em] leading-[0.85] text-white group-hover:text-[#FF4D00] transition-colors duration-200 m-0">
                      {item.title}
                    </h3>
                  </a>
                )}

                <p class="font-sans text-sm sm:text-base text-white/75 leading-relaxed mt-3 mb-0">
                  {item.line}
                </p>

                {item.slug && (
                  <a
                    href={`${basePath}${item.slug}/`}
                    class="group inline-flex items-center gap-2 font-mono-meta text-[11px] font-bold text-white/60 hover:text-[#FF4D00] uppercase tracking-wider mt-3 transition-colors border-b border-white/20 hover:border-[#FF4D00] pb-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF4D00]"
                  >
                    <span>{sheetLabel}</span>
                    <span class="transition-transform duration-200 group-hover:translate-x-1.5" aria-hidden="true">&rarr;</span>
                  </a>
                )}
              </div>

              <div class="col-span-2 lg:col-span-1 mt-5 lg:mt-1 lg:justify-self-end">
                <a
                  href={item.buttonHref}
                  class="group inline-flex items-center gap-3 bg-[#FF4D00] text-black font-mono-meta text-xs sm:text-sm font-bold uppercase px-5 py-3 rounded-full border-2 border-black hover:scale-105 transition-transform duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF4D00]"
                >
                  <span>{item.buttonLabel}</span>
                  <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
