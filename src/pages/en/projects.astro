---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/PageBanner.astro";
import ProjectsStack from "../../components/ProjectsStack.astro";
import CtaSection from "../../components/CtaSection.astro";
import { getContent } from "../../lib/content";
import { Image } from "astro:assets";
import { projectAssets } from "../../lib/project-images";

const content = getContent("en");
const page = content.pages.proyectos;
const { projects } = content;
---

<BaseLayout
  lang="en"
  title={page.title}
  description={page.description}
>
  <PageBanner
    eyebrow={page.eyebrow}
    title={page.h1}
    intro={page.intro}
  />

  <!-- Interactive Runway Deck -->
  <ProjectsStack lang="en" />

  <!-- Directory of Project Cases (Links directly to each dedicated route) -->
  <section class="bg-black text-white py-20 px-4 md:px-12 border-b-2 border-black">
    <div class="max-w-7xl mx-auto">
      <div class="border-b border-white/20 pb-8 mb-12 flex flex-col sm:flex-row justify-between sm:items-end gap-4">
        <div>
          <span class="font-mono-meta text-xs uppercase text-[#FF4D00] font-bold tracking-widest block mb-2">
            // CASE DIRECTORY
          </span>
          <h2 class="font-display text-4xl sm:text-5xl text-white uppercase tracking-[-0.04em] leading-[0.9]">
            ALL CASE STUDIES
          </h2>
        </div>
        <p class="font-mono-meta text-xs text-white/60 max-w-xs sm:text-right">
          SELECT ANY PRODUCTION DEPLOYMENT TO EXPLORE ITS ARCHITECTURE.
        </p>
      </div>

      <!-- 3-Column Brutalist Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          projects.map((item, index) => (
            <a
              href={`/en/projects/${item.slug}/`}
              class="group border-2 border-white/20 bg-white/[0.02] flex flex-col justify-between hover:border-[#FF4D00] transition-all duration-300 hover:translate-y-[-4px] overflow-hidden"
            >
              <!-- Card Top: Screenshot Thumbnail Frame -->
              <div>
                <div class="flex justify-between items-center text-[11px] font-mono-meta text-white/70 px-4 py-2 bg-neutral-900 border-b border-white/20">
                  <span class="font-bold text-[#FF4D00]">[{String(index + 1).padStart(2, "0")}] {item.category}</span>
                  <span class="text-white/50">{item.year}</span>
                </div>

                {item.imageKey && projectAssets[item.imageKey] && (
                  <div class="relative bg-neutral-950 overflow-hidden aspect-[16/10]">
                    <Image
                      src={projectAssets[item.imageKey].main}
                      alt={projectAssets[item.imageKey].altEn}
                      width={600}
                      height={375}
                      class="w-full h-full object-cover object-top filter contrast-[1.02] group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                )}

                <div class="p-6">
                  {item.client && (
                    <span class="font-mono-meta text-[11px] uppercase text-[#FF4D00] font-semibold block mb-2 tracking-wide">
                      // {item.client}
                    </span>
                  )}
                  <h3 class="font-display text-xl sm:text-2xl text-white uppercase tracking-tight leading-tight mb-3 group-hover:text-[#FF4D00] transition-colors">
                    {item.title}
                  </h3>
                  <p class="font-sans text-xs sm:text-sm text-white/70 leading-relaxed line-clamp-3 mb-6">
                    {item.description}
                  </p>

                  <!-- Metric Pills -->
                  <div class="flex flex-wrap gap-1.5 mb-2">
                    {item.metrics.slice(0, 2).map((metric) => (
                      <span class="bg-[#FF4D00] text-black font-mono-meta text-[10px] font-bold px-2 py-0.5 uppercase tracking-tight">
                        {metric}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Card Action Footer -->
              <div class="border-t border-white/10 px-6 py-4 flex items-center justify-between font-mono-meta text-xs uppercase font-bold text-white group-hover:text-[#FF4D00] bg-black/40">
                <span>VIEW CASE STUDY</span>
                <span class="transform group-hover:translate-x-1.5 transition-transform duration-300">&rarr;</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaSection lang="en" />
</BaseLayout>
