---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/PageBanner.astro";
import ManifestoSection from "../../components/ManifestoSection.astro";
import StageFan from "../../components/StageFan.astro";
import TeamSection from "../../components/TeamSection.astro";
import CtaSection from "../../components/CtaSection.astro";
import { getContent } from "../../lib/content";

const content = getContent("en");
const page = content.pages.nosotros;
---

<BaseLayout
  lang="en"
  title={page.title}
  description={page.description}
>
  <PageBanner lang="en" heroLike
    title={page.h1}
    intro={page.intro}
    ctaLabel="Get my free audit"
    ctaHref="/en/contact/#formulario"
  />
  <TeamSection lang="en" />
  <StageFan lang="en" />
  <ManifestoSection lang="en" />
  <CtaSection lang="en" />
</BaseLayout>
