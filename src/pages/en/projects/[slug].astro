---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CtaSection from "../../../components/CtaSection.astro";
import { getContent } from "../../../lib/content";
import type { ProjectItem } from "../../../lib/types";
import { Image } from "astro:assets";
import { buildLightboxGalleries, projectAssets } from "../../../lib/project-images";
import ScreenLightbox from "../../../components/ScreenLightbox.astro";

export function getStaticPaths() {
  const content = getContent("en");
  const projectsList = content.projects;
  const total = projectsList.length;

  return projectsList.map((project, index) => {
    const prev = index > 0 ? projectsList[index - 1] : projectsList[total - 1];
    const next = index < total - 1 ? projectsList[index + 1] : projectsList[0];
    return {
      params: { slug: project.slug },
      props: {
        project,
        prev,
        next,
        currentIndex: index + 1,
        total,
      },
    };
  });
}

interface Props {
  project: ProjectItem;
  prev: ProjectItem;
  next: ProjectItem;
  currentIndex: number;
  total: number;
}

const { project, prev, next, currentIndex, total } = Astro.props;
const assets = projectAssets[project.imageKey];
const lightboxGalleries = buildLightboxGalleries([project], "en");
const seoTitle = `${project.metaTitle} // DEFTCODE®`;
const seoDescription = project.description;
---

<BaseLayout
  lang="en"
  title={seoTitle}
  description={seoDescription}
>
  <!-- Breadcrumb & Back Link Header -->
  <header class="relative bg-black text-white pt-28 pb-12 px-4 md:px-12">
    <div class="max-w-7xl mx-auto flex flex-col gap-6">
      
      <!-- Back Link -->
      <div class="flex items-center justify-between">
        <a
          href="/en/projects/"
          class="group inline-flex items-center gap-2 font-mono-meta text-xs uppercase font-bold text-white/80 hover:text-[#FF4D00] transition-colors py-1 border-b border-white/30 hover:border-[#FF4D00]"
        >
          <span class="transition-transform duration-200 group-hover:-translate-x-1">&larr;</span>
          <span>ALL CASE STUDIES</span>
        </a>
      </div>

      <!-- Project Main Title in Archivo Black -->
      <div class="space-y-4">
        <span class="reveal font-mono-meta text-xs uppercase tracking-widest text-[#FF4D00] font-bold block">
          // {project.client} {project.location ? `· ${project.location}` : ""}
        </span>
        <h1 data-decode-title class="reveal font-display text-4xl sm:text-6xl md:text-[6.5vw] uppercase tracking-[-0.04em] leading-[0.88] m-0 text-white">
          {project.title}
        </h1>
        <p class="reveal reveal-late font-sans text-base sm:text-xl font-medium text-white/80 leading-relaxed">
          {project.description}
        </p>
      </div>

      <!-- Metadata Strip: Category, Year, Tech Stack, Live URL -->
      <div class="border-t border-white/20 pt-6 flex flex-wrap items-center justify-between gap-4 font-mono-meta text-xs">
        <div class="flex flex-wrap items-center gap-2">
          <span class="bg-[#FF4D00] text-black px-3 py-1 font-bold uppercase tracking-wider">
            {project.category}
          </span>
          <span class="border border-white/30 px-3 py-1 font-bold text-white uppercase">
            {project.year}
          </span>
          {project.tags.map((tag) => (
            <span class="border border-white/25 rounded-full text-white/75 px-2.5 py-1 uppercase">
              {tag}
            </span>
          ))}
        </div>

        {project.liveUrl && (
          <a
            href={project.liveUrl.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 bg-[#FF4D00] text-black px-5 py-2.5 rounded-full border-2 border-black font-bold uppercase hover:scale-105 transition-transform duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF4D00]"
          >
            <span>LIVE DEPLOYMENT: {project.liveUrl.label}</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="square" stroke-linejoin="miter" d="M7 17L17 7M17 7H7M17 7V17"></path>
            </svg>
          </a>
        )}
      </div>

    </div>
  </header>

  <!-- Main Hero Visual Frame (Production Screenshot) -->
  <section class="relative bg-[#FF4D00] py-16 md:py-20 px-4 md:px-12 text-black">
    <div class="max-w-7xl mx-auto">
      <div class="border-2 border-black bg-black text-white overflow-hidden shadow-[12px_12px_0_#000000]">
        <!-- Brutalist Window Bar -->
        <div class="flex justify-between items-center text-xs font-mono-meta text-white/70 px-4 py-2.5 bg-black border-b-2 border-white/20">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 bg-[#FF4D00]"></span>
            <span class="font-bold tracking-wider text-[#FF4D00]">SCREENSHOT // PRODUCTION</span>
          </div>
          <span class="text-[11px] font-bold text-[#FF4D00]">
            LIVE
          </span>
        </div>

        {assets && (
          <div class="relative bg-black overflow-hidden">
            <Image
              src={assets.main}
              alt={assets.altEn}
              width={1600}
              height={1000}
              quality={90}
              class="img-reveal w-full h-auto object-cover"
              loading="eager"
            />
          </div>
        )}

        <div class="flex items-center justify-between border-t border-white/20 px-6 py-3 text-xs font-mono-meta text-white/60 bg-black">
          <span>{project.client}{project.location ? ` · ${project.location}` : ""}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem / Challenge & Before-After Contrast Section -->
  <section class="relative bg-black text-white py-16 md:py-20 px-4 md:px-12">
    <div class="max-w-7xl mx-auto space-y-12">
      
      <!-- Section Header -->
      <div class="border-b border-white/20 pb-8">
        <span class="reveal font-mono-meta text-xs uppercase text-[#FF4D00] font-bold tracking-widest block mb-2">
          // THE CHALLENGE
        </span>
        <h2 data-decode-title class="reveal font-display text-3xl sm:text-5xl text-white uppercase tracking-tight">
          {project.challengeTitle || "MANUAL OVERSIGHT HIT A BREAKING POINT"}
        </h2>
      </div>

      <!-- Challenge Narrative -->
      <div>
        <p class="font-sans text-base sm:text-lg text-white/80 leading-relaxed">
          {project.challenge}
        </p>
      </div>

      <!-- Before / After Contrast Table (Brutalist Rows) -->
      {project.contrastRows && project.contrastRows.length > 0 && (
        <div class="border-2 border-white/20 bg-white/[0.02] overflow-hidden">
          <div class="grid grid-cols-1 md:grid-cols-2 text-xs font-mono-meta uppercase font-bold tracking-wider border-b border-white/20">
            <div class="bg-white/[0.04] text-white/70 px-6 py-3 border-b md:border-b-0 md:border-r border-white/20 flex items-center gap-2">
              <span class="w-2 h-2 bg-white/40"></span>
              LEGACY PROCESS (MANUAL)
            </div>
            <div class="bg-black text-[#FF4D00] px-6 py-3 flex items-center gap-2">
              <span class="w-2 h-2 bg-[#FF4D00]"></span>
              AFTER (DEFTCODE® SYSTEM)
            </div>
          </div>

          <div class="divide-y divide-white/10" data-stagger="70">
            {project.contrastRows.map((row) => (
              <div class="reveal grid grid-cols-1 md:grid-cols-2 text-sm">
                <!-- Before Col -->
                <div class="px-6 py-4 text-white/50 bg-white/[0.02] md:border-r border-white/10 flex items-start gap-3">
                  <span class="text-white/40 font-mono-meta font-bold">✕</span>
                  <span>{row.before}</span>
                </div>
                <!-- After Col -->
                <div class="px-6 py-4 text-white/95 font-medium bg-black flex items-start gap-3">
                  <span class="text-[#FF4D00] font-mono-meta font-bold">✓</span>
                  <span>{row.after}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

    </div>
  </section>

  <!-- Technical Solution & Architectural Features -->
  <section class="relative bg-[#FF4D00] text-black py-16 md:py-20 px-4 md:px-12">
    <div class="max-w-7xl mx-auto space-y-12">
      
      <!-- Section Header -->
      <div class="border-b-2 border-black pb-8">
        <span class="reveal font-mono-meta text-xs uppercase text-black font-bold tracking-widest block mb-2">
          // TECHNICAL SOLUTION
        </span>
        <h2 data-decode-title class="reveal font-display text-3xl sm:text-5xl text-black uppercase tracking-tight">
          {project.solutionTitle || "HOW WE ENGINEERED IT"}
        </h2>
      </div>

      <div>
        <p class="font-sans text-base sm:text-lg text-black/90 font-medium leading-relaxed">
          {project.solution}
        </p>
      </div>

      <!-- 4 Solution Feature Cards -->
      {project.solutionFeatures && project.solutionFeatures.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-stagger="90">
          {project.solutionFeatures.map((feature, idx) => (
            <article class="reveal border-2 border-black p-8 bg-black text-white flex flex-col justify-between shadow-[8px_8px_0_#000000] hover:translate-x-[-2px] hover:translate-y-[-2px] transition-transform">
              <div>
                <div class="flex items-center justify-between border-b border-white/20 pb-4 mb-6">
                  <span class="font-mono-meta text-2xl font-bold text-[#FF4D00]">
                    [{String(idx + 1).padStart(2, "0")}]
                  </span>
                  <span class="w-2.5 h-2.5 bg-[#FF4D00]"></span>
                </div>
                <h3 class="font-display text-2xl text-white uppercase tracking-tight mb-3">
                  {feature.title}
                </h3>
              </div>
              <p class="font-sans text-sm sm:text-base text-white/75 leading-relaxed mt-2">
                {feature.description}
              </p>
            </article>
          ))}
        </div>
      )}

    </div>
  </section>

  <!-- Complete Multi-Screenshot Gallery -->
  {assets && assets.gallery && assets.gallery.length > 1 && (
    <section class="relative bg-black text-white py-16 md:py-20 px-4 md:px-12">
      <div class="max-w-7xl mx-auto space-y-12">
        <div class="border-b border-white/20 pb-8">
          <span class="reveal font-mono-meta text-xs uppercase text-[#FF4D00] font-bold tracking-widest block mb-2">
            // PRODUCTION GALLERY
          </span>
          <h2 data-fit-title class="reveal font-display text-3xl sm:text-5xl text-white uppercase tracking-tight">
            INTERFACES IN PRODUCTION
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8" data-stagger="90">
          {assets.gallery.map((imgItem, idx) => (
            <div class="reveal border-2 border-white/20 bg-black overflow-hidden flex flex-col group hover:border-[#FF4D00] transition-colors">
              <div class="flex justify-between items-center text-[11px] font-mono-meta text-white/70 px-4 py-2 bg-black border-b border-white/20">
                <span class="font-bold text-[#FF4D00]">VIEW [{String(idx + 1).padStart(2, "0")}]</span>
                <span>{imgItem.captionEn || "LIVE DEPLOYMENT"}</span>
              </div>
              <button
                type="button"
                data-lightbox-open={project.imageKey}
                data-lightbox-index={idx}
                aria-label="Open fullscreen screen gallery"
                class="relative block w-full text-left bg-black overflow-hidden group cursor-zoom-in"
              >
                <Image
                  src={imgItem.src}
                  alt={imgItem.altEn}
                  width={1600}
                  height={1000}
                  quality={90}
                  class="img-reveal w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <span
                  class="absolute top-3 right-3 z-10 w-8 h-8 rounded-full bg-black/70 border border-white/30 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"
                  aria-hidden="true"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path stroke-linecap="square" d="M21 21l-4.35-4.35M8 11h6M11 8v6"></path>
                  </svg>
                </span>
              </button>
              {imgItem.captionEn && (
                <div class="p-4 bg-black border-t border-white/10 text-xs font-mono-meta text-white/60">
                  {imgItem.captionEn}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Results & Key Metrics Section -->
  {project.resultsMetrics && project.resultsMetrics.length > 0 && (
    <section class="relative bg-[#FF4D00] text-black py-16 md:py-20 px-4 md:px-12">
      <div class="max-w-7xl mx-auto space-y-12">
        <div class="border-b-2 border-black pb-8">
          <span class="reveal font-mono-meta text-xs uppercase text-black font-bold tracking-widest block mb-2">
            // PROVEN RESULTS
          </span>
          <h2 data-decode-title class="reveal font-display text-3xl sm:text-5xl text-black uppercase tracking-tight">
            {project.resultsTitle || "REAL METRICS, ZERO ESTIMATES"}
          </h2>
        </div>

        <!-- 4 Metric Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" data-stagger="90">
          {project.resultsMetrics.map((metric) => (
            <div class="reveal bg-black text-white p-6 sm:p-8 border-2 border-black flex flex-col justify-between shadow-[8px_8px_0_#000000]">
              <div>
                <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 mb-3">
                  <span data-count-up class="font-display text-4xl sm:text-5xl font-bold text-[#FF4D00] tracking-tight">
                    {metric.value}
                  </span>
                  <span class="font-mono-meta text-xs uppercase text-white/60 font-bold break-words">
                    {metric.unit}
                  </span>
                </div>
              </div>
              <p class="font-sans text-xs sm:text-sm text-white/75 leading-relaxed mt-4">
                {metric.label}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Next / Previous Project Navigator Strip -->
  <section class="relative bg-black text-white py-12 px-4 md:px-12">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6 border-2 border-white/20 p-6 md:p-8">
      
      <!-- Prev -->
      <a
        href={`/en/projects/${prev.slug}/`}
        class="group flex flex-col items-start gap-1 font-mono-meta text-xs text-white/70 hover:text-[#FF4D00] transition-colors"
      >
        <span class="flex items-center gap-1 uppercase font-bold text-[#FF4D00]">
          <span class="transition-transform duration-200 group-hover:-translate-x-1">&larr;</span> PREVIOUS CASE
        </span>
        <span class="font-display text-base sm:text-lg text-white group-hover:text-[#FF4D00] uppercase tracking-tight">
          {prev.title}
        </span>
      </a>

      <!-- Center Hub -->
      <a
        href="/en/projects/"
        class="group inline-flex items-center gap-2 bg-[#FF4D00] text-black rounded-full border-2 border-black px-6 py-3 font-mono-meta text-xs uppercase font-bold hover:scale-105 transition-transform duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF4D00]"
      >
        <span>ALL CASE STUDIES</span>
        <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
      </a>

      <!-- Next -->
      <a
        href={`/en/projects/${next.slug}/`}
        class="group flex flex-col items-end gap-1 font-mono-meta text-xs text-white/70 hover:text-[#FF4D00] transition-colors text-right"
      >
        <span class="flex items-center gap-1 uppercase font-bold text-[#FF4D00]">
          NEXT CASE <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
        </span>
        <span class="font-display text-base sm:text-lg text-white group-hover:text-[#FF4D00] uppercase tracking-tight">
          {next.title}
        </span>
      </a>

    </div>
  </section>

  <CtaSection lang="en" />
  <ScreenLightbox lang="en" galleries={lightboxGalleries} />
</BaseLayout>
