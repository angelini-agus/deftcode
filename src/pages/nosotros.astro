---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import StageFan from "../components/StageFan.astro";
import ManifestoSection from "../components/ManifestoSection.astro";
import TeamSection from "../components/TeamSection.astro";
import CtaSection from "../components/CtaSection.astro";
import { pages } from "../lib/content";
---

<!-- /nosotros: banner (N), equipo (B), garantías y acompañamiento (N),
     manifiesto (B), CTA final (N), footer (B). -->
<BaseLayout
  lang="es"
  title={pages.nosotros.title}
  description={pages.nosotros.description}
>
  <PageBanner lang="es" heroLike
    title={pages.nosotros.h1}
    intro={pages.nosotros.intro}
    ctaLabel="Quiero mi diagnóstico gratis"
    ctaHref="/contacto/#formulario"
  />
  <TeamSection lang="es" />
  <StageFan lang="es" />
  <ManifestoSection lang="es" />
  <CtaSection lang="es" />
</BaseLayout>
