---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 // DEFTCODE®">
  <section class="min-h-[80vh] bg-[#FF4D00] text-black flex flex-col items-center justify-center px-4 py-24 text-center">
    <h1 data-decode-title class="reveal font-display text-[15vw] leading-[0.85] tracking-[-0.04em] text-black uppercase m-0">
      404
    </h1>

    <p class="reveal reveal-late font-mono-meta text-base sm:text-xl font-bold uppercase tracking-wider text-black max-w-xl mt-6 mb-10">
      ESTA PÁGINA NO EXISTE O CAMBIÓ DE DIRECCIÓN.
    </p>

    <a
      href="/"
      class="group inline-flex items-center gap-3 bg-black text-white font-mono-meta text-sm font-bold uppercase px-8 py-4 rounded-full border-2 border-black hover:bg-black hover:text-[#FF4D00] hover:border-black transition-all duration-200 hover:scale-105"
    >
      <span>VOLVER AL INICIO</span>
      <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </a>
  </section>
</BaseLayout>
