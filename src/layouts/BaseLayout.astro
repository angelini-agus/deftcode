---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Preloader from "../components/Preloader.astro";
import Analytics from "@vercel/analytics/astro";
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";
import "../styles/global.css";
import archivoVariableWoff2 from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url";
import archivoBlackWoff2 from "@fontsource/archivo-black/files/archivo-black-latin-400-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  lang?: Lang;
  /** Ad landing mode (/diagnostico): no menu, no footer links (§7). */
  minimal?: boolean;
}

const {
  lang = "es",
  minimal = false,
  title: titleProp,
  description: descProp,
  ogImage: ogImageProp,
  canonical: canonicalProp,
} = Astro.props;

const content = getContent(lang);
const title = titleProp ?? content.siteMeta.title;
const description = descProp ?? content.siteMeta.description;
const ogImage = ogImageProp ?? content.siteMeta.ogImage;

const siteOrigin = Astro.site ?? new URL(content.siteMeta.siteUrl);
const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = canonicalProp ?? new URL(pathname, siteOrigin).href;
const ogImageUrl = new URL(ogImage, siteOrigin).href;

// Hreflang alternates computation
let cleanPath = pathname.replace(/^\/en(\/|$)/, "/");
let esPath = cleanPath;
if (esPath.startsWith("/about/")) esPath = esPath.replace("/about/", "/nosotros/");
if (esPath.startsWith("/projects/")) esPath = esPath.replace("/projects/", "/proyectos/");
if (esPath.startsWith("/contact/")) esPath = esPath.replace("/contact/", "/contacto/");
if (esPath.startsWith("/privacy/")) esPath = esPath.replace("/privacy/", "/privacidad/");
if (esPath.startsWith("/services/")) esPath = esPath.replace("/services/", "/servicios/");

let enPath = esPath;
if (enPath.startsWith("/nosotros/")) enPath = enPath.replace("/nosotros/", "/about/");
if (enPath.startsWith("/proyectos/")) enPath = enPath.replace("/proyectos/", "/projects/");
if (enPath.startsWith("/contacto/")) enPath = enPath.replace("/contacto/", "/contact/");
if (enPath.startsWith("/privacidad/")) enPath = enPath.replace("/privacidad/", "/privacy/");
if (enPath.startsWith("/servicios/")) enPath = enPath.replace("/servicios/", "/services/");

const esUrl = new URL(esPath, siteOrigin).href;
const enUrl = new URL(`/en${enPath === "/" ? "/" : enPath}`, siteOrigin).href;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "DEFTCODE®",
  url: siteOrigin,
  description: content.siteMeta.description,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Rosario",
    addressRegion: "Santa Fe",
    addressCountry: "AR",
  },
  sameAs: [
    "https://github.com/angelini-agus",
    "https://github.com/francocus",
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth bg-[#FF4D00]" data-intro={minimal ? "off" : "auto"}>
  <head>
    <script is:inline>document.documentElement.classList.add("js");</script>
    <script is:inline>
      // Preloader gate: the intro plays on every page refresh (reload) and
      // on arrivals from outside the site, but never on internal navigation
      // (logo, menu, links) and never on back/forward. Reduced-motion users
      // never get it. Decided before first paint (no flash). When the intro
      // will actually run, .intro-run (hero targets) and .intro-nav (navbar
      // groups) apply the hidden entrance states, and an inline 4s failsafe
      // reveals everything if the "deft:intro:hero" handoff never arrives
      // — the user must never land on an invisible hero. Skip/reduced/no-JS
      // pages never get any hidden state.
      (function () {
        try {
          var root = document.documentElement;
          // Entrance choreography:
          // - Fresh external entry or reload: full preloader curtain + navbar
          //   drop + robotic hero/heading decode.
          // - Internal navigation (any visit, first or revisit): NO preloader
          //   curtain and NO navbar drop (preload-skip), but robotic hero +
          //   h1/h2/h3 decode and reveals play immediately (intro-run +
          //   motion-fresh).
          // - Back/forward and reduced motion: fully static (preload-skip +
          //   motion-static).
          var entry = performance.getEntriesByType("navigation")[0];
          var type = entry ? entry.type : "navigate";
          var internal =
            document.referrer.indexOf(location.origin + "/") === 0 ||
            document.referrer === location.origin;
          if (
            window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
            type === "back_forward"
          ) {
            root.classList.add("preload-skip", "motion-static");
            return;
          }
          if (root.getAttribute("data-intro") === "off") {
            // Minimal pages have no preloader/handoff: fresh motion, but
            // the title observer starts immediately (no intro-run).
            root.classList.add("preload-skip", "motion-fresh");
            return;
          }
          if (type === "navigate" && internal) {
            // Internal navigation: skip the preloader curtain & navbar drop,
            // run the robotic hero/title animations immediately on fonts.ready.
            root.classList.add("preload-skip", "intro-run", "motion-fresh");
          } else {
            root.classList.add("intro-run", "intro-nav", "motion-fresh");
          }
          window.setTimeout(function () {
            // The navbar entrance should be long done by now; the hero
            // entrance owns .intro-run once started (dataset.introStarted).
            root.classList.remove("intro-nav");
            if (root.dataset.introStarted !== "1") {
              root.classList.remove("intro-run");
            }
          }, 4000);
        } catch {
          /* storage blocked: let it play */
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Font preloads: logo + hero display fonts gate first paint (latin subset covers Spanish) -->
    <link rel="preload" as="font" type="font/woff2" href={archivoVariableWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={archivoBlackWoff2} crossorigin />

    <link rel="canonical" href={canonical} />

    <!-- Hreflang Alternates (Google Multi-language SEO) -->
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_AR"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />

    <!-- Analytics -->
    <Analytics />
  </head>
  <body class="bg-[#FF4D00] text-black min-h-screen flex flex-col font-sans selection:bg-black selection:text-[#FF4D00]">
    {!minimal && <Navbar lang={lang} />}
    {!minimal && <Preloader lang={lang} />}
    <main class="flex-grow">
      <slot />
    </main>
    {!minimal && <Footer lang={lang} />}

    <script>
      // Motion system (Misure rules, site-wide):
      // 1. EVERY h1/h2/h3 gets the hero's robotic per-letter decode:
      //    letters appear small, flicker through the glitch set while
      //    growing, and land on the final glyph with a back-out punch —
      //    the exact feel of the hero intro after the preload. Letter
      //    boxes are permanent with widths in em measured on the FINAL
      //    glyph (centered), so titles never re-compact. Modes:
      //    - [data-fit-title]: canvas measureText with the REAL font
      //      fits the title to one line (single-phrase display titles).
      //    - all other headings: keep the CSS font size and wrapping;
      //      spaces stay plain text nodes so lines still break.
      //    - headings whose content is a set of span lines (the CTA
      //      heading) decode per line, keeping their sizes.
      //    - headings with other nested elements (links, <br>) stay
      //      static; [data-hero-scramble] belongs to the hero intro and
      //      [data-decode-skip] opts a heading out.
      // 2. Everything else with .reveal: slides in from its side
      //    (left / right by position, center-biased elements from below).
      // Both run after document.fonts.ready so metrics use the real
      // face, re-run debounced on resize.
      (function () {
        type LetterSpan = { node: HTMLElement; final: string };
        type DecodeSpan = {
          node: HTMLElement;
          final: string;
          at: number;
          endAt: number;
          revealed: boolean;
          settled: boolean;
        };
        type ActiveDecode = {
          el: HTMLElement;
          t0: number;
          lastCycleAt: number;
          items: DecodeSpan[];
          remaining: number;
        };
        type PendingVisible = { el: HTMLElement; fire: (el: HTMLElement) => void };
        var GLYPHS = "X0O#";
        var FLICKER_MS = 110;
        var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var hasIO = "IntersectionObserver" in window;
        var canvas = document.createElement("canvas");
        var ctx: CanvasRenderingContext2D | null = canvas.getContext("2d");
        // Session replays / internal navigation / reduced motion: the
        // page renders fully static (no decode, no reveals, no count-up).
        var root = document.documentElement;
        var staticMode =
          reduced || !hasIO || root.classList.contains("motion-static");

        // --- 1. Collect every heading, tagging decode behavior ---
        var titles = Array.prototype.slice
          .call(document.querySelectorAll<HTMLElement>("h1, h2, h3"))
          .filter(function (h) {
            if (h.hasAttribute("data-hero-scramble")) return false;
            if (h.hasAttribute("data-decode-skip")) return false;
            if (h.hasAttribute("data-fit-title")) return true;
            var kids = Array.prototype.slice.call(h.children);
            if (kids.length === 0) return true;
            // Span-only children = authored line groups (CTA heading):
            // decode per line, keeping each line's own size.
            var allSpans = kids.every(function (k) {
              return k.tagName === "SPAN";
            });
            if (allSpans) {
              h.setAttribute("data-decode-lines", "");
              return true;
            }
            return false;
          });
        var titleTexts = new Map<HTMLElement, string>();
        var titleLineTexts = new Map<HTMLElement, string[]>();
        titles.forEach(function (h) {
          if (!h.hasAttribute("data-fit-title")) h.setAttribute("data-decode-title", "");
          var normalized = (h.textContent || "").replace(/\s+/g, " ").trim();
          titleTexts.set(h, normalized);
          if (h.hasAttribute("data-decode-lines")) {
            var lineStrings = Array.prototype.slice
              .call(h.children)
              .map(function (line: Element) {
                return (line.textContent || "").replace(/\s+/g, " ").trim();
              });
            titleLineTexts.set(h, lineStrings);
          }
        });
        if (root.classList.contains("motion-fresh")) {
          // Headings the system will NOT decode must not stay hidden
          // under the first-paint blanket.
          Array.prototype.slice
            .call(document.querySelectorAll("h1, h2, h3"))
            .forEach(function (h) {
              if (h.hasAttribute("data-hero-scramble")) return;
              if (titles.indexOf(h) === -1) h.style.opacity = "1";
            });
        }

        // --- 2. Directional reveals (non-title elements) ---
        var revealables = Array.prototype.slice
          .call(document.querySelectorAll(".reveal, .img-reveal"))
          .filter(function (el) {
            return !el.hasAttribute("data-fit-title") && !el.hasAttribute("data-decode-title");
          });
        var revealObserverStarted = false;
        function startRevealObserver() {
          if (revealObserverStarted || staticMode) return;
          revealObserverStarted = true;
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                io.unobserve(entry.target);
                // Deck folders / hidden fan panels: reveal only when the
                // element is actually visible (ancestor opacity >= 0.5).
                whenActuallyVisible(entry.target as HTMLElement, function (el) {
                  el.classList.add("is-revealed");
                });
              });
            },
            { threshold: 0.2, rootMargin: "0px 0px -10% 0px" },
          );
          revealables.forEach(function (el) {
            io.observe(el);
          });
        }

        if (staticMode) {
          root.classList.add("motion-static");
          revealables.forEach(function (el) {
            el.classList.add("is-revealed");
          });
        } else {
          // Staggered groups (cards, numbered rows): every reveal child
          // gets an incremental transition-delay instead of its own IO
          // timing, and keeps the plain rise (no directional slide).
          Array.prototype.slice.call(document.querySelectorAll("[data-stagger]")).forEach(function (group) {
            var step = parseInt(group.getAttribute("data-stagger"), 10) || 70;
            Array.prototype.slice.call(group.children).forEach(function (k, i) {
              if (k.classList.contains("reveal") || k.classList.contains("img-reveal")) {
                k.style.transitionDelay = i * step + "ms";
              }
            });
          });
          // Batched READ -> WRITE for directional reveal classes.
          var vw = window.innerWidth;
          var leftBound = vw * 0.35;
          var rightBound = vw * 0.65;
          var directional: { el: Element; mid: number }[] = [];
          revealables.forEach(function (el) {
            if (el.classList.contains("img-reveal") || el.closest("[data-stagger]")) return;
            var r = el.getBoundingClientRect();
            directional.push({ el: el, mid: r.left + r.width / 2 });
          });
          directional.forEach(function (item) {
            if (item.mid < leftBound) item.el.classList.add("reveal-left");
            else if (item.mid > rightBound) item.el.classList.add("reveal-right");
          });
        }

        // --- 3. Letter building (hero recipe) ---
        // Build letter spans inside a DocumentFragment for one phrase.
        // Words are wrapped in nowrap spans (when wrapping is possible)
        // and spaces stay plain text nodes, so lines only break at spaces.
        function buildPhrase(
          frag: DocumentFragment,
          text: string,
          canWrap: boolean,
          spans: LetterSpan[],
          wordWraps: HTMLElement[],
        ) {
          var words = text.split(" ");
          for (var wi = 0; wi < words.length; wi++) {
            if (wi > 0) {
              if (canWrap) {
                frag.appendChild(document.createTextNode(" "));
              } else {
                var spSp = document.createElement("span");
                spSp.textContent = " ";
                spSp.style.display = "inline-block";
                spSp.style.whiteSpace = "pre";
                frag.appendChild(spSp);
                spans.push({ node: spSp, final: " " });
              }
            }
            var word = words[wi];
            var wrapEl: HTMLElement | null = null;
            if (canWrap && word.length > 0) {
              wrapEl = document.createElement("span");
              wrapEl.style.whiteSpace = "nowrap";
              frag.appendChild(wrapEl);
              wordWraps.push(wrapEl);
            }
            for (var i = 0; i < word.length; i++) {
              var s = document.createElement("span");
              s.textContent = word.charAt(i);
              s.style.display = "inline-block";
              s.style.whiteSpace = "pre";
              (wrapEl || frag).appendChild(s);
              spans.push({ node: s, final: word.charAt(i) });
            }
          }
        }

        // --- 4. Fit single-line display titles & lazy heading prep ---
        // Fit [data-fit-title] headings using batched clientWidth reads
        // before fontSize writes. Also restores settled text on resize so
        // previously decoded headings reflow cleanly at the new width.
        function fitTitles(isResize: boolean) {
          var fitTargets: { el: HTMLElement; text: string; width: number }[] = [];
          // Pass 1 (READ): measure parent clientWidth for every fit title.
          titles.forEach(function (h) {
            if (!h.hasAttribute("data-fit-title")) return;
            var text = titleTexts.get(h) || "";
            if (!text || !h.parentElement) return;
            fitTargets.push({ el: h, text: text, width: h.parentElement.clientWidth - 4 });
          });

          // Pass 2 (WRITE): apply computed one-line fontSize.
          if (ctx && fitTargets.length > 0) {
            ctx.font = '400 100px "Archivo Black", sans-serif';
            try {
              ctx.letterSpacing = "-4px";
            } catch (e) {}
            fitTargets.forEach(function (item) {
              if (item.width <= 0) return;
              var w100 = ctx!.measureText(item.text).width;
              if (w100 <= 0) return;
              var fs = item.width / (w100 / 100);
              item.el.style.fontSize = fs + "px";
              // One line guaranteed: inline-block letters create break
              // opportunities at every box, not only at spaces.
              item.el.style.whiteSpace = "nowrap";
            });
          }

          if (staticMode) {
            titles.forEach(function (h) {
              h.classList.add("is-revealed");
              if (root.classList.contains("motion-fresh")) h.style.opacity = "1";
            });
            return;
          }

          if (isResize) {
            // Only restore plain text on already-settled headings; offscreen
            // headings have not been split yet and mid-decode headings keep
            // their em-scaled spans.
            titles.forEach(function (h) {
              if (h.dataset.settled !== "1") return;
              if (h.hasAttribute("data-decode-lines")) {
                var savedLines = titleLineTexts.get(h);
                if (!savedLines) return;
                Array.prototype.slice.call(h.children).forEach(function (line: Element, idx: number) {
                  if (idx < savedLines!.length) line.textContent = savedLines![idx];
                });
              } else {
                var text = titleTexts.get(h);
                if (text !== undefined) h.textContent = text;
              }
            });
          }
        }

        // Lazily split, measure, and arm a single heading right when it is
        // about to decode. Keeps offscreen headings untouched plain text.
        function prepTitle(h: HTMLElement): LetterSpan[] | null {
          var text = titleTexts.get(h) || "";
          if (!text) {
            h.classList.add("is-revealed");
            if (root.classList.contains("motion-fresh")) h.style.opacity = "1";
            return null;
          }

          var spans: LetterSpan[] = [];
          var wordWraps: HTMLElement[] = [];
          var groups: { container: HTMLElement; spans: LetterSpan[] }[] = [];

          if (h.hasAttribute("data-decode-lines")) {
            // Keep each authored line span (it carries its own font size)
            // and build its letters off-DOM with DocumentFragment.
            var lineEls = Array.prototype.slice.call(h.children) as HTMLElement[];
            var savedLines = titleLineTexts.get(h) || [];
            lineEls.forEach(function (line, idx) {
              var lineText =
                savedLines[idx] !== undefined
                  ? savedLines[idx]
                  : (line.textContent || "").replace(/\s+/g, " ").trim();
              var lineSpans: LetterSpan[] = [];
              var lineFrag = document.createDocumentFragment();
              if (lineText) buildPhrase(lineFrag, lineText, false, lineSpans, wordWraps);
              line.textContent = "";
              line.appendChild(lineFrag);
              groups.push({ container: line, spans: lineSpans });
              for (var i = 0; i < lineSpans.length; i++) spans.push(lineSpans[i]);
            });
          } else {
            var frag = document.createDocumentFragment();
            buildPhrase(frag, text, !h.hasAttribute("data-fit-title"), spans, wordWraps);
            h.textContent = "";
            h.appendChild(frag);
            groups.push({ container: h, spans: spans });
          }

          // Batched READ -> WRITE word-overflow guard: a single long word
          // (e.g. AUTOMATIZACION on a 360px phone) must not push the page
          // sideways. Carousel slides sit offscreen by design and skip it.
          if (
            wordWraps.length > 0 &&
            !h.closest("[data-fan-track],[data-flip-runway],.marquee-container")
          ) {
            var vw = window.innerWidth;
            var avail = h.getBoundingClientRect().width;
            var overflowing: HTMLElement[] = [];
            for (var wi = 0; wi < wordWraps.length; wi++) {
              var wEl = wordWraps[wi];
              var r = wEl.getBoundingClientRect();
              if ((avail > 0 && r.width > avail + 1) || r.right > vw - 1) {
                overflowing.push(wEl);
              }
            }
            for (var oi = 0; oi < overflowing.length; oi++) {
              overflowing[oi].style.whiteSpace = "normal";
              overflowing[oi].style.overflowWrap = "anywhere";
            }
          }

          // Batched READ -> WRITE for natural glyph widths: read fontSize
          // once per heading/line and all span widths before mutating styles.
          var groupFs: number[] = [];
          var spanWidths: number[] = new Array(spans.length);
          var spanGroupIdx: number[] = new Array(spans.length);
          var cursor = 0;
          for (var gi = 0; gi < groups.length; gi++) {
            var grp = groups[gi];
            groupFs.push(parseFloat(getComputedStyle(grp.container).fontSize) || 16);
            for (var si = 0; si < grp.spans.length; si++) {
              spanWidths[cursor] = grp.spans[si].node.getBoundingClientRect().width;
              spanGroupIdx[cursor] = gi;
              cursor++;
            }
          }

          for (var k = 0; k < spans.length; k++) {
            var sp = spans[k];
            var ownFs = groupFs[spanGroupIdx[k]];
            sp.node.style.width = spanWidths[k] / ownFs + "em";
            sp.node.style.textAlign = "center";
            if (sp.final !== " ") {
              sp.node.style.opacity = "0";
              sp.node.style.transform = "scale(0.25)";
            }
          }

          // Release the heading container instantaneously (without triggering
          // .reveal's 400ms container transition) so only the letters animate.
          h.style.transition = "none";
          h.classList.add("is-revealed");
          if (root.classList.contains("motion-fresh")) h.style.opacity = "1";

          // Single reflow to commit initial opacity(0)/scale(0.25) and
          // instant container visibility before enabling letter transitions.
          void h.offsetWidth;
          h.style.transition = "";

          for (var t = 0; t < spans.length; t++) {
            if (spans[t].final !== " ") {
              // Back-out on the transform = the hero's robotic punch
              // (scale overshoots 1 and settles); opacity stays smooth.
              spans[t].node.style.transition =
                "opacity .28s cubic-bezier(.23,1,.32,1), transform .28s cubic-bezier(.34,1.56,.64,1)";
            }
          }

          return spans;
        }

        // --- 5. Decode (hero pacing): single shared rAF loop across active
        // headings; letters grow while the glyph flickers and land 110ms in. ---
        var activeDecodes: ActiveDecode[] = [];
        var decodeRaf = 0;

        function tickDecodes(now: number) {
          for (var di = activeDecodes.length - 1; di >= 0; di--) {
            var job = activeDecodes[di];
            var elapsed = now - job.t0;
            var shouldCycle = now - job.lastCycleAt >= 42;
            if (shouldCycle) job.lastCycleAt = now;

            for (var i = 0; i < job.items.length; i++) {
              var item = job.items[i];
              if (item.settled) continue;
              if (!item.revealed && elapsed >= item.at) {
                item.revealed = true;
                item.node.style.opacity = "1";
                item.node.style.transform = "scale(1)";
                if (elapsed < item.endAt) {
                  item.node.textContent = GLYPHS[(Math.random() * GLYPHS.length) | 0];
                }
              }
              if (elapsed >= item.endAt) {
                item.settled = true;
                item.node.dataset.settled = "1";
                item.node.textContent = item.final;
                job.remaining--;
              } else if (item.revealed && shouldCycle) {
                item.node.textContent = GLYPHS[(Math.random() * GLYPHS.length) | 0];
              }
            }

            if (job.remaining <= 0) {
              job.el.dataset.settled = "1";
              activeDecodes.splice(di, 1);
            }
          }

          if (activeDecodes.length > 0) {
            decodeRaf = requestAnimationFrame(tickDecodes);
          } else {
            decodeRaf = 0;
          }
        }

        function decode(el: HTMLElement, spans: LetterSpan[] | null) {
          if (!spans || spans.length === 0) {
            el.dataset.settled = "1";
            return;
          }
          var each = Math.min(0.022, 0.3 / spans.length);
          var items: DecodeSpan[] = [];
          for (var i = 0; i < spans.length; i++) {
            var sp = spans[i];
            if (sp.final === " ") {
              sp.node.dataset.settled = "1";
              continue;
            }
            var at = Math.round(i * each * 1000);
            items.push({
              node: sp.node,
              final: sp.final,
              at: at,
              endAt: at + FLICKER_MS,
              revealed: false,
              settled: false,
            });
          }
          if (items.length === 0) {
            el.dataset.settled = "1";
            return;
          }
          activeDecodes.push({
            el: el,
            t0: performance.now(),
            lastCycleAt: 0,
            items: items,
            remaining: items.length,
          });
          if (!decodeRaf) {
            decodeRaf = requestAnimationFrame(tickDecodes);
          }
        }

        // Effective opacity through ancestors (the project deck fades its
        // folders per scroll segment and the process fan hides inactive
        // panels): a heading only decodes once it is actually seen.
        function effectiveVisibility(el: HTMLElement): number {
          // Walk ANCESTORS only: the element's own opacity is the
          // reveal's hidden state (0 by design) and must not veto itself.
          var o = 1;
          var n: HTMLElement | null = el.parentElement;
          while (n && n !== document.documentElement) {
            var cs = getComputedStyle(n);
            if (cs.display === "none" || cs.visibility === "hidden") return 0;
            o *= parseFloat(cs.opacity) || 0;
            if (o === 0) return 0;
            n = n.parentElement;
          }
          return o;
        }

        // Start observing titles only once the preloader hands off: a
        // decode behind the preloader overlay would be wasted (the user
        // would never see it). Same signals as the intro system:
        // data-intro="off" pages, preload-skip (reduced / back-forward /
        // internal navigation) start immediately; otherwise the handoff
        // event or the 4s failsafe begins the observer.
        var titleObserverStarted = false;
        function startTitleObserver() {
          if (titleObserverStarted || staticMode) return;
          titleObserverStarted = true;
          var titleIO = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                titleIO.unobserve(entry.target);
                var h = entry.target as HTMLElement;
                if (h.dataset.decoded) return;
                h.dataset.decoded = "1";
                whenActuallyVisible(h, function (el) {
                  var spans = prepTitle(el);
                  decode(el, spans);
                });
              });
            },
            { threshold: 0.2 },
          );
          titles.forEach(function (h) {
            titleIO.observe(h);
          });
        }

        // Shared visibility watcher: runs `fire` once an element is really
        // visible (geometric intersect + effective ancestor opacity >= 0.5).
        // Consolidates all waiting elements into a single 120ms interval
        // that pauses while hidden and clears itself once the queue empties.
        var pendingVisible: PendingVisible[] = [];
        var visibilityTimer: ReturnType<typeof setInterval> | null = null;

        function pollVisibleQueue() {
          if (document.hidden) return;
          for (var i = pendingVisible.length - 1; i >= 0; i--) {
            var entry = pendingVisible[i];
            if (!entry.el.isConnected) {
              pendingVisible.splice(i, 1);
              continue;
            }
            if (effectiveVisibility(entry.el) >= 0.5) {
              pendingVisible.splice(i, 1);
              entry.fire(entry.el);
            }
          }
          if (pendingVisible.length === 0 && visibilityTimer !== null) {
            clearInterval(visibilityTimer);
            visibilityTimer = null;
          }
        }

        function whenActuallyVisible(el: HTMLElement, fire: (el: HTMLElement) => void) {
          if (effectiveVisibility(el) >= 0.5) {
            fire(el);
            return;
          }
          pendingVisible.push({ el: el, fire: fire });
          if (visibilityTimer === null) {
            visibilityTimer = setInterval(pollVisibleQueue, 120);
          }
        }

        // --- Count-up (the standout numbers): numeric tokens inside
        // [data-count-up] rise from 0 to their value once, when seen.
        // Plain text under reduced motion; hidden containers wait via
        // the shared gate. ---
        function animateCountUp(el: HTMLElement) {
          if (el.dataset.counted) return;
          el.dataset.counted = "1";
          var parts = el.textContent.split(/(-?\d+(?:[.,]\d+)?)/);
          if (parts.length === 1) return;
          el.textContent = "";
          var nums: { node: HTMLElement; raw: string; target: number }[] = [];
          parts.forEach(function (t: string) {
            if (/^-?\d/.test(t)) {
              var s = document.createElement("span");
              s.textContent = t;
              el.appendChild(s);
              nums.push({ node: s, raw: t, target: parseFloat(t.replace(",", ".")) });
            } else if (t) {
              el.appendChild(document.createTextNode(t));
            }
          });
          var t0 = performance.now();
          var dur = 1100;
          var frame = function (now: number) {
            var k = Math.min(1, (now - t0) / dur);
            var eased = 1 - Math.pow(1 - k, 3);
            nums.forEach(function (n) {
              var decimals = (n.raw.split(/[.,]/)[1] || "").length;
              n.node.textContent = (n.target * eased).toFixed(decimals);
            });
            if (k < 1) requestAnimationFrame(frame);
            else nums.forEach(function (n) {
              n.node.textContent = n.raw;
            });
          };
          requestAnimationFrame(frame);
        }

        if (!staticMode) {
          var countIO = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                countIO.unobserve(entry.target);
                whenActuallyVisible(entry.target as HTMLElement, animateCountUp);
              });
            },
            { threshold: 0.4 },
          );
          Array.prototype.slice
            .call(document.querySelectorAll("[data-count-up]"))
            .forEach(function (el) {
              countIO.observe(el);
            });
        }

        function startObservers() {
          startRevealObserver();
          startTitleObserver();
        }

        function boot() {
          fitTitles(false);
          if (staticMode) return;
          var root = document.documentElement;
          var introDone =
            root.getAttribute("data-intro") === "off" ||
            root.classList.contains("motion-static") ||
            root.dataset.introHandoff === "1" ||
            !root.classList.contains("intro-run");
          if (introDone) {
            startObservers();
            return;
          }
          window.addEventListener("deft:intro:hero", startObservers, { once: true });
          setTimeout(startObservers, 4600);
        }

        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(function () {
            boot();
          });
        } else {
          boot();
        }
        var fitT: ReturnType<typeof setTimeout> | undefined;
        window.addEventListener("resize", function () {
          clearTimeout(fitT);
          fitT = setTimeout(function () {
            fitTitles(true);
          }, 120);
        });
      })();
    </script>
  </body>
</html>
