---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Preloader from "../components/Preloader.astro";
import Analytics from "@vercel/analytics/astro";
import { getContent } from "../lib/content";
import type { Lang } from "../lib/types";
import "../styles/global.css";
import archivoVariableWoff2 from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url";
import archivoBlackWoff2 from "@fontsource/archivo-black/files/archivo-black-latin-400-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  lang?: Lang;
  /** Ad landing mode (/diagnostico): no menu, no footer links (§7). */
  minimal?: boolean;
}

const {
  lang = "es",
  minimal = false,
  title: titleProp,
  description: descProp,
  ogImage: ogImageProp,
  canonical: canonicalProp,
} = Astro.props;

const content = getContent(lang);
const title = titleProp ?? content.siteMeta.title;
const description = descProp ?? content.siteMeta.description;
const ogImage = ogImageProp ?? content.siteMeta.ogImage;

const siteOrigin = Astro.site ?? new URL(content.siteMeta.siteUrl);
const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = canonicalProp ?? new URL(pathname, siteOrigin).href;
const ogImageUrl = new URL(ogImage, siteOrigin).href;

// Hreflang alternates computation
let cleanPath = pathname.replace(/^\/en(\/|$)/, "/");
let esPath = cleanPath;
if (esPath.startsWith("/about/")) esPath = esPath.replace("/about/", "/nosotros/");
if (esPath.startsWith("/projects/")) esPath = esPath.replace("/projects/", "/proyectos/");
if (esPath.startsWith("/contact/")) esPath = esPath.replace("/contact/", "/contacto/");
if (esPath.startsWith("/privacy/")) esPath = esPath.replace("/privacy/", "/privacidad/");
if (esPath.startsWith("/services/")) esPath = esPath.replace("/services/", "/servicios/");

let enPath = esPath;
if (enPath.startsWith("/nosotros/")) enPath = enPath.replace("/nosotros/", "/about/");
if (enPath.startsWith("/proyectos/")) enPath = enPath.replace("/proyectos/", "/projects/");
if (enPath.startsWith("/contacto/")) enPath = enPath.replace("/contacto/", "/contact/");
if (enPath.startsWith("/privacidad/")) enPath = enPath.replace("/privacidad/", "/privacy/");
if (enPath.startsWith("/servicios/")) enPath = enPath.replace("/servicios/", "/services/");

const esUrl = new URL(esPath, siteOrigin).href;
const enUrl = new URL(`/en${enPath === "/" ? "/" : enPath}`, siteOrigin).href;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Deftcode",
  url: siteOrigin,
  description: content.siteMeta.description,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Rosario",
    addressRegion: "Santa Fe",
    addressCountry: "AR",
  },
  sameAs: [
    "https://github.com/angelini-agus",
    "https://github.com/francocus",
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth bg-[#FF4D00]" data-intro={minimal ? "off" : "auto"}>
  <head>
    <script is:inline>document.documentElement.classList.add("js");</script>
    <script is:inline>
      // Preloader gate: the intro plays on every page refresh (reload) and
      // on arrivals from outside the site, but never on internal navigation
      // (logo, menu, links) and never on back/forward. Reduced-motion users
      // never get it. Decided before first paint (no flash). When the intro
      // will actually run, .intro-run (hero targets) and .intro-nav (navbar
      // groups) apply the hidden entrance states, and an inline 4s failsafe
      // reveals everything if the "deft:intro:hero" handoff never arrives
      // — the user must never land on an invisible hero. Skip/reduced/no-JS
      // pages never get any hidden state.
      (function () {
        try {
          var root = document.documentElement;
          if (root.getAttribute("data-intro") === "off") return; // /diagnostico: no intro
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            root.classList.add("preload-skip");
            return;
          }
          var entry = performance.getEntriesByType("navigation")[0];
          var type = entry ? entry.type : "navigate";
          var internal =
            document.referrer.indexOf(location.origin + "/") === 0 ||
            document.referrer === location.origin;
          if (type === "back_forward" || (type === "navigate" && internal)) {
            root.classList.add("preload-skip");
            return;
          }
          root.classList.add("intro-run", "intro-nav");
          window.setTimeout(function () {
            // The navbar entrance should be long done by now; the hero
            // entrance owns .intro-run once started (dataset.introStarted).
            root.classList.remove("intro-nav");
            if (root.dataset.introStarted !== "1") {
              root.classList.remove("intro-run");
            }
          }, 4000);
        } catch {
          /* storage blocked: let it play */
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Font preloads: logo + hero display fonts gate first paint (latin subset covers Spanish) -->
    <link rel="preload" as="font" type="font/woff2" href={archivoVariableWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={archivoBlackWoff2} crossorigin />

    <link rel="canonical" href={canonical} />

    <!-- Hreflang Alternates (Google Multi-language SEO) -->
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_AR"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />

    <!-- Analytics -->
    <Analytics />
  </head>
  <body class="bg-[#FF4D00] text-black min-h-screen flex flex-col font-sans selection:bg-black selection:text-[#FF4D00]">
    {!minimal && <Navbar lang={lang} />}
    {!minimal && <Preloader lang={lang} />}
    <main class="flex-grow">
      <slot />
    </main>
    {!minimal && <Footer lang={lang} />}

    <script>
      // Motion system (Misure rules, site-wide):
      // 1. Display titles: robotic per-letter decode in place (fade in the
      //    same spot, no slide), letters grow from a glitch set exactly
      //    like the hero intro. Letter boxes are permanent with widths in
      //    em, so titles never re-compact. Two modes:
      //    - [data-fit-title]: canvas measureText with the REAL font fits
      //      the title to one line (shaping exact, immune to line wrapping
      //      — a Range rect only reports the widest wrapped line and
      //      diverges). Single-phrase titles.
      //    - [data-decode-title]: keeps the CSS font size and wrapping;
      //      spaces stay plain text nodes so lines still break. Titles
      //      that wrap (case/service/landing h1s) or have bespoke sizing.
      // 2. Everything else with .reveal: slides in from its side (left /
      //    right by position, center-biased elements from below).
      // Both runs after document.fonts.ready so metrics use the real
      // face, re-run debounced on resize.
      (function () {
        type LetterSpan = { node: HTMLElement; final: string };
        type Prepared = { el: HTMLElement; spans: LetterSpan[] | null; text: string };
        var GLYPHS = "X0O#";
        var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var hasIO = "IntersectionObserver" in window;
        var canvas = document.createElement("canvas");
        var ctx: CanvasRenderingContext2D | null = canvas.getContext("2d");
        var titles = Array.prototype.slice.call(
          document.querySelectorAll<HTMLElement>("[data-fit-title], [data-decode-title]"),
        );
        var prepared: Prepared[] = [];

        // --- 1. Directional reveals (non-title elements) ---
        var revealables = Array.prototype.slice
          .call(document.querySelectorAll(".reveal"))
          .filter(function (el) {
            return !el.hasAttribute("data-fit-title") && !el.hasAttribute("data-decode-title");
          });
        if (!hasIO || reduced) {
          revealables.forEach(function (el) {
            el.classList.add("is-revealed");
          });
        } else {
          revealables.forEach(function (el) {
            var r = el.getBoundingClientRect();
            var mid = r.left + r.width / 2;
            if (mid < window.innerWidth * 0.35) el.classList.add("reveal-left");
            else if (mid > window.innerWidth * 0.65) el.classList.add("reveal-right");
          });
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-revealed");
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.2, rootMargin: "0px 0px -10% 0px" },
          );
          revealables.forEach(function (el) {
            io.observe(el);
          });
        }

        // --- 2. Prep + fit + robotic decode ---
        function prepAndFit() {
          prepared.length = 0;
          titles.forEach(function (h2) {
            var text = (h2.textContent || "").replace(/\s+/g, " ").trim();
            if (!text) return;
            // Fit titles: scale so the whole text fills one line. Decode
            // titles keep their CSS font size (wrapping is part of the
            // approved layout). The heading box is revealed at prep (its
            // letters are still hidden) so the decode never fights the
            // .reveal fade.
            if (h2.hasAttribute("data-fit-title")) {
              if (!ctx) return;
              var target = h2.parentElement.clientWidth - 4;
              if (target <= 0) return;
              ctx.font = '400 100px "Archivo Black", sans-serif';
              try {
                ctx.letterSpacing = "-4px";
              } catch (e) {}
              var w100 = ctx.measureText(text).width;
              var fs = target / (w100 / 100);
              h2.style.fontSize = fs + "px";
              // One line guaranteed: inline-block letters create break
              // opportunities at every box, not only at spaces.
              h2.style.whiteSpace = "nowrap";
            }
            h2.classList.add("is-revealed");
            if (!hasIO || reduced) {
              h2.textContent = text;
              prepared.push({ el: h2, spans: null, text: text });
              return;
            }
            // Already decoded (resize re-prep): settle back to plain text
            // instead of re-arming a decode that would never fire again.
            if (h2.dataset.decoded) {
              h2.textContent = text;
              prepared.push({ el: h2, spans: null, text: text });
              return;
            }
            h2.textContent = "";
            var spans: LetterSpan[] = [];
            // Decode titles wrap: letters are inline-blocks, which create
            // break opportunities at EVERY box — so each word goes inside
            // a nowrap wrapper and only the plain space text nodes between
            // words allow a line break.
            var words = text.split(" ");
            for (var wi = 0; wi < words.length; wi++) {
              if (wi > 0) {
                if (h2.hasAttribute("data-decode-title")) {
                  h2.appendChild(document.createTextNode(" "));
                } else {
                  var spSp = document.createElement("span");
                  spSp.textContent = " ";
                  spSp.style.display = "inline-block";
                  spSp.style.whiteSpace = "pre";
                  h2.appendChild(spSp);
                  spans.push({ node: spSp, final: " " });
                }
              }
              var word = words[wi];
              var wrapEl: HTMLElement | null = null;
              if (h2.hasAttribute("data-decode-title") && word.length > 0) {
                wrapEl = document.createElement("span");
                wrapEl.style.whiteSpace = "nowrap";
                h2.appendChild(wrapEl);
              }
              for (var i = 0; i < word.length; i++) {
                var ch = word.charAt(i);
                var s = document.createElement("span");
                s.textContent = ch;
                s.style.display = "inline-block";
                s.style.whiteSpace = "pre";
                (wrapEl || h2).appendChild(s);
                spans.push({ node: s, final: ch });
              }
            }
            // Measure the NATURAL glyph boxes: getBoundingClientRect
            // returns the transformed box, so widths must be read before
            // the scale(0.25) glitch state is applied.
            var fsReal = parseFloat(getComputedStyle(h2).fontSize) || 16;
            spans.forEach(function (sp) {
              var w = sp.node.getBoundingClientRect().width;
              sp.node.style.width = w / fsReal + "em";
            });
            // Arm the glitch state instantly (no transition yet), force a
            // reflow, then enable transitions so the decode animates.
            spans.forEach(function (sp) {
              if (sp.final !== " ") {
                sp.node.style.opacity = "0";
                sp.node.style.transform = "scale(0.25)";
              }
            });
            void h2.offsetWidth;
            spans.forEach(function (sp) {
              if (sp.final !== " ") {
                sp.node.style.transition =
                  "opacity .26s cubic-bezier(.23,1,.32,1), transform .26s cubic-bezier(.23,1,.32,1)";
              }
            });
            prepared.push({ el: h2, spans: spans, text: text });
          });
        }

        function decode(p: Prepared) {
          const spans = p.spans;
          if (!spans) return;
          var cycle = setInterval(function () {
            spans.forEach(function (sp) {
              if (sp.node.dataset.settled) return;
              sp.node.textContent = GLYPHS[(Math.random() * GLYPHS.length) | 0];
            });
          }, 42);
          var each = Math.min(0.018, 0.5 / spans.length);
          var last = 0;
          spans.forEach(function (sp, i) {
            if (sp.final === " ") {
              sp.node.dataset.settled = "1";
              return;
            }
            var at = Math.round(i * each * 1000);
            last = at;
            setTimeout(function () {
              sp.node.dataset.settled = "1";
              sp.node.textContent = sp.final;
              sp.node.style.opacity = "1";
              sp.node.style.transform = "scale(1)";
            }, at);
          });
          setTimeout(function () {
            clearInterval(cycle);
          }, last + 700);
        }

        function boot() {
          prepAndFit();
          if (!hasIO || reduced) return;
          var titleIO = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                titleIO.unobserve(entry.target);
                var p = prepared.find(function (x) {
                  return x.el === entry.target;
                });
                if (p && p.spans && !p.el.dataset.decoded) {
                  p.el.dataset.decoded = "1";
                  decode(p);
                }
              });
            },
            { threshold: 0.2 },
          );
          prepared.forEach(function (p) {
            titleIO.observe(p.el);
          });
        }

        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(function () {
            boot();
          });
        } else {
          boot();
        }
        var fitT: ReturnType<typeof setTimeout> | undefined;
        window.addEventListener("resize", function () {
          clearTimeout(fitT);
          fitT = setTimeout(prepAndFit, 120);
        });
      })();
    </script>
  </body>
</html>
